---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ShareRow from "../components/ShareRow.astro";
import { checkMeta } from "../lib/verification";

interface Props {
  title: string;
  description: string;
  /** Defaults to indexable. Verified-gated pages pass their own value. */
  robots?: string;
  /** ISO date. Should match the page's verification date. */
  dateModified?: string | null;
  /** JSON-LD blocks. Article on everything; FAQPage/Place/Table where they apply. */
  schema?: Record<string, unknown>[];
  /** Share row before the footer. Off on the home page, where there's no single answer to pass on. */
  share?: boolean;
}

const {
  title,
  description,
  robots = "index, follow, max-snippet:-1, max-image-preview:large",
  dateModified = null,
  schema = [],
  share = true,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Every page runs the SERP-length check, so a new page can't quietly ship a
// title Google will cut in half.
/* Only pages that can actually appear in a result. A noindex page has no
   snippet to clip and no slot to waste, so warning about its description is
   noise that trains you to ignore the ones that matter. */
if (!String(robots ?? "").includes("noindex")) checkMeta(Astro.url.pathname, title, description);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta name="theme-color" content="#0C2A27" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Delaware Field Guide" />
    <meta property="og:locale" content="en_US" />
    {/* A shared link with no image unfurls as a gray box, which is a real cost
        when word of mouth is the distribution plan. */}
    <meta property="og:image" content={new URL("/og.png", Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Delaware Field Guide — where your dog is legal on the Delaware coast" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL("/og.png", Astro.site).href} />
    {dateModified && <meta property="article:modified_time" content={dateModified} />}

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {
      schema.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-2 focus:px-4 focus:py-3 focus:bg-ink focus:text-ground focus:rounded-[2px]"
    >
      Skip to content
    </a>

    <Header />
    <main id="main">
      <slot />

      {share && (
        <div class="wrap pt-4 pb-2">
          <ShareRow title={title} summary={description} />
        </div>
      )}
    </main>
    <Footer />
  
<script>
  /*
   * Reveal-on-scroll.
   *
   * The ordering here is the whole point. The hidden state lives behind a
   * .js-reveal class that this script adds, so the page is FULLY VISIBLE until
   * JavaScript has proved it is running and capable of undoing it. No script,
   * blocked script, dead observer, ancient browser — content still shows.
   *
   * There is also a hard timeout. An IntersectionObserver can fail to fire for
   * reasons that have nothing to do with this code, and the failure mode would
   * be a blank page that looks deliberate. After 1.5s everything is revealed
   * whether or not the observer ever spoke.
   */
  (() => {
    const targets = document.querySelectorAll("[data-reveal]");
    if (!targets.length) return;

    const showAll = () => targets.forEach((el) => el.classList.add("is-in"));

    if (
      window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
      !("IntersectionObserver" in window)
    ) {
      return;   // never gated, so nothing to undo
    }

    document.documentElement.classList.add("js-reveal");
    const safety = setTimeout(showAll, 1500);

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add("is-in");
          io.unobserve(e.target);
        }
      },
      { rootMargin: "0px 0px -8% 0px", threshold: 0.05 },
    );
    targets.forEach((el) => io.observe(el));

    /* Anything already on screen at load should not wait for a scroll. */
    requestAnimationFrame(() => {
      targets.forEach((el) => {
        const r = el.getBoundingClientRect();
        if (r.top < window.innerHeight && r.bottom > 0) {
          el.classList.add("is-in");
          io.unobserve(el);
        }
      });
    });

    window.addEventListener("pagehide", () => clearTimeout(safety), { once: true });
  })();
</script>
</body>
</html>
