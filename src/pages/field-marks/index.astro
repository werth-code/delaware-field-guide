---
/**
 * Field Marks — the collection hub.
 *
 * Noindexed as a whole while nothing is for sale. A shop page for a shop that
 * has no stock is the exact thing this site refuses to do everywhere else.
 */
import Layout from "../../layouts/Layout.astro";
import marksData from "../../data/field-marks.json";
import { BUNDLES, bySeries, isPublishableMark, isSellable, type FieldMark } from "../../lib/field-marks";

const marks = marksData as FieldMark[];
/* Grouped by number range rather than by a hand-kept list. This page said
   "Launch drop 01 — six places" and then "Two more, testing something" over a
   list that had quietly grown to six, four of which were birds. Same failure as
   every other hardcoded count on this site: true when written, wrong within a
   week, and invisible until somebody reads it. */
const groups = bySeries(marks);
const live = marks.filter(isPublishableMark);
---

<Layout
  title="Delaware Stickers — Field Marks from the Field Guide"
  description="Weatherproof stickers for Delaware places and birds — Cape Henlopen, Indian River Inlet, Red Knot, Black-necked Stilt and more, from Delaware Field Guide."
  robots={live.length ? undefined : "noindex, follow"}
>
  <div class="wrap pt-11 pb-6">
    <p class="label m-0">Field Marks</p>
    <h1 class="text-[2.2rem] sm:text-[2.9rem] mt-3.5 mb-0 max-w-[16ch] text-marsh">
      Field Marks
    </h1>

    {/* The H1 was "Places you've actually been", which stopped being the whole
        story the moment birds arrived. That line is still true — it's the deck
        on the Places series below, where it belongs. */}
    <p class="mt-5 mb-0 text-[1.15rem] leading-[1.5] max-w-[54ch]">
      Small weatherproof stickers for the Delaware places people keep going back
      to, and the birds worth looking up when they get there.
    </p>

    <p class="mt-4 mb-0 text-[1.05rem] leading-[1.55] max-w-[54ch]">
      Every design starts with something the Field Guide actually covers. The
      place or the bird stays front and center; the Field Guide mark stays
      small. It's the maker, not the point.
    </p>

    {
      !live.length && (
        <div class="sign breakout px-4 sm:px-5 py-4 my-7">
          <p class="label m-0">Not made yet</p>
          <p class="mt-2 mb-0 max-w-[58ch] text-[0.95rem] leading-[1.55]">
            None of these exist as physical objects. The designs below are the
            plan, not the product — no artwork is finished, nothing has been
            printed, and nothing can be bought. This page is out of search until
            that changes.
          </p>
          <p class="mt-2.5 mb-0 max-w-[58ch] text-[0.9rem] leading-[1.55] text-ink-soft">
            It exists now because the site's own rule is that a page says what
            it knows and what it doesn't. Announcing a shop that has no stock
            would be the merchandise version of publishing an unchecked fact.
          </p>
        </div>
      )
    }
  </div>

  {
    groups.map((g) => (
      <div class="wrap pb-6">
        <h2 class="label m-0 pb-1">{g.label}</h2>
        <p class="mt-1 mb-4 text-[1.05rem] max-w-[54ch]">
          {g.deck} <span class="stamp text-ink-soft">· {g.marks.length} designs</span>
        </p>

        <ul class="list-none p-0 m-0 grid gap-4 sm:grid-cols-2 breakout">
          {g.marks.map((m) => (
          <li>
                <a
                  href={`/field-marks/${m.slug}/`}
                  class="sign sign-action block no-underline group px-4 py-4 sm:px-5 sm:py-5 h-full"
                >
                  <p class="stamp text-ink-soft m-0">Field Mark {m.number}</p>
                  <p class="font-display text-[1.2rem] font-semibold tracking-[-0.03em] mt-1 mb-0 text-marsh underline decoration-ochre decoration-2 underline-offset-[0.16em] group-hover:decoration-marsh">
                    {m.name}
                  </p>
                  <p class="stamp text-ink-soft mt-1 mb-0">{m.locality}</p>
                  <p class="mt-3 mb-0 text-[0.92rem] leading-snug max-w-[44ch]">{m.pitch}</p>
                  <p class="stamp mt-3 mb-0" style="color:var(--color-ink-soft)">
                    {isSellable(m) ? `$${m.price}` : "Not made yet"}
                  </p>
                </a>
              </li>
          ))}
        </ul>
      </div>
    ))
  }

  <div class="wrap prose-field pb-4">
    <h2>There is no requirement to finish the set</h2>
    <p class="max-w-[58ch]">
      One place can matter enough. But if your Delaware keeps getting bigger,
      the collection can too — and which places get made next depends on where
      readers actually go, not on filling out a grid.
    </p>


    {
      live.length > 0 && (
        <>
          <h2>Together</h2>
          <ul>
            {BUNDLES.map((b) => (
              <li>
                {b.label} · ${b.price}
              </li>
            ))}
          </ul>
        </>
      )
    }
  </div>
</Layout>
