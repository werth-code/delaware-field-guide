---
/**
 * One winery or brewery.
 *
 * Dogs lead. Everything else on the page is ordinary opening-hours detail;
 * the dog answer is the reason somebody came, and where it isn't published
 * the page says that in the same place with the same weight.
 */
import type { GetStaticPaths } from "astro";

import Layout from "../../layouts/Layout.astro";
import FlagIcon from "../../components/FlagIcon.astro";
import MapEmbed from "../../components/MapEmbed.astro";
import MapLink from "../../components/MapLink.astro";
import Photo from "../../components/Photo.astro";
import ReportBox from "../../components/ReportBox.astro";
import ShareRow from "../../components/ShareRow.astro";

import drinkData from "../../data/drink.json";
import { dogAnswer, type DrinkPlace } from "../../lib/drink";
import { isVerified, isPublishable, robotsFor, sourcedText, stampText, tierOf } from "../../lib/verification";
import { formatStampDate } from "../../lib/rules";

export const getStaticPaths = (() =>
  (drinkData as unknown as DrinkPlace[]).map((place) => ({
    params: { slug: place.slug },
    props: { place },
  }))) satisfies GetStaticPaths;

const { place } = Astro.props as { place: DrinkPlace };
const tier = tierOf(place);
const dogs = dogAnswer(place.dogs);

const asks = [
  place.dogs.source !== "operator" ? "Can I bring a dog, and where?" : null,
  !place.hours ? "What are the opening hours?" : null,
  !place.tasting ? "What does a tasting cost?" : null,
  "Is there food?",
].filter(Boolean) as string[];

const schema = isPublishable(place)
  ? [{
      "@context": "https://schema.org",
      "@type": place.kind === "Winery" ? "Winery" : "BarOrPub",
      name: place.name,
      description: place.blurb,
      telephone: place.phone ?? undefined,
      address: {
        "@type": "PostalAddress",
        streetAddress: place.address ?? undefined,
        addressLocality: place.town,
        addressRegion: "DE",
      },
    }]
  : [];

const title = [`${place.name} — can you bring a dog?`, place.name].find((t) => t.length <= 60) ?? place.name;
const description =
  `${place.name} in ${place.town}, ${place.county} County: the dog policy from the business itself, plus hours and what a tasting costs.`.slice(0, 157);

/* The picture a shared link unfurls with. Falls back to the site card
   when this record has no photograph of its own. */
const ogPhoto = place.photos?.[0] ?? null;
const ogImage = ogPhoto ? `/photos/${ogPhoto.file}-1400.jpg` : null;

---

<Layout
  ogImage={ogImage}
  ogImageAlt={ogPhoto?.alt ?? null}
  title={title}
  description={description}
  robots={robotsFor(place)}
  dateModified={place.verifiedDate ?? place.sourcedOn}
  schema={schema}
>
  <article>
    <div class="wrap pt-11 pb-5">
      <p class="label m-0">
        <a href="/wineries-and-breweries/" class="no-underline hover:underline">Wineries and breweries</a>
        <span class="text-ink-soft"> · </span>{place.town}, {place.county} County
      </p>
      <h1 class="text-[2.2rem] sm:text-[2.9rem] mt-3.5 mb-0 max-w-[18ch] text-marsh">{place.name}</h1>
      <p class="stamp text-ink-soft mt-3 mb-0">{place.kind}</p>
    </div>

    {/* THE DOG ANSWER, FIRST. */}
    <div class="wrap">
      <aside
        class={`sign breakout px-4 sm:px-5 py-4 my-2 border-l-[9px] ${
          dogs.state === "unknown" ? "border-l-flag-red" : "border-l-flag-green"
        }`}
      >
        <p class="label m-0">Dogs</p>
        <p class="font-display text-[1.3rem] sm:text-[1.6rem] font-bold tracking-[-0.02em] mt-2 mb-0 text-marsh">
          {dogs.text}
        </p>
        {place.dogs.note && (
          <p class="mt-2.5 mb-0 text-[0.95rem] leading-[1.55] max-w-[60ch]">{place.dogs.note}</p>
        )}
        {place.phone && (
          <p class="mt-3 mb-0">
            <a href={`tel:${place.phone.replace(/[^0-9+]/g, "")}`} class="tap stamp text-[1rem]">{place.phone}</a>
          </p>
        )}
      </aside>
    </div>

    <div class="wrap prose-field pt-4">
      <p class="text-[1.15rem] leading-[1.5] max-w-[56ch]">{place.blurb}</p>

      {place.photos && place.photos.length > 0 && <Photo {...place.photos[0]} hero />}

      {place.warnings.length > 0 && (
        <ul class="list-none p-0 my-6 space-y-2">
          {place.warnings.map((w) => (
            <li class="text-[0.96rem] leading-[1.55] max-w-[60ch] flex gap-2">
              <FlagIcon icon="alert" class="w-[1em] h-[1em] mt-1.5 shrink-0 text-flag-red" />
              <span>{w}</span>
            </li>
          ))}
        </ul>
      )}

      <h2>Going</h2>
      <dl class="sign breakout my-6 divide-y-2 divide-tide/25">
        <div class="px-4 sm:px-5 py-3 sm:flex sm:gap-6">
          <dt class="label sm:w-[9rem] sm:shrink-0 sm:pt-1">Open</dt>
          <dd class={`m-0 mt-1 sm:mt-0 text-[0.95rem] leading-[1.55] ${place.hours ? "" : "text-ink-soft italic"}`}>
            {place.hours
              ? place.hours.map((h) => <span class="block">{h.days} — {h.text}</span>)
              : "Not published"}
            {place.hoursNote && <span class="block mt-1 stamp text-ink-soft">{place.hoursNote}</span>}
          </dd>
        </div>
        <div class="px-4 sm:px-5 py-3 sm:flex sm:gap-6">
          <dt class="label sm:w-[9rem] sm:shrink-0 sm:pt-1">Tastings</dt>
          <dd class={`m-0 mt-1 sm:mt-0 text-[0.95rem] leading-[1.55] max-w-[52ch] ${place.tasting ? "" : "text-ink-soft italic"}`}>
            {place.tasting ?? "Not confirmed"}
          </dd>
        </div>
        {(place.onSite ?? []).map((r) => (
          <div class="px-4 sm:px-5 py-3 sm:flex sm:gap-6">
            <dt class="label sm:w-[9rem] sm:shrink-0 sm:pt-1">{r.label}</dt>
            <dd class="m-0 mt-1 sm:mt-0 text-[0.95rem] leading-[1.55] max-w-[52ch]">{r.note}</dd>
          </div>
        ))}
        <div class="px-4 sm:px-5 py-3 sm:flex sm:gap-6">
          <dt class="label sm:w-[9rem] sm:shrink-0 sm:pt-1">Getting there</dt>
          <dd class="m-0 mt-1 sm:mt-0">
            <MapLink name={place.name} town={place.town} address={place.address ?? undefined} label="Open in Google Maps" />
          </dd>
        </div>
        {place.website && (
          <div class="px-4 sm:px-5 py-3 sm:flex sm:gap-6">
            <dt class="label sm:w-[9rem] sm:shrink-0 sm:pt-1">Website</dt>
            <dd class="m-0 mt-1 sm:mt-0 text-[0.95rem]">
              <a href={place.website.url} rel="nofollow">{place.website.label}</a>
            </dd>
          </div>
        )}
      </dl>

      <h2>Where it is</h2>
      <MapEmbed name={place.name} town={place.town} address={place.address ?? undefined} />

      {place.photos && place.photos.length > 1 && (
        <>
          <h2>More photographs</h2>
          {place.photos.slice(1).map((ph) => <Photo {...ph} />)}
        </>
      )}

      {place.reports && place.reports.length > 0 && (
        <>
          <h2 id="reports">From people who were there</h2>
          <ul class="list-none p-0 m-0 space-y-4">
            {place.reports.map((r) => (
              <li class="sign px-4 sm:px-5 py-4 border-l-[9px] border-l-tide">
                <p class="m-0 text-[0.96rem] leading-[1.55] max-w-[58ch]">{r.what}</p>
                <p class="stamp text-ink-soft mt-2.5 mb-0">
                  {r.from} · reported {formatStampDate(r.receivedOn)}
                  {r.visitedOn ? ` · visited ${formatStampDate(r.visitedOn)}` : " · visit date not given"}
                </p>
              </li>
            ))}
          </ul>
        </>
      )}

      <aside class={`sign breakout my-8 px-4 sm:px-5 py-5 border-l-[9px] ${isVerified(place) ? "border-l-flag-green" : "border-l-marsh"}`}>
        {isVerified(place)
          ? <p class="m-0"><span class="stamp stamp-struck">{stampText(place)}</span></p>
          : tier === "sourced"
            ? (<>
                <p class="label text-ochre-deep m-0">Read from the source — not yet confirmed by phone</p>
                <p class="stamp text-ink-soft mt-1.5 mb-0">{sourcedText(place)}</p>
              </>)
            : <p class="stamp text-ink-soft m-0">Not yet checked against a primary source.</p>}
        <ul class="list-none p-0 mt-4 mb-0 space-y-1.5">
          {place.sources.map((s) => (
            <li class="text-[0.88rem] leading-snug">
              <a href={s.url} rel="nofollow">{s.label}</a>
              {s.note && <span class="text-ink-soft"> — {s.note}</span>}
            </li>
          ))}
        </ul>
      </aside>

      <ShareRow title={place.name} summary={place.blurb} class="my-8" />

      <ReportBox subject={place.name} path={`/wineries-and-breweries/${place.slug}/`} asks={asks} />

      <h2>Related</h2>
      <ul>
        <li><a href="/wineries-and-breweries/">Every winery and brewery</a></li>
        <li><a href="/dogs/">Dog rules by town</a></li>
        <li><a href="/attractions/">Places to go</a></li>
      </ul>
    </div>
  </article>
</Layout>
