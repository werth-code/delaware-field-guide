---
/**
 * Every phone number on the site, in one place.
 *
 * WHY THIS PAGE EXISTS
 *
 * Half of what this site says ends in "ring first" — hours that aren't
 * published, a fee nobody states, whether the restroom block is open before
 * Memorial Day. That advice is useless if the number is three taps away on
 * another page, and it is worse than useless in a parking lot with one bar.
 * So: one page, every number, tap to call.
 *
 * DERIVED, NOT MAINTAINED. Built from the same JSON the record pages render
 * from. A number corrected on a park page is corrected here in the same
 * commit, because there is no second copy to forget about.
 *
 * IT SHOWS THE HOLES. Most records have no number yet — 2 of the 12 state
 * parks do. Listing only the ones I have would make this page look finished
 * and make the dataset look better than it is, which is the exact failure the
 * rest of the site is built to avoid. Everything appears; what's missing says
 * so and links to the record so you can tell me if you know it.
 */
import Layout from "../layouts/Layout.astro";
import FeatureIcon from "../components/FeatureIcon.astro";
import { colorFor } from "../lib/feature-colors";

import stateParksData from "../data/state-parks.json";
import communityData from "../data/community-parks.json";
import indoorData from "../data/indoor.json";
import drinkData from "../data/drink.json";
import nearbyData from "../data/nearby.json";
import { isPublishable } from "../lib/verification";
import { sectionBySlug } from "../lib/sections";

type Row = {
  name: string;
  href: string;
  phone: string | null;
  phoneNote?: string | null;
  address: string | null;
  website: { label: string; url: string } | null;
  where: string | null;
};

const rows = (data: unknown[], href: (r: any) => string): Row[] =>
  (data as any[])
    .filter(isPublishable)
    .map((r) => ({
      name: r.name,
      href: href(r),
      phone: r.phone ?? null,
      phoneNote: r.phoneNote ?? null,
      address: r.address ?? null,
      website: r.website ?? null,
      where: r.town ?? null,
    }))
    /* Numbers first. This page is for calling; a record with nothing to call
       is reference, and reference goes underneath. */
    .sort((a, b) => Number(Boolean(b.phone)) - Number(Boolean(a.phone)) || a.name.localeCompare(b.name));

/* The keys are the masthead's, taken from the section registry rather than
   retyped — this page had "free" for museums and "petsAllowed" for over the
   line, which are the marks those groups wore before the situation icons
   landed. A reader who learns the umbrella in the nav should meet it here. */
const groups = [
  { key: sectionBySlug("parks")!.icon, title: "State parks", rows: rows(stateParksData, (r) => `/parks/${r.slug}/`) },
  { key: "playground", title: "County and town parks", rows: rows(communityData, (r) => `/parks/community/${r.slug}/`) },
  { key: sectionBySlug("indoors")!.icon, title: "Museums and libraries", rows: rows(indoorData, (r) => `/indoors/${r.slug}/`) },
  { key: sectionBySlug("wineries-and-breweries")!.icon, title: "Wineries and breweries", rows: rows(drinkData, (r) => `/wineries-and-breweries/${r.slug}/`) },
  { key: sectionBySlug("nearby")!.icon, title: "Just over the line", rows: rows(nearbyData, (r) => `/nearby/${r.slug}/`) },
].filter((g) => g.rows.length);

const all = groups.flatMap((g) => g.rows);
const withPhone = all.filter((r) => r.phone).length;

/** tel: wants digits. Everything here is a US number. */
const tel = (p: string) => `tel:+1${p.replace(/\D/g, "")}`;
---

<Layout
  title="Park and county phone numbers — Delaware"
  description="Every phone number on this site in one place: state parks, town parks, museums and the places just over the line. Tap to call."
>
  <div class="wrap pt-11 pb-6">
    <p class="label m-0">Contacts</p>
    <h1 class="text-[2.2rem] sm:text-[2.9rem] mt-3.5 mb-0 max-w-[15ch] text-marsh">
      State &amp; local contact
    </h1>
  </div>

  {/* The lede and the three-number box came off. Both were the page arguing
      for itself before showing you a single number, and this is a page you
      open in a parking lot. The numbers are the content. */}

  {
    groups.map((g) => (
      <div class="wrap pb-4">
        {/*
          ALL FIVE SHUT ON ARRIVAL. Eighty rows across five headings meant
          scrolling past every state park to reach a brewery. Shut, the whole
          page is five lines and you can see everything it holds without moving
          — which is the point of a page you open in a parking lot.

          The first one used to be open, and that was the wrong default for the
          same reason: it made state parks the answer for a reader who hadn't
          said what they wanted, and buried the other four under seventeen rows
          of it.

          The count on each summary is what makes shut usable. 17/17 tells you
          the group is complete before you spend a tap on it; 13/14 tells you
          it mostly is.
        */}
        <details class="contact-group sign breakout">
          <summary class="list-none cursor-pointer px-4 sm:px-5 py-3.5 flex items-center gap-2 font-display text-[1.35rem] font-bold text-marsh">
            <FeatureIcon
              icon={g.key as any}
              class="w-[0.9em] h-[0.9em] shrink-0"
              style={`color:${colorFor(g.key)}`}
            />
            {g.title}
            <span class="stamp text-ink-soft ms-auto font-normal">
              {g.rows.filter((r) => r.phone).length}/{g.rows.length}
            </span>
            <svg viewBox="0 0 24 24" class="contact-caret w-[0.7em] h-[0.7em] shrink-0 text-ink-soft" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" aria-hidden="true">
              <path d="M4 8l8 8 8-8" />
            </svg>
          </summary>

          <dl class="m-0 border-t-2 border-tide/30 divide-y-2 divide-tide/30">
            {g.rows.map((r) => (
              <div class="px-4 sm:px-5 py-3.5 sm:flex sm:items-baseline sm:gap-5">
                <dt class="sm:w-[14rem] sm:shrink-0 flex items-baseline gap-2">
                  {/* The section's mark on every row, so a number that has been
                      copied out of context still says what kind of place it
                      belongs to. */}
                  <FeatureIcon
                    icon={g.key as any}
                    class="w-[0.85em] h-[0.85em] shrink-0 translate-y-[0.1em]"
                    style={`color:${colorFor(g.key)}`}
                  />
                  <span>
                    <a href={r.href} class="text-[1rem] font-medium">{r.name}</a>
                    {r.where && <span class="stamp text-ink-soft block mt-0.5">{r.where}</span>}
                  </span>
                </dt>
                <dd class="m-0 mt-1.5 sm:mt-0 flex-1">
                  {r.phone ? (
                    <a href={tel(r.phone)} class="font-mono text-[1.05rem] font-medium tracking-[0.01em]">
                      {r.phone}
                    </a>
                  ) : (
                    <span class="text-[0.92rem] text-ink-soft italic">
                      No number yet — <a href="/report/">tell me if you have it</a>
                    </span>
                  )}
                  {r.phone && r.phoneNote && (
                    <span class="block mt-1 text-[0.86rem] leading-snug text-ink-soft max-w-[52ch]">
                      {r.phoneNote}
                    </span>
                  )}
                  {r.address && <span class="stamp text-ink-soft block mt-1">{r.address}</span>}
                  {r.website && (
                    <span class="block mt-1">
                      <a href={r.website.url} rel="noopener nofollow" class="stamp">{r.website.label}</a>
                    </span>
                  )}
                </dd>
              </div>
            ))}
          </dl>
        </details>
      </div>
    ))
  }

  <div class="wrap pb-8">
    <h2 class="font-display text-[1.5rem] font-bold text-marsh border-b-[3px] border-marsh pb-2 mb-4 mt-6">
      Contact me
    </h2>
    <dl class="sign breakout divide-y-2 divide-tide/25">
      <div class="px-4 sm:px-5 py-3.5 sm:flex sm:gap-5 sm:items-baseline">
        <dt class="label sm:w-[11rem] sm:shrink-0">Email</dt>
        <dd class="m-0 mt-1 sm:mt-0">
          <a href="mailto:reports@delawarefieldguide.com" class="tap stamp text-[1rem]">
            reports@delawarefieldguide.com
          </a>
          <span class="block mt-1 text-[0.9rem] leading-snug text-ink-soft">
            A correction, a number that's changed, or anything I've got wrong.
          </span>
        </dd>
      </div>
      <div class="px-4 sm:px-5 py-3.5 sm:flex sm:gap-5 sm:items-baseline">
        <dt class="label sm:w-[11rem] sm:shrink-0">Send a report</dt>
        <dd class="m-0 mt-1 sm:mt-0">
          <a href="/report/" class="text-[1rem]">The report form</a>
          <span class="block mt-1 text-[0.9rem] leading-snug text-ink-soft">
            What you found when you were there, with photographs. Every record
            page has the same form on it, for that place.
          </span>
        </dd>
      </div>
      <div class="px-4 sm:px-5 py-3.5 sm:flex sm:gap-5 sm:items-baseline">
        <dt class="label sm:w-[11rem] sm:shrink-0">How this is checked</dt>
        <dd class="m-0 mt-1 sm:mt-0">
          <a href="/about/" class="text-[1rem]">The method</a>
          <span class="block mt-1 text-[0.9rem] leading-snug text-ink-soft">
            What counts as a source here, and what gets published without one.
          </span>
        </dd>
      </div>
    </dl>
  </div>

  {/* "Why some are blank" came off, and there is now almost nothing left to
      explain: every state park and all nineteen community parks have a number.
      What blanks remain are the dog parks, and each of those says "No number
      yet" on its own row with a link to send one — which is the same offer the
      three paragraphs were making, on the line where it applies. */}
<style>
  .contact-group > summary::-webkit-details-marker { display: none; }
  .contact-group > summary::marker { content: ""; }
  .contact-group[open] > summary .contact-caret { transform: rotate(180deg); }
  .contact-caret { transition: transform 140ms ease; }
  @media (prefers-reduced-motion: reduce) { .contact-caret { transition: none; } }
</style>
</Layout>
