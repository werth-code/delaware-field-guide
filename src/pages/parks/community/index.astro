---
/**
 * Community parks — the county and town parks, as opposed to the 17 state ones.
 *
 * Restrooms lead every card. It's the question people actually ask before
 * loading a car with children or an older dog, it's almost never published,
 * and "yes" versus "yes, from Memorial Day" is a whole ruined outing. The
 * honesty of this page is mostly in how many of them currently read
 * "Not confirmed" — that's the real state, and hiding it would be the
 * aggregator move.
 */
import Layout from "../../../layouts/Layout.astro";
import PhotoStrip, { type StripItem } from "../../../components/PhotoStrip.astro";
import NearMe from "../../../components/NearMe.astro";
import FlagIcon from "../../../components/FlagIcon.astro";
import CardPhoto from "../../../components/CardPhoto.astro";
import Tag from "../../../components/Tag.astro";
import CardShare from "../../../components/CardShare.astro";
import CardCall from "../../../components/CardCall.astro";
import CardDirections from "../../../components/CardDirections.astro";
import Filters from "../../../components/Filters.astro";
import CardGallery from "../../../components/CardGallery.astro";

import parksData from "../../../data/community-parks.json";
import {
  COUNTY_ORDER,
  completeness,
  present,
  restroomAnswer,
  type CommunityPark,
} from "../../../lib/community-parks";
import { isPublishable, robotsFor } from "../../../lib/verification";
import { byPhotoThen } from "../../../lib/order";


const parks = parksData as CommunityPark[];
const verified = parks.filter(isPublishable);
const pageGate = {
  verifiedDate: verified.length ? "confirmed" : null,
  verifiedSource: verified.length ? "confirmed" : null,
};

/* Filters derived from the records, so a chip can never be empty. */
const tagCounts = new Map<string, { key: string; label: string; count: number }>();
for (const r of parks) {
  for (const t of present(r)) {
    const e = tagCounts.get(t.key) ?? { key: t.key, label: t.label, count: 0 };
    e.count++;
    tagCounts.set(t.key, e);
  }
}
const filterTags = [...tagCounts.values()].sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));

const byCounty = COUNTY_ORDER.map((county) => ({
  county,
  parks: byPhotoThen(parks.filter((p) => p.county === county)),
})).filter((g) => g.parks.length);

const withRestrooms = parks.filter((p) => p.restrooms.present === true).length;
const restroomsUnknown = parks.filter((p) => p.restrooms.present === null).length;
const withDogPark = parks.filter((p) => p.facilities.dogPark === true).length;
/* ONE frame per record, not one per photograph.
   Flattening every photo made Swallow Falls twelve of the twenty-one
   frames, which is a slideshow of one park pretending to be an index of
   the section. The lead photo is the one the record chose to lead with. */
const stripItems: StripItem[] = (parks as any[])
  .filter((p) => p.photos?.length)
  .map((p) => ({ photo: p.photos[0], href: `/parks/community/${p.slug}/`, name: p.name }));
---

<Layout
  title="Delaware community parks: restrooms, playgrounds, facilities"
  description="Find Delaware community parks with restrooms, playgrounds, shade, dog parks, paved paths and other facilities. Compare by county or distance."
  robots={robotsFor(pageGate)}
>
  <div class="wrap pt-11 pb-6">
    <p class="label m-0">
      <a href="/parks/" class="no-underline hover:underline">Parks</a>
      <span class="text-ink-soft"> · </span>Community parks
    </p>
    <h1 class="text-[2.5rem] sm:text-[3.3rem] mt-3.5 mb-0 max-w-[14ch] text-marsh">
      Find a Delaware park with what you need
    </h1>
    <p class="mt-4 mb-0 stamp text-ink-soft">
      County and town parks. <a href="/parks/">The state parks are here</a>.
    </p>
  </div>

  <div class="wrap pb-6">

    <PhotoStrip items={stripItems} accent="playground" class="breakout" />

  </div>


  <div class="wrap pb-4">
    <Filters tags={filterTags} noun="parks" class="breakout">

      <NearMe noun="parks" flat />

    </Filters>
  </div>

  {
    byCounty.map(({ county, parks: group }) => (
      <div class="wrap pb-8" data-filter-group>
        <h2 class="font-display text-[1.5rem] font-bold text-marsh border-b-[3px] border-marsh pb-2 mb-5 mt-8">
          {county} County
          <span class="stamp text-ink-soft ms-2">{group.length}</span>
        </h2>

        <div class="grid gap-4 sm:grid-cols-2 breakout">
          {group.map((park) => {
            const { known, total } = completeness(park);
            const wc = restroomAnswer(park.restrooms);
            const has = present(park).filter((f) => f.key !== "dogPark");
            return (
              <article data-reveal
                data-lat={park.coords?.lat}
                data-lon={park.coords?.lon} data-tags={has.map((t) => t.key).join(" ")} class="sign sign-action relative group overflow-hidden">
                <a href={`/parks/community/${park.slug}/`} class="absolute inset-0 z-10 no-underline">
                  <span class="sr-only">{park.name}</span>
                </a>
                <CardDirections name={park.name} town={park.town} address={park.address ?? null} />
                <CardCall phone={park.phone} title={park.name} />
                <CardShare path={`/parks/community/${park.slug}/`} title={park.name} />

                {park.photos?.length && <CardGallery photos={park.photos} />}

                <div class="p-4 sm:p-5">
                  <header class="flex items-start justify-between pr-12 gap-3">
                    <div>
                      <h3 class="font-display text-[1.18rem] font-bold tracking-[-0.018em] m-0 text-marsh underline decoration-ochre decoration-2 underline-offset-[0.16em] group-hover:decoration-marsh">
                        {park.name}
                      </h3>
                      <p class="stamp text-ink-soft mt-1 mb-0">
                        {[park.operator, park.town].filter(Boolean).join(" · ")}
                      </p>
                    </div>
                    <span class="stamp text-ink-soft shrink-0">{known}/{total}</span>
                  </header>

                  {/* Restrooms first, always, and visually separated. */}
                  <div class="mt-3.5 border-y-2 border-marsh py-2.5 flex items-baseline justify-between gap-3">
                    <span class="label">Restrooms</span>
                    <span
                      class={`text-[0.92rem] text-right ${
                        wc.state === "unknown" ? "text-ink-soft italic" : "text-ink font-medium"
                      }`}
                    >
                      {wc.text}
                    </span>
                  </div>

                  <p class="mt-3 mb-0 text-[0.9rem] leading-[1.55]">{park.blurb}</p>

                  {has.length > 0 && (
                    <ul class="list-none p-0 m-0 mt-3.5 flex flex-wrap gap-1.5">
                      {has.map((f) => (
                      <Tag icon={f.key as any} label={f.label} emphasis={f.emphasis} />
                    ))}
                    </ul>
                  )}

                  <p class="stamp text-ink-soft mt-3.5 mb-0 flex items-center justify-between gap-3">
                    <span>
                      {park.facilities.dogPark === true ? "Has a dog park" : " "}
                    </span>
                    <span class="text-marsh group-hover:translate-x-0.5 transition-transform duration-100">→</span>
                  </p>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    ))
  }

  <div class="wrap prose-field pb-2">
    {/* TWO ESSAYS REMOVED. One explained why restrooms lead the card — which
        the cards demonstrate by leading with restrooms. The other explained
        that Sussex County runs no park system.

        THE SUSSEX FACT ITSELF IS NOT FURNITURE and hasn't been dropped: a
        reader in Rehoboth scrolling a page of New Castle and Kent parks needs
        to know the answer is "the state parks and your town" rather than that
        I forgot. It's one line in the coverage panel below, next to the
        counts, which is where somebody checking coverage actually looks. */}

    <div class="sign breakout my-6 px-4 sm:px-5 py-4">
      <p class="label m-0">Where this dataset stands</p>
      <dl class="grid grid-cols-3 gap-4 mt-3 mb-0">
        {
          [
            { n: parks.length, label: "parks listed" },
            { n: withRestrooms, label: "restrooms confirmed" },
            { n: withDogPark, label: "with a dog park" },
          ].map((s) => (
            <div>
              <dt class="font-display text-[2rem] font-bold text-marsh leading-none">{s.n}</dt>
              <dd class="m-0 mt-1 stamp text-ink-soft">{s.label}</dd>
            </div>
          ))
        }
      </dl>
      {/* Kept from the essay that came off this page: a reader in Rehoboth
          scrolling New Castle and Kent parks needs to know the answer is "the
          state parks and your town", not that this was overlooked. */}
      <p class="mt-3.5 mb-0 text-[0.9rem] leading-snug text-ink-soft max-w-[56ch]">
        Nothing from Sussex, and that isn't an oversight — every park on
        <a href="https://sussexcountyde.gov/state-parks" rel="nofollow">Sussex
        County's own parks page</a> is a state park, read 8 August 2026. It's
        the one Delaware county with no parks department, so below Kent the
        answer is the state parks and your town.
      </p>
      <p class="mt-2.5 mb-0 text-[0.9rem] leading-snug text-ink-soft max-w-[56ch]">
        {restroomsUnknown} of {parks.length} still read <em>Not confirmed</em>.
        That's the honest state of it — every one is on
        <a href="/about/">the call list</a> and none of them will say
        "yes" until someone has checked.
      </p>
    </div>
  </div>

  <div class="wrap prose-field pb-4">
    {/* The Sussex section came off. What it said is now one line in the
        coverage panel above, next to the counts — which is where somebody
        checking coverage looks, and is proportionate to a fact that takes a
        sentence. The source went up there with it rather than being dropped:
        it's the only thing that turned the claim from a hunch into a fact. */}

    <h2>Related</h2>
    <ul>
      <li><a href="/parks/">The 17 Delaware state parks</a></li>
      <li><a href="/dogs/dog-parks/">Dog parks — the eight fields</a></li>
      <li><a href="/about/">How I check this</a></li>
    </ul>
  </div>
</Layout>
