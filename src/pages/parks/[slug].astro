---
import { factIcon } from "../../lib/fact-icons";
/**
 * One state park, one page.
 *
 * Same shape as a dog-park page: warnings first where they exist, then the
 * facility grid, then what's still unconfirmed, stated openly. The dog line
 * is prominent because it's the cross-section link that makes a single domain
 * worth having — someone reading the dog section lands here, and vice versa.
 */
import type { GetStaticPaths } from "astro";

import Layout from "../../layouts/Layout.astro";
import FieldMarkModule from "../../components/FieldMarkModule.astro";
import PhotoStrip, { type StripItem } from "../../components/PhotoStrip.astro";
import PhotoGap from "../../components/PhotoGap.astro";
import FlagIcon from "../../components/FlagIcon.astro";
import MapLink from "../../components/MapLink.astro";
import MapEmbed from "../../components/MapEmbed.astro";
import FieldNotes from "../../components/FieldNotes.astro";
import ReportBox from "../../components/ReportBox.astro";
import FeatureIcon from "../../components/FeatureIcon.astro";

import parksData from "../../data/state-parks.json";
import {
  COUNTY_ORDER,
  FEATURE_LABELS,
  completeness,
  asksForStatePark,
  feeText,
  FEE_SEASON,
  PASSES,
  type StatePark,
} from "../../lib/state-parks";
import { isPublishable, isVerified, reportOutstanding, robotsFor, sourcedText, stampText, tierOf } from "../../lib/verification";
import { colorFor } from "../../lib/feature-colors";

export const getStaticPaths = (() =>
  (parksData as StatePark[]).map((park) => ({
    params: { slug: park.slug },
    props: { park },
  }))) satisfies GetStaticPaths;

const { park } = Astro.props as { park: StatePark };
reportOutstanding(`parks/${park.slug}`, park);

const { known, total } = completeness(park);
const fee = feeText(park);
const verified = isVerified(park);
const publishable = isPublishable(park);

const others = (parksData as StatePark[]).filter(
  (p) => p.county === park.county && p.slug !== park.slug,
);

const tri = (v: boolean | null) =>
  v === null || v === undefined
    ? { text: "Not confirmed", state: "unknown" as const }
    : v
      ? { text: "Yes", state: "yes" as const }
      : { text: "No", state: "no" as const };

const schema = publishable
  ? [
      {
        "@context": "https://schema.org",
        "@type": "Park",
        name: park.name,
        description: park.blurb,
        address: { "@type": "PostalAddress", addressLocality: park.town, addressRegion: "DE" },
        ...(park.phone ? { telephone: park.phone } : {}),
      },
    ]
  : [];

/* Pad short names so the description still fills the SERP slot — Lums Pond
   came out at 108 characters and wasted half of it. */
const base =
  `${park.name} State Park, ${park.town} — ${park.kind.toLowerCase()}` +
  `${park.acres ? `, ${park.acres.toLocaleString()} acres` : ""}. ` +
  `Camping, trails, 2026 entry fees and where dogs are allowed.`;
const description =
  base.length < 118 ? `${base} Checked and dated, with the gaps marked.` : base;
/* This record's own photographs, as a strip. No href: a frame linking to the
   page you are already on is a dead control that looks live. */
const stripItems: StripItem[] = ((park as any).photos ?? []).map((photo: any) => ({ photo }));


/* The picture a shared link unfurls with. Falls back to the site card
   when this record has no photograph of its own. */
const ogPhoto = park.photos?.[0] ?? null;
const ogImage = ogPhoto ? `/photos/${ogPhoto.file}-1400.jpg` : null;

---

<Layout
  ogImage={ogImage}
  ogImageAlt={ogPhoto?.alt ?? null}
  title={[
    `${park.name} State Park, Delaware — fees and facilities`,
    `${park.name} State Park, Delaware — entry fees`,
    `${park.name} State Park, Delaware`,
    `${park.name} State Park`,
  ].find((t) => t.length >= 25 && t.length <= 60) ?? `${park.name} State Park`}
  description={description.slice(0, 157)}
  robots={robotsFor(park)}
  dateModified={park.verifiedDate}
  schema={schema}
>
  <article>
    <div class="wrap pt-11 pb-6">
      <p class="label m-0">
        <a href="/parks/" class="no-underline hover:underline">Parks</a>
        <span class="text-ink-soft"> · </span>{park.county} County
      </p>
      <h1 class="text-[2.4rem] sm:text-[3.1rem] mt-3.5 mb-0 max-w-[15ch] text-marsh">
        {park.name}
      </h1>
      <p class="stamp text-ink-soft mt-3 mb-0">
        {park.kind}{park.address ? ` · ${park.address}` : ""} · {park.town}{park.acres ? ` · ${park.acres.toLocaleString()} acres` : ""}
      </p>
    </div>

    {/* The photographs come before the warnings and before the prose.
        You decide whether a place is worth reading about by looking at
        it, and a wall of red boxes between the name and the pictures
        answers a question nobody has asked yet. */}
    <div class="wrap pb-2">
      {stripItems.length > 0 ? (
        <PhotoStrip items={stripItems} accent="trails" captions fill heading="Photographs" class="breakout" />
      ) : (
        <PhotoGap subject={park.name} accent="trails" class="breakout" />
      )}
    </div>

    {
      park.warnings.length > 0 && (
        <div class="wrap">
          <aside
            class="border-2 border-flag-red border-l-[9px] bg-flag-red-wash px-4 sm:px-5 py-4 rounded-[2px] my-2"
            style="box-shadow: 5px 5px 0 0 var(--color-flag-red-bearing);"
          >
            <p class="label text-flag-red-bearing m-0 flex items-center gap-1.5">
              <FlagIcon icon="alert" class="w-[1em] h-[1em]" />
              Before you go
            </p>
            <ul class="list-none p-0 m-0 mt-2 space-y-1.5">
              {park.warnings.map((w) => (
                <li class="text-[0.96rem] leading-[1.5] max-w-[56ch]">{w}</li>
              ))}
            </ul>
          </aside>
        </div>
      )
    }

    <div class="wrap prose-field pt-6">
      <p class="text-[1.2rem] leading-[1.5] font-medium max-w-[54ch] border-l-[5px] border-l-ochre ps-4 sm:ps-5">
        {park.blurb}
      </p>

      <h2>What's there</h2>
      <div class="sign breakout my-6 p-4 sm:p-5">
        <div class="flex items-baseline justify-between gap-4">
          <p class="label m-0">Facilities</p>
          <span class="stamp text-ink-soft">{known}/{total} confirmed</span>
        </div>

        <dl class="grid grid-cols-2 sm:grid-cols-3 gap-x-6 gap-y-0 mt-3.5 mb-0 border-t-2 border-marsh">
          {
            FEATURE_LABELS.map(([key, label]) => {
              const v = tri(park.features[key]);
              return (
                <div class="border-b border-tide/30 py-2.5">
                  {/* Colour ONLY on a confirmed yes — a feature confirmed
                      ABSENT was getting its identity color, so "No" looked
                      like a yes at a glance. Otherwise the same glyph and
                      color the chip uses on the index, so a reader meets the
                      feature twice in the same clothes. */}
                  <dt class="label flex items-center gap-1.5">
                    <FeatureIcon
                      icon={key as any}
                      class="w-[1.15em] h-[1.15em] shrink-0"
                      style={v.state === "yes" ? `color:${colorFor(key)}` : "color:var(--color-ink-soft);opacity:.4"}
                    />
                    {label}
                  </dt>
                  <dd
                    class={`m-0 mt-0.5 text-[0.93rem] ${
                      v.state === "unknown" ? "text-ink-soft italic" : "text-ink"
                    }`}
                  >
                    {v.text}
                  </dd>
                </div>
              );
            })
          }
        </dl>
      </div>

      {
        /* Located facts sit right under the feature grid, because the grid
           says a thing exists and this says where it is. "Restrooms: yes" is
           true of Alapocas Run and no use on its own — they're inside the
           Blue Ball Barn, and the trail starts across the road from it. */
        park.onSite && park.onSite.length > 0 && (
          <>
            <h2>Where things are</h2>
            <dl class="sign breakout my-6 divide-y-2 divide-tide/30">
              {park.onSite.map((r) => (
                <div class="px-4 sm:px-5 py-3 sm:flex sm:gap-6">
                  <dt class="label sm:w-[9rem] sm:shrink-0 sm:pt-1 flex items-start gap-1.5">{factIcon(r.label) && <FeatureIcon icon={factIcon(r.label)!} class="w-[1.25em] h-[1.25em] shrink-0 mt-[0.02em] opacity-80" />}<span>{r.label}</span></dt>
                  <dd class="m-0 mt-1 sm:mt-0 text-[0.95rem] leading-[1.55] max-w-[52ch]">{r.note}</dd>
                </div>
              ))}
            </dl>
          </>
        )
      }

      <h2>Getting in</h2>
      <dl class="sign breakout my-6 divide-y-2 divide-tide/30">
        <div class="px-4 sm:px-5 py-3 sm:flex sm:gap-6">
          <dt class="label sm:w-[9rem] sm:shrink-0 sm:pt-1 flex items-start gap-1.5">{factIcon("Entry, 2026") && <FeatureIcon icon={factIcon("Entry, 2026")!} class="w-[1.25em] h-[1.25em] shrink-0 mt-[0.02em] opacity-80" />}<span>Entry, 2026</span></dt>
          <dd class={`m-0 mt-1 sm:mt-0 text-[0.95rem] ${fee.state === "unknown" ? "text-ink-soft italic" : ""}`}>
            {fee.text}
            {fee.state === "yes" && (
              <span class="block stamp text-ink-soft mt-1">Charged {FEE_SEASON}. Free outside it.</span>
            )}
            {/* What the gate fee does NOT cover. A reader who has just read
                "$5 in-state" has every reason to assume it covers the water
                park, and it doesn't. */}
            {park.feeNote && (
              <span class="block mt-1.5 text-[0.88rem] leading-snug text-flag-red-bearing not-italic">
                {park.feeNote}
              </span>
            )}
          </dd>
        </div>
        <div class="px-4 sm:px-5 py-3 sm:flex sm:gap-6">
          <dt class="label sm:w-[9rem] sm:shrink-0 sm:pt-1 flex items-start gap-1.5">{factIcon("Annual pass") && <FeatureIcon icon={factIcon("Annual pass")!} class="w-[1.25em] h-[1.25em] shrink-0 mt-[0.02em] opacity-80" />}<span>Annual pass</span></dt>
          <dd class="m-0 mt-1 sm:mt-0 text-[0.95rem] leading-[1.55]">
            ${PASSES.resident} for a Delaware-registered vehicle, ${PASSES.nonResident} out of state.
            <span class="block text-[0.88rem] text-ink-soft mt-1 leading-snug">{PASSES.note}</span>
          </dd>
        </div>
        <div class="px-4 sm:px-5 py-3 sm:flex sm:gap-6">
          <dt class="label sm:w-[9rem] sm:shrink-0 sm:pt-1 flex items-start gap-1.5">{factIcon("Where to buy") && <FeatureIcon icon={factIcon("Where to buy")!} class="w-[1.25em] h-[1.25em] shrink-0 mt-[0.02em] opacity-80" />}<span>Where to buy</span></dt>
          <dd class="m-0 mt-1 sm:mt-0 text-[0.95rem] leading-[1.55]">
            <a href={PASSES.whereUrl} rel="nofollow">Delaware State Parks — passes and permits</a>
            <span class="block text-[0.88rem] text-ink-soft mt-1 leading-snug">{PASSES.where}</span>
          </dd>
        </div>
        <div class="px-4 sm:px-5 py-3 sm:flex sm:gap-6">
          <dt class="label sm:w-[9rem] sm:shrink-0 sm:pt-1 flex items-start gap-1.5">{factIcon("Hours") && <FeatureIcon icon={factIcon("Hours")!} class="w-[1.25em] h-[1.25em] shrink-0 mt-[0.02em] opacity-80" />}<span>Hours</span></dt>
          <dd class={`m-0 mt-1 sm:mt-0 text-[0.95rem] ${park.hours ? "" : "text-ink-soft italic"}`}>
            {park.hours ?? "Daily hours not confirmed"}
            {park.hoursNote && (
              <span class="block mt-1 not-italic text-ink stamp">{park.hoursNote}</span>
            )}
          </dd>
        </div>
        <div class="px-4 sm:px-5 py-3 sm:flex sm:gap-6">
          <dt class="label sm:w-[9rem] sm:shrink-0 sm:pt-1 flex items-start gap-1.5">{factIcon("Getting there") && <FeatureIcon icon={factIcon("Getting there")!} class="w-[1.25em] h-[1.25em] shrink-0 mt-[0.02em] opacity-80" />}<span>Getting there</span></dt>
          <dd class="m-0 mt-1 sm:mt-0">
            <MapLink name={`${park.name} State Park`} town={park.town} label="Open in Google Maps" />
          </dd>
        </div>
        <div class="px-4 sm:px-5 py-3 sm:flex sm:gap-6">
          <dt class="label sm:w-[9rem] sm:shrink-0 sm:pt-1 flex items-start gap-1.5">{factIcon("Park office") && <FeatureIcon icon={factIcon("Park office")!} class="w-[1.25em] h-[1.25em] shrink-0 mt-[0.02em] opacity-80" />}<span>Park office</span></dt>
          <dd class="m-0 mt-1 sm:mt-0 text-[0.95rem]">
            {park.phone ? (
              <a href={`tel:${park.phone.replace(/[^0-9+]/g, "")}`} class="tap stamp text-[1rem]">
                {park.phone}
              </a>
            ) : (
              <span class="text-ink-soft italic">Not confirmed</span>
            )}
          </dd>
        </div>
      </dl>

      <h2>Dogs</h2>
      <div class="sign breakout my-6 px-4 sm:px-5 py-4 border-l-[9px] border-l-ochre">
        <p class="m-0 text-[1rem] leading-[1.5] max-w-[56ch]">{park.dogs.summary}</p>
        {park.dogs.href && (
          <p class="mt-2.5 mb-0 text-[0.92rem]">
            <a href={park.dogs.href}>The full rule, with dates</a>
          </p>
        )}
      </div>

      {/* The internal to-do list used to render here as "Still to confirm".
          It was written for whoever makes the phone calls — "PRIORITY: get the
          admission price" — and putting that in front of a visitor asks them
          to care about our workflow. They don't; they wanted the answer too.
          It lives in CALL-SHEET.md now, and the reader gets the same gaps as
          tappable questions in the report box below. Every unconfirmed field
          still reads "Not confirmed" where it sits, which is the honest signal
          that actually helps. */}

      {
        others.length > 0 && (
          <>
            <h2>Other parks in {park.county} County</h2>
            <ul>
              {others.map((p) => (
                <li>
                  <a href={`/parks/${p.slug}/`}>{p.name}</a>
                  <span class="stamp text-ink-soft"> — {p.kind.toLowerCase()}, {p.town}</span>
                </li>
              ))}
            </ul>
          </>
        )
      }

      <h2>Where it is</h2>
      <MapEmbed name={`${park.name} State Park`} town={park.town} address={null} />

      {park.fieldNotes && park.fieldNotes.length > 0 && <FieldNotes notes={park.fieldNotes} />}

      {/*
        WHERE THIS CAME FROM.
        Six record types on this site showed their sources and the seventeen
        state parks — the flagship section — showed none. The promise is that
        every fact carries its provenance; that promise was being kept
        everywhere except the pages most people land on.
      */}
      <aside
        class={`sign breakout my-8 px-4 sm:px-5 py-5 border-l-[9px] ${
          isVerified(park) ? "border-l-flag-green" : "border-l-marsh"
        }`}
      >
        {
          isVerified(park)
            ? <p class="m-0"><span class="stamp stamp-struck">{stampText(park)}</span></p>
            : tierOf(park) === "sourced"
              ? (
                <>
                  <p class="label text-ochre-deep m-0">Read from the source — not yet confirmed by phone</p>
                  <p class="stamp text-ink-soft mt-1.5 mb-0">{sourcedText(park)}</p>
                </>
              )
              : <p class="stamp text-ink-soft m-0">Not yet checked against a primary source.</p>
        }
        <ul class="list-none p-0 mt-4 mb-0 space-y-1.5">
          {(park.sources ?? []).map((s) => (
            <li class="text-[0.88rem] leading-snug">
              <a href={s.url} rel="nofollow">{s.label}</a>
              {s.note && <span class="text-ink-soft"> — {s.note}</span>}
            </li>
          ))}
        </ul>
      </aside>


      <ReportBox subject={`${park.name} State Park`} path={`/parks/${park.slug}/`} asks={asksForStatePark(park)} />

      {/* After the answer, before Related. Renders nothing unless this
          exact path is whitelisted AND the sticker actually exists. */}
      <FieldMarkModule />

      <h2>Related</h2>
      <ul>
        <li><a href="/parks/">All 17 Delaware state parks</a></li>
        <li><a href="/dogs/state-parks/">Dogs in the state parks — the year-round exception</a></li>
        <li><a href="/about/">How I check this</a></li>
      </ul>
    </div>
  </article>
</Layout>
