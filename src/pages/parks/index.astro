---
/**
 * Section two: every Delaware state park.
 *
 * Same grammar as the dog section — a card grid grouped by county, seven-ish
 * fields, `null` rendered as "Not confirmed", and the whole thing behind the
 * same verification gate. Sussex first, because the coastal parks are what
 * most people are looking for and they're what the dog section leans on.
 *
 * The 2026 fee rise leads, because it roughly doubled at the beach parks and
 * almost nothing published has caught up.
 */
import Layout from "../../layouts/Layout.astro";
import PhotoStrip, { type StripItem } from "../../components/PhotoStrip.astro";
import NearMe from "../../components/NearMe.astro";
import CoastBand from "../../components/CoastBand.astro";
import FlagIcon from "../../components/FlagIcon.astro";
import CardPhoto from "../../components/CardPhoto.astro";
import Tag from "../../components/Tag.astro";
import CardShare from "../../components/CardShare.astro";
import Filters from "../../components/Filters.astro";
import CardGallery from "../../components/CardGallery.astro";

import parksData from "../../data/state-parks.json";
import { COUNTY_ORDER, completeness, feeText, present, type StatePark } from "../../lib/state-parks";
import { isPublishable, robotsFor } from "../../lib/verification";
import { byPhotoThen } from "../../lib/order";

const parks = parksData as StatePark[];
const verified = parks.filter(isPublishable);
const pageGate = {
  verifiedDate: verified.length ? "confirmed" : null,
  verifiedSource: verified.length ? "confirmed" : null,
};

/* Filters are derived from the records, so a chip can never be empty and the
   counts can never disagree with the grid. */
const tagCounts = new Map<string, { key: string; label: string; count: number }>();
for (const p of parks) {
  for (const t of present(p)) {
    const e = tagCounts.get(t.key) ?? { key: t.key, label: t.label, count: 0 };
    e.count++;
    tagCounts.set(t.key, e);
  }
}

const filterTags = [...tagCounts.values()].sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));

const byCounty = COUNTY_ORDER.map((county) => ({
  county,
  /* Photographed records lead inside each county. See src/lib/order.ts. */
  parks: byPhotoThen(parks.filter((p) => p.county === county)),
})).filter((g) => g.parks.length);

const totalAcres = parks.reduce((n, p) => n + (p.acres ?? 0), 0);

const schema = verified.length
  ? [
      {
        "@context": "https://schema.org",
        "@type": "ItemList",
        name: "Delaware state parks",
        itemListElement: verified.map((p, i) => ({
          "@type": "ListItem",
          position: i + 1,
          item: { "@type": "Park", name: p.name, address: `${p.town}, DE` },
        })),
      },
    ]
  : [];
/* ONE frame per record, not one per photograph.
   Flattening every photo made Swallow Falls twelve of the twenty-one
   frames, which is a slideshow of one park pretending to be an index of
   the section. The lead photo is the one the record chose to lead with. */
const stripItems: StripItem[] = (parks as any[])
  .filter((p) => p.photos?.length)
  .map((p) => ({ photo: p.photos[0], href: `/parks/${p.slug}/`, name: p.name }));
---

<Layout
  title="All 17 Delaware state parks — fees and facilities"
  description="All 17 Delaware state parks: what each one actually has, the 2026 entry fees, and where dogs are allowed. Checked and dated, with the gaps marked."
  robots={robotsFor(pageGate)}
  schema={schema}
>
  <CoastBand height="h-[9rem] sm:h-[12rem]" />

  <div class="wrap pt-9 pb-6">
    <p class="label m-0">Section two</p>
    <h1 class="text-[2.5rem] sm:text-[3.3rem] mt-3.5 mb-0 max-w-[14ch] text-marsh">
      Every Delaware state park
    </h1>
    <p class="mt-5 mb-0 text-[1.15rem] leading-[1.5] max-w-[54ch]">
      Seventeen parks and roughly {Math.round(totalAcres / 1000)},000 acres, from
      a Civil War island you can only reach by ferry to the northernmost bald
      cypress swamp in the country. What's actually at each one, what it costs,
      and whether the dog can come.
    </p>
  </div>

  <div class="wrap pb-7">

    <PhotoStrip items={stripItems} accent="trails" class="breakout" />

  </div>

  <div class="wrap pb-4">
    <Filters tags={filterTags} noun="parks" class="breakout">

      <NearMe noun="parks" flat />

    </Filters>
  </div>

  {
    byCounty.map(({ county, parks: group }) => (
      <div class="wrap pb-8" data-filter-group>
        <h2 class="font-display text-[1.5rem] font-bold text-marsh border-b-[3px] border-marsh pb-2 mb-5 mt-8">
          {county} County
          <span class="stamp text-ink-soft ms-2">{group.length}</span>
        </h2>

        <div class="grid gap-4 sm:grid-cols-2 breakout">
          {group.map((park) => {
            const { known, total } = completeness(park);
            const has = present(park);
            const fee = feeText(park);
            return (
              <article
                data-reveal
                data-lat={park.coords?.lat}
                data-lon={park.coords?.lon}
                data-tags={has.map((t) => t.key).join(" ")}
                class="sign sign-action relative group"
              >
                <a href={`/parks/${park.slug}/`} class="absolute inset-0 z-10 no-underline">
                  <span class="sr-only">{park.name}</span>
                </a>
                <CardShare path={`/parks/${park.slug}/`} title={park.name} />

                {park.photos?.length && <CardGallery photos={park.photos} />}

                <div class="p-4 sm:p-5">
                  <header class="flex items-start justify-between pr-12 gap-3">
                    <div>
                      <h3 class="font-display text-[1.2rem] font-bold tracking-[-0.018em] m-0 text-marsh underline decoration-ochre decoration-2 underline-offset-[0.16em] group-hover:decoration-marsh">
                        {park.name}
                      </h3>
                      <p class="stamp text-ink-soft mt-1 mb-0">
                        {park.kind} · {park.town}
                        {park.acres ? ` · ${park.acres.toLocaleString()} acres` : ""}
                      </p>
                    </div>
                    <span class="stamp text-ink-soft shrink-0">{known}/{total}</span>
                  </header>

                  <p class="mt-3 mb-0 text-[0.92rem] leading-[1.55]">{park.blurb}</p>

                  {has.length > 0 && (
                    <ul class="list-none p-0 m-0 mt-3.5 flex flex-wrap gap-1.5">
                      {has.map((f) => (
                      <Tag icon={f.key as any} label={f.label} emphasis={f.emphasis} />
                    ))}
                    </ul>
                  )}

                  {park.warnings.length > 0 && (
                    <p class="mt-3 mb-0 text-[0.85rem] leading-snug text-ink-soft flex gap-1.5">
                      <FlagIcon icon="alert" class="w-[1em] h-[1em] mt-1 shrink-0 text-flag-red" />
                      <span>{park.warnings[0]}</span>
                    </p>
                  )}

                  <p class="stamp text-ink-soft mt-3.5 mb-0 flex items-center justify-between gap-3">
                    <span class={fee.state === "unknown" ? "italic" : ""}>{fee.text}</span>
                    <span class="text-marsh group-hover:translate-x-0.5 transition-transform duration-100">→</span>
                  </p>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    ))
  }

  <div class="wrap prose-field pb-2">
    <h2>What it costs in 2026</h2>
    <p class="max-w-[58ch]">
      Entry fees rose on <strong>1 March 2026</strong> and the beach parks
      roughly doubled. Most published guides still quote the old numbers, so
      budget from this instead of from a blog post.
    </p>

    <dl class="sign breakout my-6 divide-y-2 divide-tide/30">
      {
        [
          { label: "Beach parks — in-state vehicle", value: "$10 / day" },
          { label: "Beach parks — out-of-state", value: "$20 / day" },
          { label: "Inland parks — in-state", value: "$5 / day" },
          { label: "Inland parks — out-of-state", value: "$10 / day" },
          { label: "Annual pass — in-state", value: "$50" },
          { label: "Annual pass — out-of-state", value: "$100" },
          { label: "Lifetime pass — DE residents 65+", value: "$150" },
        ].map((f) => (
          <div class="px-4 sm:px-5 py-3 flex items-baseline justify-between gap-6">
            <dt class="label">{f.label}</dt>
            <dd class="m-0 stamp text-[0.95rem] text-ink shrink-0">{f.value}</dd>
          </div>
        ))
      }
    </dl>
    <p class="stamp text-ink-soft mt-0 mb-0">
      Charged 1 March – 30 November. Seniors and military get 50% off the annual
      pass. Surf-fishing permits are priced separately.
    </p>

    <h2>Dogs, in one line</h2>
    <p class="max-w-[58ch]">
      Leashed, everywhere, all year — <em>except</em> on guarded swimming
      beaches between 1 May and 30 September, and at Beach Plum Island, which is
      closed to pets year-round. That exception is narrower than almost every
      guide reports it.
      <a href="/dogs/state-parks/">The full rule is in the dog section</a>.
    </p>
  </div>

  <div class="wrap prose-field pb-4">
    <h2>How complete this is</h2>
    <p class="max-w-[58ch]">
      Every card shows how many of its nine facilities are confirmed. A field
      reading <em>Not confirmed</em> means I haven't checked it — it doesn't
      mean the park lacks the thing. Park office numbers and seasonal hours are
      the biggest gap and they're all on the call list.
    </p>

    <h2>Related</h2>
    <ul>
      <li><a href="/dogs/state-parks/">Dogs in the state parks — the year-round exception</a></li>
      <li><a href="/dogs/summer/">Where a dog is legal in July</a></li>
      <li><a href="/how-we-verify/">How I check this</a></li>
    </ul>
  </div>
</Layout>
