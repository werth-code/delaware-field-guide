---
/**
 * The town page template.
 *
 * Every town renders from src/data/towns.json through this one file. Week 3
 * (Dewey, Bethany, Lewes, Fenwick) is four data records and zero new markup.
 *
 * Page structure is fixed by spec and must not be reordered:
 *   1. Question-shaped H1
 *   2. Status band for today
 *   3. The answer, under 40 words, extractable standalone
 *   4. Supporting detail — table first, prose second
 *   5. What to do instead, if the answer is no
 *   6. Verification stamp
 *   7. Related pages
 */
import type { GetStaticPaths } from "astro";

import Layout from "../../layouts/Layout.astro";
import MapLink from "../../components/MapLink.astro";
import MapEmbed from "../../components/MapEmbed.astro";
import ReportBox from "../../components/ReportBox.astro";
import StatusBand from "../../components/StatusBand.astro";
import RuleTable from "../../components/RuleTable.astro";
import VerificationStamp from "../../components/VerificationStamp.astro";
import FlagMark from "../../components/FlagMark.astro";
import TownContacts from "../../components/TownContacts.astro";
import Photo from "../../components/Photo.astro";

import townsData from "../../data/towns.json";
import type { Town } from "../../lib/rules";
import { STATUS_META, formatLongDate, formatRange, formatWindow, ruleFor, statusOn } from "../../lib/rules";
import { assertAnswerLength, isPublishable, isVerified, reportOutstanding, robotsFor } from "../../lib/verification";

const towns = townsData as Town[];

export const getStaticPaths = (() => {
  return (townsData as Town[]).map((town) => ({
    params: { slug: town.slug },
    props: { town },
  }));
}) satisfies GetStaticPaths;

const { town } = Astro.props as { town: Town };

/* What a dog owner standing on the boardwalk would actually ask. Derived, so
   a question stops appearing once the field is filled in. */
const asks = [
  !town.phone ? "What's the town's number?" : null,
  "Is the rule signed on the beach?",
  "Are dogs allowed on the boardwalk?",
  "Is it enforced off-season?",
].filter(Boolean) as string[];

// Build-time gate: the answer is the format. Fail the build, not the reader.
assertAnswerLength(town.slug, town.answer);

// Unverified pages announce what they are waiting on, in the terminal.
reportOutstanding(town.slug, town);

/*
  "Today" is resolved at build time. That is only honest if the site rebuilds
  daily — the deploy workflow runs on a cron for exactly this reason — and if
  the date is stated rather than implied. Hence "as of {today}" on the band:
  a stale build then reads as out-of-date, not as wrong.
*/
const today = new Date();
const status = statusOn(town, today);
const asOf = formatLongDate(today);

const beachRule = ruleFor(town, "beach", today);
const boardwalkRule = ruleFor(town, "boardwalk", today);

const nextChange = town.rules
  .filter((r) => r.area === "beach" && r.status !== beachRule?.status)
  .map((r) => formatRange(r).split(" – ")[0])[0];

const headline = {
  allowed: `Dogs are allowed on ${town.name} today`,
  restricted: `Dogs are allowed on ${town.name} today, with limits`,
  prohibited: `Dogs are not allowed on ${town.name} today`,
}[status];

/*
  When a rule is time-windowed, the hours ARE the answer — "allowed, with
  limits" without them sends someone to the beach at noon. So they lead.
*/
const windowText = formatWindow(beachRule?.timeWindow ?? null);

/* Only claim the boardwalk is shut where the data actually carries a
   boardwalk rule — Fenwick has none, and asserting one would be a fabricated
   fact on a page whose whole point is not doing that. */
const boardwalkShut =
  boardwalkRule?.status === "prohibited" && beachRule?.status === "prohibited";

const detail =
  status === "prohibited"
    ? `Today falls inside the ${beachRule ? formatRange(beachRule) : ""} closure — ${
        boardwalkShut ? "off the beach and off the boardwalk" : "off the beach"
      } at every hour.${nextChange ? ` Dogs come back ${nextChange}.` : ""}`
    : windowText
      ? `Today, ${windowText} — not in between. ${beachRule?.note ?? ""}`.trim()
      : (beachRule?.note ?? null);

const verified = isVerified(town);
const publishable = isPublishable(town);
const alternatives = town.alternatives ?? [];

/* Sibling towns, each summarised by its closed window — the thing a reader
   crossing town lines actually needs. */
const siblings = towns.filter((t) => t.slug !== town.slug);

function summarise(t: Town): string {
  const shut = t.rules.find((r) => r.area === "beach" && r.status === "prohibited");
  if (shut) return `shut ${formatRange(shut)}`;
  const limited = t.rules.find((r) => r.area === "beach" && r.status === "restricted");
  if (limited) {
    const w = formatWindow(limited.timeWindow);
    return w ? `open all year, ${w} in season` : "open all year, with limits in season";
  }
  return "open all year";
}

/* --------------------------------------------------------------- schema -- */

const canonical = new URL(Astro.url.pathname, Astro.site).href;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: town.question,
  description: town.metaDescription,
  mainEntityOfPage: canonical,
  ...(town.verifiedDate ? { dateModified: town.verifiedDate, datePublished: town.verifiedDate } : {}),
  author: { "@type": "Organization", name: "Delaware Field Guide" },
  publisher: { "@type": "Organization", name: "Delaware Field Guide" },
  ...(publishable && town.sources.length
    ? { citation: town.sources.map((s) => ({ "@type": "CreativeWork", name: s.label, url: s.url })) }
    : {}),
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    { "@type": "Question", name: town.question, acceptedAnswer: { "@type": "Answer", text: town.answer } },
    ...town.rules
      .filter((r) => r.area === "beach")
      .map((r) => ({
        "@type": "Question",
        name: `Are dogs allowed on ${town.name} between ${formatRange(r)}?`,
        acceptedAnswer: {
          "@type": "Answer",
          text: `${STATUS_META[r.status].word}. ${r.note ?? ""}`.trim(),
        },
      })),
  ],
};

// Unverified pages are noindex — don't hand a crawler structured data for
// something I've told it not to index.
const schema = publishable ? [articleSchema, faqSchema] : [];
---

<Layout
  title={town.title}
  description={town.metaDescription}
  robots={robotsFor(town)}
  dateModified={town.verifiedDate}
  schema={schema}
>
  <article>
    <div class="wrap pt-11 pb-7">
      <p class="label m-0 flex items-center gap-2">
        <FlagMark class="w-[0.5rem] h-[0.62rem] shrink-0 text-ochre-deep" />
        {town.name} · {town.county} County
      </p>
      <h1 class="text-[2.5rem] sm:text-[3.3rem] mt-3.5 mb-0 max-w-[15ch] text-marsh">{town.question}</h1>

      {/* Status sits with the heading rather than as a full-bleed band between
          sections — it answers "today", which is a note on the question, not a
          division of the page. */}
      <StatusBand status={status} headline={headline} detail={detail} asOf={asOf} />
    </div>

    <div class="wrap prose-field">
      {/* The answer. Under 40 words, enforced at build. Must stand alone —
          this is the paragraph an AI assistant lifts, and the whole page for
          someone reading it one-handed in the sun. Set larger than body and
          hung off a rule so the eye lands here first. */}
      <p
        class="text-[1.28rem] leading-[1.45] font-medium max-w-[54ch] border-l-[5px] border-l-ochre ps-4 sm:ps-5"
      >
        {town.answer}
      </p>


      {town.photos && town.photos.length > 0 && <Photo {...town.photos[0]} hero />}

      <h2>The dates</h2>
      <RuleTable rules={town.rules} caption={`${town.name} — dog rules by season`} />

      {
        boardwalkRule?.note && boardwalkRule.status !== beachRule?.status && (
          <p class="text-[0.95rem]">
            <strong>Note the split:</strong> the beach and the boardwalk aren't
            always on the same rule today. Check both rows above.
          </p>
        )
      }

      {
        town.alsoTrue.length > 0 && (
          <>
            <h2>Also true</h2>
            <dl class="sign breakout my-7 divide-y-2 divide-tide/30">
              {town.alsoTrue.map((item) => (
                <div class="px-4 sm:px-5 py-3.5 sm:flex sm:gap-6">
                  <dt class="label sm:w-[11rem] sm:shrink-0 sm:pt-1">{item.label}</dt>
                  <dd class="m-0 mt-1 sm:mt-0 text-[0.95rem] leading-[1.55]">{item.value}</dd>
                </div>
              ))}
            </dl>
          </>
        )
      }

      {
        town.licenseRequired && town.licenseDetail && (
          <>
            <h2>You need a license</h2>
            <p>{town.licenseDetail}</p>

            {/* "You need a license" without the where and the how much is
                half an answer: it tells someone they have a problem and not
                how to solve it. */}
            {town.license && (
              <div class="sign breakout my-6 not-prose">
                <div class="px-4 sm:px-5 py-4 border-b-2 border-marsh">
                  <p class="label m-0">What it costs</p>
                  <dl class="grid sm:grid-cols-2 gap-x-6 gap-y-0 mt-2.5 mb-0">
                    {town.license.options.map((o) => (
                      <div class="flex items-baseline justify-between gap-3 border-b border-tide/25 py-2">
                        <dt class="text-[0.95rem]">{o.label}</dt>
                        <dd class="m-0 font-display text-[1.05rem] font-semibold text-marsh whitespace-nowrap">{o.price}</dd>
                      </div>
                    ))}
                  </dl>
                </div>

                <div class="px-4 sm:px-5 py-4">
                  <p class="label m-0">Where to get one</p>
                  <ul class="list-none p-0 m-0 mt-2.5 space-y-3">
                    {town.license.where.map((w) => (
                      <li>
                        <p class="m-0 text-[0.98rem] font-medium">
                          {w.url ? <a href={w.url} rel="nofollow">{w.label}</a> : w.label}
                        </p>
                        {w.note && <p class="mt-0.5 mb-0 text-[0.88rem] leading-snug text-ink-soft max-w-[54ch]">{w.note}</p>}
                      </li>
                    ))}
                  </ul>

                  {town.license.needed && (
                    <p class="mt-4 mb-0 text-[0.9rem] leading-snug max-w-[54ch]">
                      <strong>Bring:</strong> {town.license.needed}
                    </p>
                  )}
                  {town.license.note && (
                    <p class="mt-2.5 mb-0 text-[0.9rem] leading-snug text-ink-soft max-w-[54ch]">{town.license.note}</p>
                  )}
                </div>
              </div>
            )}
          </>
        )
      }

      {
        town.correction && (
          <>
            <h2>{town.correction.heading}</h2>
            <p>{town.correction.body}</p>
          </>
        )
      }

      {
        alternatives.length > 0 && (
          <>
            <h2>Where to go instead during the closure</h2>
            <p class="text-[0.95rem] text-ink-soft">
              Most guides answer the summer question with "you can't." These are
              the places where a dog is legal anyway.
            </p>

            <ul class="list-none p-0 m-0 mt-6 space-y-5">
              {alternatives.map((alt, i) => (
                <li class="sign px-4 sm:px-5 py-4 relative">
                  {/* Plate number, the way a field guide indexes its entries. */}
                  <span class="stamp text-ink-soft absolute top-4 right-4 sm:right-5">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <p class="m-0 font-display text-[1.12rem] font-semibold tracking-[-0.012em] pe-8">
                    {alt.href ? <a href={alt.href}>{alt.name}</a> : alt.name}
                  </p>
                  <p class="mt-1.5 mb-0 text-[0.92rem] leading-[1.55] max-w-[54ch]">{alt.detail}</p>
                  {!alt.verified && (
                    <p class="stamp text-ink-soft mt-2.5 mb-0">
                      Not yet first-party verified
                    </p>
                  )}
                </li>
              ))}
            </ul>
          </>
        )
      }

      <p class="mt-6 mb-0">
        <MapLink name={`${town.name} public beach`} town={town.name} label="Open in Google Maps" />
      </p>

      <TownContacts town={town} />

      <VerificationStamp item={town} />

      {
        town.photos && town.photos.length > 1 && (
          <>
            <h2>More photographs</h2>
            {town.photos.slice(1).map((q) => <Photo {...q} />)}
          </>
        )
      }

      <h2>Where it is</h2>
      <MapEmbed name={`${town.name} public beach`} town={town.name} address={null} />

      <ReportBox subject={town.name} path={`/dogs/${town.slug}/`} asks={asks} />

      <h2>The other towns</h2>
      <p class="text-[0.95rem] text-ink-soft">
        No two of these share a set of dates. If your trip crosses more than one,
        check each.
      </p>
      <ul>
        {
          siblings.map((t) => (
            <li>
              <a href={`/dogs/${t.slug}/`}>{t.question}</a>{" "}
              <span class="stamp text-ink-soft">— {summarise(t)}</span>
            </li>
          ))
        }
        <li><a href="/dogs/">All five, side by side</a></li>
        <li><a href="/how-we-verify/">How I check this, and what I do when I'm wrong</a></li>
      </ul>
    </div>
  </article>
</Layout>
