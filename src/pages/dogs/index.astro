---
/**
 * Section hub. In week 4 the date checker mounts here as the one React
 * island; everything above and below it stays static, and the list below is
 * the no-JS fallback the checker must degrade to.
 */
import Layout from "../../layouts/Layout.astro";
import FlagIcon from "../../components/FlagIcon.astro";
import { colorFor } from "../../lib/feature-colors";

import townsData from "../../data/towns.json";
import type { Town } from "../../lib/rules";
import { STATUS_META, formatLongDate, formatRange, ruleFor, statusOn } from "../../lib/rules";
import { isPublishable } from "../../lib/verification";

const towns = (townsData as Town[]).filter(isPublishable);
const drafts = (townsData as Town[]).filter((t) => !isPublishable(t));

const today = new Date();
const asOf = formatLongDate(today);

const chipFor = (flag: string) =>
  ({
    green: "bg-flag-green-bearing text-white",
    yellow: "bg-flag-yellow text-ink",
    red: "bg-flag-red-bearing text-white",
  })[flag]!;

const schema = towns.length
  ? [
      {
        "@context": "https://schema.org",
        "@type": "ItemList",
        name: "Delaware beach towns — dog rules",
        itemListElement: towns.map((t, i) => ({
          "@type": "ListItem",
          position: i + 1,
          name: t.name,
          url: new URL(`/dogs/${t.slug}/`, Astro.site).href,
        })),
      },
    ]
  : [];
---

<Layout
  title="Dog-Friendly Beaches in Delaware — 2026 Rules by Town"
  description="Compare 2026 dog rules for Rehoboth, Dewey, Bethany, Lewes and Fenwick Island. See today's status, summer dates, hours, leash rules and licenses."
  schema={schema}
>
  <div class="wrap pt-10 pb-4">
    <p class="label m-0">Section one</p>
    <h1 class="text-[2.5rem] sm:text-[3.3rem] mt-3.5 mb-0 max-w-[15ch] text-marsh">
      Where your dog is legal on the Delaware coast
    </h1>

    {/*
      The dog, directly under the headline, the same way Alapocas sits under
      the front page's. It's the only photograph on this site that belongs to
      no record — it isn't a place, it's the section's subject — so the alt
      text lives here rather than being looked up.

      Square on a phone, 4:3 above it, cropped low: the frame is a portrait one
      and centring it fills the band with leaf litter.
    */}
    <a href="/dogs/dog-parks/" class="block no-underline group breakout mt-7">
      <figure class="m-0 relative">
        <img
          src="/photos/dogs-header-1400.jpg"
          alt="A black and tan dog lying in fallen leaves in low winter sun, tongue out, an orange rubber ball by its paws."
          width={1400}
          height={1866}
          fetchpriority="high"
          decoding="async"
          style="object-position:50% 30%"
          class="w-full aspect-square sm:aspect-[4/3] object-cover block border-2 border-marsh"
        />
        <figcaption
          class="absolute left-0 right-0 bottom-0 px-3 py-2 stamp text-cream bg-marsh/85 backdrop-blur-[2px] block truncate"
          style={`border-bottom:3px solid ${colorFor("petsAllowed")}`}
        >
          Dog parks and off-leash areas →
        </figcaption>
      </figure>
    </a>

    <p class="mt-6 mb-0 text-[1.1rem] max-w-[58ch]">
      Five towns. Twenty-five miles of coast. And <strong>no two have exactly
      the same rules</strong>.
    </p>

    <p class="mt-3.5 mb-0 text-[1.05rem] leading-[1.55] max-w-[58ch]">
      Fenwick's restrictions begin May 1. Rehoboth and Bethany follow May 15.
      Rehoboth reopens September 16, while Bethany and Fenwick reopen
      October 1. Dewey and Lewes never close at all — they allow dogs right
      through the summer, but only outside the middle of the day.
    </p>

    <p class="mt-3.5 mb-0 text-[1.05rem] leading-[1.55] max-w-[58ch]">
      So there's no single answer to "Are dogs allowed on Delaware beaches?"
      It depends on which beach — and when.
    </p>
    <p class="stamp text-ink-soft mt-4 mb-0">Status shown as of {asOf}</p>
  </div>

  <div class="wrap py-6">
    {
      towns.length > 0 ? (
        <ul class="list-none p-0 m-0 space-y-5">
          {towns.map((town) => {
            const status = statusOn(town, today);
            const meta = STATUS_META[status];
            const beach = ruleFor(town, "beach", today);
            return (
              <li class="sign sign-action">
                <a href={`/dogs/${town.slug}/`} class="no-underline block px-4 py-4 group">
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                    <span
                      class={`${chipFor(meta.flag)} inline-flex items-center gap-1.5 px-2 py-1 rounded-[2px] font-mono text-[0.7rem] font-medium uppercase tracking-[0.08em]`}
                    >
                      <FlagIcon icon={meta.icon} class="w-[1em] h-[1em]" />
                      {meta.word}
                    </span>
                    <span class="font-display text-[1.25rem] font-semibold underline decoration-ochre decoration-[3px] underline-offset-[0.18em] group-hover:decoration-ink">
                      {town.name}
                    </span>
                  </div>
                  {beach && (
                    <p class="mt-2 mb-0 stamp text-ink-soft">
                      Beach: {formatRange(beach)} · {meta.word.toLowerCase()}
                    </p>
                  )}
                </a>
              </li>
            );
          })}
        </ul>
      ) : (
        <div class="sign px-5 py-6">
          <p class="label m-0">Nothing published yet</p>
          <p class="mt-2 mb-0 max-w-[56ch] text-[0.95rem]">
            Town pages appear here once their rules have been confirmed
            first-party. Drafts are deliberately withheld — an unverified page
            is worth less than no page, because being wrong is the one thing
            this site can't be.
          </p>
        </div>
      )
    }

    {
      drafts.length > 0 && (
        <p class="stamp text-ink-soft mt-5 mb-0">
          {drafts.length} town {drafts.length === 1 ? "page" : "pages"} drafted, awaiting confirmation
        </p>
      )
    }
  </div>

  <div class="wrap prose-field pb-4">
    {/* This was headed "Coming in this section" and listed six things as
        forthcoming. Four of them had been live for a while — a page telling
        readers its own content doesn't exist yet, on the same site that makes
        a point of saying what it doesn't know. */}
    <h2>More for dogs</h2>
    <ul>
      <li><a href="/dogs/summer/">Summer</a> — where a dog is actually legal in July</li>
      <li><a href="/dogs/dog-parks/">Dog parks</a> — fenced, size split, water, shade, surface, fee, hours, restrooms</li>
      <li><a href="/dogs/pond-safety/">Pond safety</a> — harmful algal blooms, and the one dog park everyone swims in</li>
      <li><a href="/dogs/pet-fees/">Pet fees</a> — what lodging actually charges, in total, with weight limits</li>
      <li><a href="/parks/">State parks</a> — dog access park by park, and the year-round exception for non-guarded and surf-fishing beaches</li>
      <li><a href="/wineries-and-breweries/">Breweries and wineries</a> — inside, patio, or no published policy</li>
    </ul>

    <h2>Not here yet</h2>
    <p class="text-[0.95rem] text-ink-soft max-w-[60ch]">
      Listed so you know what's missing, instead of discovering it by searching
      for it.
    </p>
    <ul>
      <li>The drive — where to stop, by the city you're coming from</li>
    </ul>
  </div>
</Layout>
