---
/**
 * /changed/ — what changed, and who is still publishing the old answer.
 *
 * Negative-space content: highest intent, no competition, and the thing an
 * assistant is most likely to cite, because a dated correction with a named
 * source is exactly what a model looks for when two pages disagree.
 *
 * Generated from changes.json, so every entry is a view rather than prose and
 * a new one is a data edit.
 *
 * The `whoIsWrong` field is deliberate. Saying "the rule changed" is useful;
 * saying "and the county tourism page still has the old dates" is what makes
 * someone check before they drive. It's stated about publications, never about
 * people, and only where we've actually looked.
 */
import Layout from "../layouts/Layout.astro";
import FlagIcon from "../components/FlagIcon.astro";

import changesData from "../data/changes.json";
import { formatStampDate, formatLongDate } from "../lib/rules";

interface Change {
  date: string;
  section: string;
  entity: string;
  href: string | null;
  type: string;
  headline: string;
  description: string;
  whoIsWrong: string | null;
  source: { label: string; url: string | null };
  sourcedOn: string;
  upcoming?: boolean;
}

const today = new Date();
const all = changesData as Change[];

const upcoming = all.filter((c) => c.upcoming || new Date(c.date) > today).sort((a, b) => a.date.localeCompare(b.date));
const past = all.filter((c) => !(c.upcoming || new Date(c.date) > today)).sort((a, b) => b.date.localeCompare(a.date));

const TYPE_LABEL: Record<string, string> = {
  "rule-change": "Rule change",
  "price-change": "Price change",
  closed: "Closed",
  opened: "Opened",
  moved: "Moved",
  "temporary-closure": "Temporary closure",
  "under-review": "Under review",
};

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "What changed in outdoor Delaware",
    itemListElement: past.map((c, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: c.headline,
    })),
  },
];
---

<Layout
  title="What changed in outdoor Delaware — rules, prices, closures"
  description="Delaware re-cut its dog dates, doubled park fees and dropped most fishing reservations since 2025. Every change, dated, sourced, and who still has it wrong."
  schema={schema}
>
  <div class="wrap pt-11 pb-6">
    <p class="label m-0">Changes</p>
    <h1 class="text-[2.5rem] sm:text-[3.3rem] mt-3.5 mb-0 max-w-[15ch] text-marsh">
      What changed, and who hasn't noticed
    </h1>
    <p class="mt-5 mb-0 text-[1.15rem] leading-[1.5] max-w-[54ch]">
      Delaware re-cut its dog dates, doubled its park fees and dropped most of
      its fishing reservations inside eighteen months. Most of what's published
      still describes the world before that. Here's every change I know about,
      dated and sourced.
    </p>
    <p class="stamp text-ink-soft mt-4 mb-0">Updated {formatLongDate(today)}</p>
  </div>

  {
    upcoming.length > 0 && (
      <div class="wrap pb-4">
        <h2 class="font-display text-[1.5rem] font-bold text-marsh border-b-[3px] border-marsh pb-2 mb-5">
          Coming
        </h2>
        <ul class="list-none p-0 m-0 space-y-5 breakout">
          {upcoming.map((c) => (
            <li class="sign px-4 sm:px-5 py-4 border-l-[9px] border-l-flag-yellow">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                <span class="stamp text-ink-soft">{c.date.slice(0, 4)}</span>
                <span class="label">{TYPE_LABEL[c.type] ?? c.type}</span>
                <span class="stamp text-ink-soft">{c.section}</span>
              </div>
              <p class="font-display text-[1.2rem] font-bold tracking-[-0.018em] mt-2 mb-0 text-marsh max-w-[36ch]">
                {c.href ? <a href={c.href}>{c.headline}</a> : c.headline}
              </p>
              <p class="mt-2.5 mb-0 text-[0.94rem] leading-[1.55] max-w-[58ch]">{c.description}</p>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <div class="wrap pb-6">
    <h2 class="font-display text-[1.5rem] font-bold text-marsh border-b-[3px] border-marsh pb-2 mb-5 mt-8">
      Already happened
    </h2>

    <ul class="list-none p-0 m-0 space-y-5 breakout">
      {
        past.map((c) => (
          <li class="sign px-4 sm:px-5 py-4">
            <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
              <span class="stamp text-ink">{formatStampDate(c.date)}</span>
              <span class="label">{TYPE_LABEL[c.type] ?? c.type}</span>
              <span class="stamp text-ink-soft">{c.section}</span>
            </div>

            <p class="font-display text-[1.2rem] font-bold tracking-[-0.018em] mt-2 mb-0 text-marsh max-w-[36ch]">
              {c.href ? <a href={c.href}>{c.headline}</a> : c.headline}
            </p>

            <p class="mt-2.5 mb-0 text-[0.94rem] leading-[1.55] max-w-[58ch]">{c.description}</p>

            {c.whoIsWrong && (
              <p class="mt-3 mb-0 text-[0.88rem] leading-snug flex gap-2 max-w-[58ch]">
                <FlagIcon icon="alert" class="w-[1em] h-[1em] mt-1 shrink-0 text-flag-red" />
                <span>
                  <strong>Still published wrong:</strong> {c.whoIsWrong}
                </span>
              </p>
            )}

            <p class="stamp text-ink-soft mt-3 mb-0">
              {c.source.url ? (
                <a href={c.source.url} rel="nofollow">{c.source.label}</a>
              ) : (
                c.source.label
              )}
              {" · read "}{formatStampDate(c.sourcedOn)}
            </p>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="wrap prose-field pb-4">
    <h2>Why this page exists</h2>
    <p class="max-w-[58ch]">
      Because a rule that changed quietly is worse than one that never existed.
      Nobody re-checks a page they wrote three years ago, so the old answer
      keeps ranking and keeps sending people to a closed beach or a shut
      brewery. Listing the changes with dates and sources is cheap for us and
      genuinely hard to find anywhere else.
    </p>
    <p class="max-w-[58ch]">
      Know of one I've missed?
      <a href="/about/#corrections">Tell me</a>.
    </p>

    <h2>Related</h2>
    <ul>
      <li><a href="/verified/">Every fact on the site, with its source and age</a></li>
      <li><a href="/about/">How I check things</a></li>
    </ul>
  </div>
</Layout>
