---
/**
 * Home, as the poster and the notice board.
 *
 * Nobody lands here — they land on an answer page from a search. So this page
 * has one job: make the shape of the site legible in three seconds. Two
 * placards, one posted and one plainly not, say "ten sections, one at a time,
 * and we don't pretend the empty ones exist" better than a paragraph can.
 */
import Layout from "../layouts/Layout.astro";
import CoastBand from "../components/CoastBand.astro";
import FlagMark from "../components/FlagMark.astro";
import DogFigure from "../components/DogFigure.astro";

import townsData from "../data/towns.json";
import type { Town } from "../lib/rules";
import { isVerified } from "../lib/verification";

const towns = townsData as Town[];
const live = towns.filter(isVerified);
const drafted = towns.length - live.length;

const contents = [
  "Beach and boardwalk rules, by town",
  "State parks, and the year-round exception",
  "Where a dog is legal in July",
  "Pet fees, in total, with weight limits",
  "Dog parks — fenced, water, shade, surface",
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Delaware Field Guide",
    url: "https://delawarefieldguide.com/",
    description:
      "A reference for outdoor Delaware. Every fact carries the date it was checked and the source it came from.",
    publisher: { "@type": "Organization", name: "Delaware Field Guide" },
  },
];
---

<Layout
  title="Delaware Field Guide — outdoor Delaware, verified and dated"
  description="A reference for outdoor Delaware, starting with where your dog is legal, on what dates, and what it costs. Every fact carries the date it was checked and its source."
  schema={schema}
>
  <CoastBand />

  <div class="wrap pt-9 pb-9">
    <p class="label m-0 flex items-center gap-2">
      <FlagMark class="w-[0.5rem] h-[0.62rem] shrink-0 text-ochre-deep" />
      A reference for outdoor Delaware
    </p>

    <h1 class="text-[2.7rem] sm:text-[3.9rem] mt-3.5 mb-0 max-w-[14ch] text-marsh">
      Outdoor Delaware, checked and dated.
    </h1>

    <p class="mt-6 mb-0 text-[1.2rem] leading-[1.5] max-w-[52ch]">
      A reference for the Delaware coast and the parks inland. Every rule here
      carries the date we last confirmed it and the name of whoever told us —
      because the published answer is wrong more often than you'd think.
    </p>
  </div>

  <div class="wrap pb-10 grid gap-6 sm:gap-5 sm:grid-cols-2">
    <a href="/dogs/" class="sign sign-action no-underline block p-5 sm:p-6 group relative">
      <span class="stamp text-ochre-deep absolute top-5 right-5">01</span>

      <p class="label m-0 flex items-center gap-2 text-tide">
        <FlagMark class="w-[0.5rem] h-[0.62rem] shrink-0" />
        Posted
      </p>

      <div class="flex items-end justify-between gap-3">
        <p
          class="font-display text-[2.1rem] font-bold mt-2 mb-0 tracking-[-0.03em] text-marsh underline decoration-ochre decoration-[3px] underline-offset-[0.14em] group-hover:decoration-marsh"
        >
          Dogs
        </p>
        <DogFigure pose="sit" class="w-[4.4rem] h-auto text-marsh shrink-0" />
      </div>

      <p class="mt-2.5 mb-0 text-[0.95rem] leading-[1.5]">
        Where your dog is legal, on what date, and what it costs.
      </p>

      <ul class="list-none p-0 mt-4 mb-0 border-t-2 border-marsh">
        {
          contents.map((item) => (
            <li class="text-[0.86rem] leading-snug py-2 border-b border-tide/35 text-ink-soft">
              {item}
            </li>
          ))
        }
      </ul>

      <p class="stamp text-ink-soft mt-4 mb-0">
        {live.length} published{drafted > 0 ? ` · ${drafted} awaiting confirmation` : ""}
      </p>
    </a>

    {/* Plainly not yet. An empty placard is more honest than a promise. */}
    <div class="border-2 border-dashed border-tide rounded-[2px] p-5 sm:p-6 relative">
      <span class="stamp text-ochre-deep absolute top-5 right-5">02</span>

      <p class="label m-0 text-tide">Not yet posted</p>

      <p class="font-display text-[2.1rem] font-bold mt-2 mb-0 tracking-[-0.03em] text-tide">
        Surf fishing
      </p>

      <p class="mt-2.5 mb-0 text-[0.95rem] leading-[1.5] text-ink-soft max-w-[38ch]">
        Permits, seasons, and the drive-on beaches. Same coast and same
        off-season as the dog section, and it shares the non-guarded-beach rules
        that section already had to get right.
      </p>

      <p class="stamp text-ink-soft mt-4 mb-0">Eight more sections behind it</p>
    </div>
  </div>

  <div class="wrap prose-field pb-6">
    <h2>Why the dates matter more than the writing</h2>
    <p class="max-w-[58ch]">
      Rehoboth Beach moved its seasonal dog dates in January 2026. Most guides
      you'll find still print the old ones, which means they'll tell you the
      beach is closed to dogs when it isn't, and open when it isn't. Nobody
      re-checks, because nobody wrote down where the fact came from in the first
      place. <a href="/how-we-verify/">That's the thing this site does differently</a>,
      and it's enforced by the build rather than by good intentions — a page we
      haven't confirmed can't publish itself.
    </p>
  </div>
</Layout>
