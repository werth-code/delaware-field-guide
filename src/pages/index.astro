---
/**
 * Home.
 *
 * Orients someone who has never heard of the site, then points at the three
 * live collections. Section counts are derived from the data so they can't
 * drift, and each card says how much of it is confirmed rather than implying
 * it's all done.
 */
import Layout from "../layouts/Layout.astro";
import CoastBand from "../components/CoastBand.astro";
import FlagMark from "../components/FlagMark.astro";
import DogFigure from "../components/DogFigure.astro";

import townsData from "../data/towns.json";
import stateParksData from "../data/state-parks.json";
import communityParksData from "../data/community-parks.json";
import dogParksData from "../data/parks.json";
import surfData from "../data/surf-fishing.json";
import { isVerified } from "../lib/verification";

const towns = townsData as { slug: string; name: string; verifiedDate: string | null; verifiedSource: string | null }[];
const stateParks = stateParksData as { county: string; verifiedDate: string | null; verifiedSource: string | null }[];
const communityParks = communityParksData as { county: string; verifiedDate: string | null; verifiedSource: string | null }[];
const dogParks = dogParksData as { verifiedDate: string | null; verifiedSource: string | null }[];

const count = (rows: { verifiedDate: string | null; verifiedSource: string | null }[]) => ({
  total: rows.length,
  live: rows.filter(isVerified).length,
});

const sections = [
  {
    href: "/dogs/",
    n: "01",
    title: "Dogs",
    lede: "Where your dog is legal, on what date, and what it costs.",
    detail:
      "Five beach towns with five different sets of dates, the summer beaches that never close, pet fees, and every dog park on seven fields.",
    contents: [
      "Beach and boardwalk rules, by town",
      "Where a dog is legal in July",
      "Dog parks — fenced, water, shade, surface",
      "Pet fees, weight limits, dog counts",
      "Blue-green algae and pond safety",
    ],
    ...count(towns),
    unit: "town pages",
    figure: true,
  },
  {
    href: "/parks/",
    n: "02",
    title: "State parks",
    lede: "All 17, what's actually at each one, and the 2026 fees.",
    detail:
      "From Cape Henlopen's 5,451 acres to a Civil War fort you can only reach by ferry. Camping, trails, surf fishing, and where dogs are allowed.",
    contents: [
      "Facilities, park by park",
      "2026 entry fees — the beach parks doubled",
      "Camping, cabins and trails",
      "Dog rules per park",
    ],
    ...count(stateParks),
    unit: "parks",
    figure: false,
  },
  {
    href: "/parks/community/",
    n: "03",
    title: "Community parks",
    lede: "County and town parks. Starting with: are there restrooms?",
    detail:
      "The questions you ask before loading the car — toilets, playground, drinking water, shade, and whether the dog can come.",
    contents: [
      "Restrooms — permanent, portable or seasonal",
      "Playgrounds and accessibility",
      "Water, shade and pavilions",
      "Which ones contain a dog park",
    ],
    ...count(communityParks),
    unit: "parks",
    figure: false,
  },
  {
    href: "/surf-fishing/",
    n: "04",
    title: "Surf fishing",
    lede: "Five of the twelve crossings need a reservation. Not seven.",
    detail:
      "Drive-on access, permits, licences, and the after-4pm rule that lets annual permit holders skip reservations entirely.",
    contents: [
      "Which crossings need a reservation",
      "Permit tiers and the 3-week delivery",
      "The licence exemption that covers only you",
      "The off-peak permit ending in 2027",
      "Walk-on access — free, no permit",
    ],
    total: surfData.crossings.length,
    live: 0,
    unit: "crossings",
    figure: false,
  },
];

const facts = [
  { n: "3", label: "counties" },
  { n: String(stateParks.length), label: "state parks" },
  { n: String(towns.length), label: "beach towns" },
  { n: String(dogParks.length + communityParks.length), label: "local parks" },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Delaware Field Guide",
    url: "https://delawarefieldguide.com/",
    description:
      "A reference for outdoor Delaware. Every fact carries the date it was checked and the source it came from.",
    publisher: { "@type": "Organization", name: "Delaware Field Guide" },
  },
];
---

<Layout
  title="Delaware Field Guide — parks and dog rules, verified"
  description="A reference for outdoor Delaware: dog rules by town, all 17 state parks, and the county parks. Every fact carries the date we checked it and who told us."
  schema={schema}
  share={false}
>
  <CoastBand />

  <div class="wrap pt-9 pb-8">
    <p class="label m-0 flex items-center gap-2">
      <FlagMark class="w-[0.5rem] h-[0.62rem] shrink-0 text-ochre-deep" />
      A reference for outdoor Delaware
    </p>

    <h1 class="text-[2.7rem] sm:text-[3.9rem] mt-3.5 mb-0 max-w-[14ch] text-marsh">
      Outdoor Delaware, checked and dated.
    </h1>

    <p class="mt-6 mb-0 text-[1.2rem] leading-[1.5] max-w-[54ch]">
      You can cross Delaware in two hours and still spend a decade finding
      everything in it. Twenty-five miles of Atlantic coast, seventeen state
      parks, bald cypress swamps in the south and creek valleys in the north —
      and a bay that hosts the largest horseshoe crab spawning on earth.
    </p>

    <p class="mt-4 mb-0 text-[1.05rem] leading-[1.55] max-w-[54ch]">
      This is the guide that tells you what's actually there today: which beach
      your dog can walk on this week, what a park costs this season, and whether
      there's a toilet when you arrive. Every fact carries the date we confirmed
      it and who told us. <a href="/how-we-verify/">Here's how that works</a>.
    </p>
  </div>

  {/* Orientation for someone who has never been. */}
  <div class="wrap pb-9">
    <dl class="sign breakout grid grid-cols-2 sm:grid-cols-4 gap-0 divide-x-2 divide-y-2 sm:divide-y-0 divide-tide/30">
      {
        facts.map((f) => (
          <div class="px-4 py-4">
            <dt class="font-display text-[2.1rem] font-bold text-marsh leading-none">{f.n}</dt>
            <dd class="m-0 mt-1.5 stamp text-ink-soft">{f.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="wrap">
    <div class="border-t-[3px] border-t-marsh"></div>
    <div class="border-t border-t-tide mt-[3px]"></div>
  </div>

  <div class="wrap py-9 grid gap-6 sm:gap-5 sm:grid-cols-2">
    {
      sections.map((s) => (
        <a href={s.href} class="sign sign-action no-underline block p-5 group relative">
          <span class="stamp text-ochre-deep absolute top-5 right-5">{s.n}</span>

          <p class="label m-0 flex items-center gap-2">
            <FlagMark class="w-[0.5rem] h-[0.62rem] shrink-0" />
            Section {s.n}
          </p>

          <div class="flex items-end justify-between gap-3">
            <p class="font-display text-[1.85rem] font-bold mt-2 mb-0 tracking-[-0.03em] text-marsh underline decoration-ochre decoration-[3px] underline-offset-[0.14em] group-hover:decoration-marsh">
              {s.title}
            </p>
            {s.figure && <DogFigure pose="sit" class="w-[3.4rem] h-auto text-marsh shrink-0" />}
          </div>

          <p class="mt-2.5 mb-0 text-[0.98rem] leading-[1.45] font-medium">{s.lede}</p>
          <p class="mt-2 mb-0 text-[0.9rem] leading-[1.5] text-ink-soft">{s.detail}</p>

          <ul class="list-none p-0 mt-4 mb-0 border-t-2 border-marsh">
            {s.contents.map((item) => (
              <li class="text-[0.84rem] leading-snug py-1.5 border-b border-tide/35 text-ink-soft">
                {item}
              </li>
            ))}
          </ul>

          <p class="stamp text-ink-soft mt-4 mb-0">
            {s.live} of {s.total} {s.unit} confirmed
          </p>
        </a>
      ))
    }
  </div>

  <div class="wrap prose-field pb-6">
    <h2>Every fact here is dated</h2>
    <p class="max-w-[58ch]">
      Delaware changes its rules more often than you'd expect. Rehoboth gave
      dogs two extra weeks of beach in January. The state parks reset their fees
      in March. Good news travels slowly, so we go and ask — the city, the park,
      the property — and then we write down the date and who said it.
    </p>
    <p class="max-w-[58ch]">
      It means you can see exactly how fresh an answer is before you drive
      anywhere. And a page we haven't confirmed first-hand simply doesn't
      publish itself: no stamp, no listing, no search.
      <a href="/how-we-verify/">That's built into the site</a>, so what you're
      reading has always been checked by a person.
    </p>

    <h2>Still to come</h2>
    <p class="max-w-[58ch]">
      Crabbing, the trails, and Delaware's 48 breweries and wineries are next.
      One section at a time, each one checked before it goes up.
    </p>
  </div>
</Layout>
