---
/**
 * Home.
 *
 * Orients someone who has never heard of the site, then points at the three
 * live collections. Section counts are derived from the data so they can't
 * drift, and each card says how much of it is confirmed rather than implying
 * it's all done.
 */
import Layout from "../layouts/Layout.astro";
import CoastBand from "../components/CoastBand.astro";
import StateMap from "../components/StateMap.astro";
import FlagMark from "../components/FlagMark.astro";
import DogFigure from "../components/DogFigure.astro";

import townsData from "../data/towns.json";
import stateParksData from "../data/state-parks.json";
import communityParksData from "../data/community-parks.json";
import dogParksData from "../data/parks.json";
import surfData from "../data/surf-fishing.json";
import indoorData from "../data/indoor.json";
import drinkData from "../data/drink.json";
import eventsData from "../data/events.json";
import nearbyData from "../data/nearby.json";
import { isPublishable } from "../lib/verification";
import { colorFor, COUNTY_COLOR } from "../lib/feature-colors";
import FeatureIcon from "../components/FeatureIcon.astro";

const towns = townsData as { slug: string; name: string; verifiedDate: string | null; verifiedSource: string | null }[];
const stateParks = stateParksData as { county: string; verifiedDate: string | null; verifiedSource: string | null }[];
const communityParks = communityParksData as { county: string; verifiedDate: string | null; verifiedSource: string | null }[];
const dogParks = dogParksData as { verifiedDate: string | null; verifiedSource: string | null }[];

type Row = { verifiedDate: string | null; verifiedSource: string | null };
const indoorAll = indoorData as unknown as (Row & { kind: string })[];
const indoors = indoorAll.filter((r) => r.kind !== "Zoo");
const attractions = indoorAll.filter((r) => r.kind === "Zoo");
const drink = drinkData as unknown as Row[];
const events = eventsData as unknown as Row[];
const nearby = nearbyData as unknown as Row[];
const discGolf = [
  ...(stateParksData as unknown as (Row & { features: { discGolf: boolean | null } })[]).filter((p) => p.features.discGolf === true),
  ...(communityParksData as unknown as (Row & { facilities: { discGolf: boolean | null } })[]).filter((p) => p.facilities.discGolf === true),
];

const count = (rows: { verifiedDate: string | null; verifiedSource: string | null }[]) => ({
  total: rows.length,
  live: rows.filter(isPublishable).length,
});

const sections = [
  {
    href: "/dogs/",
    n: "01",
    title: "Dogs",
    lede: "Where your dog is legal, on what date, and what it costs.",
    detail:
      "Five beach towns with five different sets of dates, the summer beaches that never close, pet fees, and every dog park on seven fields.",
    contents: [
      "Beach and boardwalk rules, by town",
      "Where a dog is legal in July",
      "Dog parks: fenced, water, shade, surface",
      "Pet fees, weight limits, dog counts",
      "Blue-green algae and pond safety",
    ],
    ...count(towns),
    unit: "town pages",
    figure: true,
  },
  {
    href: "/parks/",
    n: "02",
    title: "State parks",
    lede: "All 17, what's actually at each one, and the 2026 fees.",
    detail:
      "From Cape Henlopen's 5,451 acres to a Civil War fort you can only reach by ferry. Camping, trails, surf fishing, and where dogs are allowed.",
    contents: [
      "Facilities, park by park",
      "2026 entry fees, and why the beach parks doubled",
      "Camping, cabins and trails",
      "Dog rules per park",
    ],
    ...count(stateParks),
    unit: "parks",
    figure: false,
  },
  {
    href: "/parks/community/",
    n: "03",
    title: "Community parks",
    lede: "The local ones. Is there a toilet, and is it open?",
    detail:
      "What you want to know before loading the car. Toilets, playground, drinking water, shade, and whether the dog can come.",
    contents: [
      "Restrooms: permanent, portable or seasonal",
      "Playgrounds and accessibility",
      "Water, shade and pavilions",
      "Which ones contain a dog park",
    ],
    ...count(communityParks),
    unit: "parks",
    figure: false,
  },
  {
    href: "/surf-fishing/",
    n: "04",
    title: "Surf fishing",
    lede: "Five of the twelve crossings need a reservation. Not seven.",
    detail:
      "Drive-on access, permits, licenses, and the after-4pm rule that lets annual permit holders skip reservations entirely.",
    contents: [
      "Which crossings need a reservation",
      "Permit tiers and the 3-week delivery",
      "The license exemption that covers only you",
      "The off-peak permit ending in 2027",
      "Walk-on access, free, no permit",
    ],
    total: surfData.crossings.length,
    live: 0,
    unit: "crossings",
    figure: false,
  },
  {
    href: "/indoors/",
    n: "05",
    title: "Indoors",
    lede: "Museums, science centers and libraries — for when it rains.",
    detail:
      "Hagley, Winterthur, the Biggs, the state's natural history museum, and fifteen library branches. Hours lead every card, because most of these shut two or three days a week.",
    contents: [
      "Opening hours, checked against the operator",
      "What admission actually costs",
      "Which are shut for building work right now",
      "Fifteen library branches in one table",
    ],
    ...count(indoors),
    unit: "places",
    figure: false,
  },
  {
    href: "/wineries-and-breweries/",
    n: "06",
    title: "Wine and beer",
    lede: "Which wineries and breweries actually allow dogs.",
    detail:
      "Every guide calls these dog friendly. Almost none of them asked the business. This page prints the policy only where the winery or brewery publishes one itself.",
    contents: [
      "The dog answer, from the operator or not at all",
      "Hours and tasting fees",
      "Which publish no policy at all",
    ],
    ...count(drink),
    unit: "listed",
    figure: false,
  },
  {
    href: "/disc-golf/",
    n: "07",
    title: "Disc golf",
    lede: "Nine courses. The round is free; the gate isn't.",
    detail:
      "Seven in state parks and two in county parks. Playing costs nothing anywhere — seven of the nine sit behind a park entrance fee, and that is the number worth knowing.",
    contents: [
      "Every course in a public park",
      "What entry costs at each",
      "Which two are free to walk into",
    ],
    total: discGolf.length,
    live: discGolf.filter(isPublishable).length,
    unit: "courses",
    figure: false,
  },
  {
    href: "/events/",
    n: "08",
    title: "Events",
    lede: "Annual fairs and festivals, with dates worked out rather than guessed.",
    detail:
      "The fixtures, with the year I have actually confirmed. Where next year's dates are not published, this says so instead of computing one that might be wrong.",
    contents: [
      "Confirmed dates, per year",
      "What is on right now",
      "Which publish no recurring rule",
    ],
    ...count(events),
    unit: "events",
    figure: false,
  },
  {
    href: "/attractions/",
    n: "09",
    title: "Places to go",
    lede: "Days out that aren't parks. You pay in, they shut at a time.",
    detail:
      "Ticketed days out with the hours and the price up front. Mostly outdoors, so check the forecast before you drive.",
    contents: [
      "Hours and admission",
      "Free winter days where they apply",
    ],
    ...count(attractions),
    unit: "listed",
    figure: false,
  },
  {
    href: "/nearby/",
    n: "10",
    title: "Just over the line",
    lede: "Worth the drive, and not in Delaware.",
    detail:
      "The state is forty miles wide. Half of New Castle County lives closer to somewhere in Maryland or Pennsylvania than to Sussex, and every record here says plainly that it is out of state.",
    contents: [
      "Clearly marked as out of state",
      "Same sourcing as everything else",
    ],
    ...count(nearby),
    unit: "listed",
    figure: false,
  },
];

const facts = [
  { n: String(stateParks.length), label: "state parks" },
  { n: String(dogParks.length + communityParks.length), label: "local parks" },
  { n: String(towns.length), label: "beach towns" },
  { n: String(indoors.length + drink.length + attractions.length), label: "museums, bars, days out" },
];

/* Everything with coordinates, on one map. Kinds are the section a record
   belongs to, so the filters read the way the nav does. */
type Geo = {
  slug: string; name: string; town?: string; county?: string; kind?: string;
  blurb?: string; answer?: string; photos?: { file: string; focus?: string | null }[];
  coords?: { lat: number; lon: number; precision: "site" | "town" };
};
/* One line each, trimmed at a sentence so the card stays a card. */
const oneLine = (t: string | undefined) => {
  if (!t) return "";
  const stop = t.indexOf(". ");
  const line = stop > 40 ? t.slice(0, stop + 1) : t;
  return line.length > 160 ? line.slice(0, 157).trimEnd() + "…" : line;
};
const pin = (rows: unknown[], kind: string, href: (r: any) => string) =>
  (rows as Geo[])
    .filter((r) => r.coords)
    .map((r) => ({
      slug: r.slug, name: r.name, href: href(r), kind,
      lat: r.coords!.lat, lon: r.coords!.lon, precision: r.coords!.precision,
      blurb: oneLine(r.blurb ?? r.answer),
      where: [r.town, r.county ? `${r.county} County` : null].filter(Boolean).join(", "),
      photo: r.photos?.[0]?.file ?? null,
      focus: r.photos?.[0]?.focus ?? null,
      county: r.county ?? "",
    }));

const mapPoints = [
  ...pin(stateParksData as unknown[], "trails", (r) => `/parks/${r.slug}/`),
  ...pin(communityParksData as unknown[], "playground", (r) => `/parks/community/${r.slug}/`),
  ...pin(indoorAll.filter((r) => r.kind !== "Zoo") as unknown[], "free", (r) => `/indoors/${r.slug}/`),
  ...pin(indoorAll.filter((r) => r.kind === "Zoo") as unknown[], "petsAllowed", (r) => `/attractions/${r.slug}/`),
  ...pin(drinkData as unknown[], "giftShop", (r) => `/wineries-and-breweries/${r.slug}/`),
  ...pin(townsData as unknown[], "beach", (r) => `/dogs/${r.slug}/`),
];

/*
 * The questions people actually turn up with, each one a real query against
 * the real index. They are questions, not section names: "somewhere dry when
 * it rains" is what someone thinks, "/indoors/" is where we happen to file it.
 */
const heroAsks: { q: string; key: string }[] = [
  { q: "Can the dog come to the beach?", key: "petsAllowed" },
  { q: "Somewhere dry when it rains", key: "free" },
  { q: "A playground with restrooms", key: "playground" },
  { q: "A fenced dog park near me", key: "dogPark" },
  { q: "Free beach with parking", key: "beach" },
  { q: "Somewhere shady to walk", key: "shade" },
];

/* North to south, the way you'd drive it. */
const mapCounties = ["New Castle", "Kent", "Sussex"].map((c) => ({
  key: c,
  label: c,
  color: COUNTY_COLOR[c],
}));

const mapKinds = [
  { key: "trails", label: "State parks", color: colorFor("trails") },
  { key: "playground", label: "Community parks", color: colorFor("playground") },
  { key: "beach", label: "Dog beaches", color: colorFor("beach") },
  { key: "free", label: "Museums & libraries", color: colorFor("free") },
  { key: "giftShop", label: "Wine & beer", color: colorFor("giftShop") },
  { key: "petsAllowed", label: "Places to go", color: colorFor("petsAllowed") },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Delaware Field Guide",
    url: "https://delawarefieldguide.com/",
    description:
      "A reference for outdoor Delaware. Every fact carries the date it was checked and the source it came from.",
    publisher: { "@type": "Organization", name: "Delaware Field Guide" },
  },
];
---

<Layout
  title="Delaware Field Guide — parks, beaches and dog rules, dated"
  description="A verified reference for outdoor Delaware: 17 state parks, dog rules by town, museums, disc golf, breweries and surf fishing. Every fact carries the date it was checked."
  schema={schema}
  share={false}
>
  <CoastBand />

  {/*
    A FRONT DOOR, NOT AN ESSAY.
    This opened with four paragraphs — what the site covers, why it exists,
    what other guides get wrong — before offering anywhere to go. All of it is
    true and none of it is what someone arrives for. The argument now lives on
    /how-we-verify/, which is where a reader who wants it goes looking.
  */}
  {/*
    THE HERO SELLS THE JOB, NOT THE METHOD.

    It read "Delaware, checked and dated", which is a property of the site
    rather than anything it does for you — and the paragraph under it listed
    sections, which is the navigation saying itself out loud. Neither told a
    stranger why they'd want this.

    So it leads with the question people actually arrive with, and then it
    DEMONSTRATES rather than describes: every example below is a live question
    that runs the finder on the real data. Nothing sells a checked dataset like
    watching it answer.
  */}
  <div class="wrap pt-9 pb-8">
    <p class="label m-0 flex items-center gap-2">
      <FlagMark class="w-[0.5rem] h-[0.62rem] shrink-0 text-ochre-deep" />
      A reference for outdoor Delaware
    </p>

    <h1 class="text-[2.7rem] sm:text-[3.6rem] mt-3.5 mb-0 max-w-[15ch] text-marsh">
      Find the right place in Delaware
    </h1>

    <p class="mt-6 mb-0 text-[1.2rem] leading-[1.5] max-w-[52ch]">
      Somewhere to take the dog. Somewhere dry when it rains. A park that
      actually has restrooms, a beach the dog is allowed on this month, a
      brewery that won't turn you away at the gate.
    </p>

    <p class="mt-4 mb-0 text-[1.05rem] leading-[1.55] max-w-[52ch]">
      Every answer here carries the date it was checked and who said so. Where
      nobody has checked, it says that instead of guessing — which is the whole
      reason this exists.
    </p>

    <p class="label mt-8 mb-0">Try one of these</p>
    <ul class="list-none p-0 m-0 mt-2.5 flex flex-wrap gap-1.5">
      {
        heroAsks.map((a) => (
          <li>
            <a
              href={`/ask/?q=${encodeURIComponent(a.q)}`}
              style={`--fc:${colorFor(a.key)}`}
              class="example-chip tap inline-flex items-center gap-1.5 px-3 py-2 no-underline text-[0.85rem] leading-none border-2 rounded-[var(--radius-sign)] bg-shell"
            >
              <FeatureIcon icon={a.key as any} class="w-[1.15em] h-[1.15em] shrink-0" />
              {a.q}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-7 flex flex-wrap gap-3">
      <a
        href="/ask/"
        class="tap no-underline bg-marsh text-cream border-2 border-marsh px-5 py-3 font-mono text-[0.78rem] uppercase tracking-[0.1em] font-medium"
      >
        Ask it anything →
      </a>
      <a
        href="/parks/"
        class="tap no-underline sign-quiet border-2 border-marsh text-marsh px-5 py-3 font-mono text-[0.78rem] uppercase tracking-[0.1em] font-medium"
      >
        The 17 state parks
      </a>
    </div>
  </div>

  {/* Orientation for someone who has never been. */}
  <div class="wrap pb-9">
    <dl class="sign breakout grid grid-cols-2 sm:grid-cols-4 gap-0 divide-x-2 divide-y-2 sm:divide-y-0 divide-tide/30">
      {
        facts.map((f) => (
          <div class="px-4 py-4">
            <dt class="font-display text-[2.1rem] font-bold text-marsh leading-none">{f.n}</dt>
            <dd class="m-0 mt-1.5 stamp text-ink-soft">{f.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="wrap pb-9">
    <StateMap
      points={mapPoints}
      kinds={mapKinds}
      counties={mapCounties}
      startWith={["New Castle"]}
    />
  </div>

  <div class="wrap">
    <div class="border-t-[3px] border-t-marsh"></div>
    <div class="border-t border-t-tide mt-[3px]"></div>
  </div>

  <div class="wrap py-9 grid gap-6 sm:gap-5 sm:grid-cols-2">
    {
      sections.map((s) => (
        <a href={s.href} class="sign sign-action no-underline block p-5 group relative">
          <span class="stamp text-ochre-deep absolute top-5 right-5">{s.n}</span>

          <p class="label m-0 flex items-center gap-2">
            <FlagMark class="w-[0.5rem] h-[0.62rem] shrink-0" />
            Section {s.n}
          </p>

          <div class="flex items-end justify-between gap-3">
            <p class="font-display text-[1.85rem] font-bold mt-2 mb-0 tracking-[-0.03em] text-marsh underline decoration-ochre decoration-[3px] underline-offset-[0.14em] group-hover:decoration-marsh">
              {s.title}
            </p>
            {s.figure && <DogFigure pose="dog" collar class="w-[3.1rem] h-[3.1rem] text-marsh shrink-0" />}
          </div>

          <p class="mt-2.5 mb-0 text-[0.98rem] leading-[1.45] font-medium">{s.lede}</p>
          <p class="mt-2 mb-0 text-[0.9rem] leading-[1.5] text-ink-soft">{s.detail}</p>

          <ul class="list-none p-0 mt-4 mb-0 border-t-2 border-marsh">
            {s.contents.map((item) => (
              <li class="text-[0.84rem] leading-snug py-1.5 border-b border-tide/35 text-ink-soft">
                {item}
              </li>
            ))}
          </ul>

          {/* "published", not "confirmed". This counts isPublishable, which
              is confirmed OR sourced — and on a site whose whole point is that
              those are different claims, calling a sourced record confirmed on
              the front page is the exact overclaim it exists to avoid. */}
          <p class="stamp text-ink-soft mt-4 mb-0">
            {s.live} of {s.total} {s.unit} published
          </p>
        </a>
      ))
    }
  </div>

  <div class="wrap prose-field pb-6">
    <h2>Two things changed this year and nobody noticed</h2>
    <p class="max-w-[58ch]">
      Rehoboth gave dogs two extra weeks of beach back in January. State park
      entry fees roughly doubled in March. Both got published properly. Neither
      one made it into the guides people actually read.
    </p>

    <p class="max-w-[58ch]">
      Which is most of the reason this exists.
    </p>
    <p class="max-w-[58ch]">
      So every answer carries the date I got it and the name of whoever gave it
      to me. You can see how old a fact is before you drive an hour on it.
    </p>

    <h2>What I haven't done yet</h2>
    <p class="max-w-[58ch]">
      Crabbing. The trails. The 48 breweries and wineries, which is a much
      bigger job than it sounds. I'd rather say so than have you go hunting for
      a page that isn't there.
    </p>
  </div>
</Layout>

<style>
  /* --fc rather than `color`, so hover can fill with the hue and still set a
     readable label. `background: currentColor` paints the chip the colour of
     its own text. */
  .example-chip {
    color: var(--fc);
    border-color: var(--fc);
    transition: background-color 110ms ease, color 110ms ease;
  }
  .example-chip:hover,
  .example-chip:focus-visible {
    background: var(--fc);
    color: var(--color-shell);
  }
</style>
