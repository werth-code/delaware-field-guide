---
/**
 * Home.
 *
 * Orients someone who has never heard of the site, then points at the three
 * live collections. Section counts are derived from the data so they can't
 * drift, and each card says how much of it is confirmed rather than implying
 * it's all done.
 */
import Layout from "../layouts/Layout.astro";
import CoastBand from "../components/CoastBand.astro";
import ShareRow from "../components/ShareRow.astro";
import FlagMark from "../components/FlagMark.astro";
import FeatureIcon from "../components/FeatureIcon.astro";
import DogFigure from "../components/DogFigure.astro";
import { sectionBySlug } from "../lib/sections";

import townsData from "../data/towns.json";
import stateParksData from "../data/state-parks.json";
import communityParksData from "../data/community-parks.json";
import dogParksData from "../data/parks.json";
import surfData from "../data/surf-fishing.json";
import indoorData from "../data/indoor.json";
import drinkData from "../data/drink.json";
import eventsData from "../data/events.json";
import nearbyData from "../data/nearby.json";
import { isPublishable } from "../lib/verification";
import type { StatePark } from "../lib/state-parks";
import { colorFor } from "../lib/feature-colors";

const towns = townsData as { slug: string; name: string; verifiedDate: string | null; verifiedSource: string | null }[];
const stateParks = stateParksData as { county: string; verifiedDate: string | null; verifiedSource: string | null }[];

/**
 * THE PICTURE UNDER THE HEADLINE.
 *
 * The front page said "find the right place in Delaware" and then showed you
 * nothing but type, on a site about going outside.
 *
 * Which photograph is chosen is named here rather than flagged in the data,
 * because "the best picture on the site" is an editorial call about this page
 * and not a fact about the park. Everything printed with it — the alt text,
 * the park's name, the credit — is read out of the record, so correcting the
 * park corrects the front door in the same edit. If the file is ever renamed
 * or the record drops below publishable, this resolves to null and the hero
 * disappears rather than shipping a broken image.
 */
const HERO_PHOTO = { slug: "alapocas-run", file: "alapocas-run-greenway" };
const heroPark = (stateParksData as unknown as StatePark[]).find(
  (p) => p.slug === HERO_PHOTO.slug && isPublishable(p),
);
const heroPhoto = heroPark?.photos?.find((p) => p.file === HERO_PHOTO.file) ?? null;
const communityParks = communityParksData as { county: string; verifiedDate: string | null; verifiedSource: string | null }[];
const dogParks = dogParksData as { verifiedDate: string | null; verifiedSource: string | null }[];

type Row = { verifiedDate: string | null; verifiedSource: string | null };
const indoorAll = indoorData as unknown as (Row & { kind: string })[];
const indoors = indoorAll.filter((r) => r.kind !== "Zoo");
const attractions = indoorAll.filter((r) => r.kind === "Zoo");
const drink = drinkData as unknown as Row[];
const events = eventsData as unknown as Row[];
const nearby = nearbyData as unknown as Row[];
const discGolf = [
  ...(stateParksData as unknown as (Row & { features: { discGolf: boolean | null } })[]).filter((p) => p.features.discGolf === true),
  ...(communityParksData as unknown as (Row & { facilities: { discGolf: boolean | null } })[]).filter((p) => p.facilities.discGolf === true),
];

const count = (rows: { verifiedDate: string | null; verifiedSource: string | null }[]) => ({
  total: rows.length,
  live: rows.filter(isPublishable).length,
});

/**
 * HEADER PHOTOGRAPHS FOR THE SECTION CARDS.
 *
 * Named by file only. The alt text and the crop come from whichever record
 * owns the picture, looked up below — so a section card can never end up
 * describing a photograph differently from the page it came off.
 *
 * A section gets a header only where the site has a real photograph of that
 * subject. Three of them don't: wine and beer, disc golf and events. Indoors
 * had none until the Wikimedia batch landed; it wears the New Castle Court
 * House now, which is a borrowed photograph and carries its credit and licence
 * on the record it came from.
 * A stand-in illustration for those would be furniture pretending to be
 * content, which is the same thing the "not yet photographed" panels were
 * pulled for. They stay plain until somebody has actually been.
 *
 * The dog is the one picture on this page that belongs to no record. It isn't
 * a place — it's the section's subject, and there is no Delaware park it is a
 * fact about — so it carries its own alt text here.
 */
const SECTION_HEADERS: Record<string, string> = {
  "/dogs/": "dogs-header",
  "/parks/": "cape-henlopen-bay",
  "/parks/community/": "talley-day-playground",
  "/surf-fishing/": "delaware-seashore-surf",
  "/indoors/": "new-castle-court-house",
  "/attractions/": "ashland-red-clay",
  "/nearby/": "plumpton-peacock",
};

const LOOSE_PHOTOS: Record<string, { alt: string; focus?: string }> = {
  "dogs-header": {
    alt: "A black and tan dog lying in fallen leaves in low winter sun, tongue out, an orange rubber ball by its paws.",
    focus: "50% 30%",
  },
};

/* Every photograph on the site, by file, so a header can borrow the record's
   own words rather than being described a second time. */
const photoIndex = new Map<string, { alt: string; focus?: string }>(
  Object.entries(LOOSE_PHOTOS),
);
for (const file of [townsData, stateParksData, communityParksData, dogParksData, indoorData, nearbyData]) {
  for (const record of file as unknown as { photos?: { file: string; alt: string; focus?: string }[] }[]) {
    for (const photo of record.photos ?? []) {
      if (!photoIndex.has(photo.file)) photoIndex.set(photo.file, photo);
    }
  }
}

const headerFor = (href: string) => {
  const file = SECTION_HEADERS[href];
  const photo = file ? photoIndex.get(file) : undefined;
  return photo ? { file: file!, ...photo } : null;
};

/**
 * THE ORDER OF THE CARDS.
 *
 * Three named first, because they're what people come for and "state parks"
 * is the phrase most of them arrive typing. Then whatever has a photograph,
 * because a card with a picture on it is worth more than a card without one
 * and burying them behind four text cards wastes them. Then the rest.
 *
 * The numbers on the cards are positions, computed below rather than written
 * on each section — they were hardcoded, and the first reorder would have left
 * "Section 07" sitting second.
 */
const ORDER_FIRST = ["/parks/", "/parks/community/", "/dogs/"];

/* The section registry keys on slug; these cards key on href. Community parks
   is the one that isn't a first path segment, so it's named here rather than
   derived — and it falls back to the trails mark rather than to nothing. */
const iconFor = (href: string): string => {
  if (href === "/parks/community/") return "playground";
  const slug = href.split("/").filter(Boolean)[0] ?? "";
  return sectionBySlug(slug)?.icon ?? "trails";
};

const sectionsRaw = [
  {
    href: "/dogs/",
    title: "Dogs",
    lede: "Where your dog is legal, on what date, and what it costs.",
    detail:
      "Five beach towns with five different sets of dates, the summer beaches that never close, pet fees, and every dog park and off-leash area on eight fields.",
    contents: [
      "Beach and boardwalk rules, by town",
      "Where a dog is legal in July",
      "Dog parks: fenced, water, shade, surface",
      "Pet fees, weight limits, dog counts",
      "Blue-green algae and pond safety",
    ],
    ...count(towns),
    unit: "town pages",
    figure: true,
  },
  {
    href: "/parks/",
    title: "State parks",
    lede: "All 17, what's actually at each one, and the 2026 fees.",
    detail:
      "From Cape Henlopen's 5,451 acres to a Civil War fort you can only reach by ferry. Camping, trails, surf fishing, and where dogs are allowed.",
    contents: [
      "Facilities, park by park",
      "2026 entry fees, and why the beach parks doubled",
      "Camping, cabins and trails",
      "Dog rules per park",
    ],
    ...count(stateParks),
    unit: "parks",
    figure: false,
  },
  {
    href: "/parks/community/",
    title: "Community parks",
    lede: "The local ones. Is there a toilet, and is it open?",
    detail:
      "What you want to know before loading the car. Toilets, playground, drinking water, shade, and whether the dog can come.",
    contents: [
      "Restrooms: permanent, portable or seasonal",
      "Playgrounds and accessibility",
      "Water, shade and pavilions",
      "Which ones contain a dog park",
    ],
    ...count(communityParks),
    unit: "parks",
    figure: false,
  },
  {
    href: "/surf-fishing/",
    title: "Surf fishing",
    lede: "Five of the twelve crossings need a reservation in peak hours. Not seven.",
    detail:
      "Drive-on access, permits, licenses, and the after-4pm rule that lets annual permit holders skip reservations entirely.",
    contents: [
      "Which crossings need a reservation",
      "Permit tiers and the 3-week delivery",
      "The license exemption that covers only you",
      "The off-peak permit ending in 2027",
      "Walk-on access, free, no permit",
    ],
    total: surfData.crossings.length,
    live: 0,
    unit: "crossings",
    figure: false,
  },
  {
    href: "/indoors/",
    title: "Indoors",
    lede: "Museums, science centers and libraries — for when it rains.",
    detail:
      "Hagley, Winterthur, the Biggs, the state's natural history museum, and fifteen library branches. Hours lead every card, because most of these shut two or three days a week.",
    contents: [
      "Opening hours, checked against the operator",
      "What admission actually costs",
      "Which are shut for building work right now",
      "Fifteen library branches in one table",
    ],
    ...count(indoors),
    unit: "places",
    figure: false,
  },
  {
    href: "/wineries-and-breweries/",
    title: "Wine and beer",
    lede: "Which wineries and breweries actually allow dogs.",
    detail:
      "Every guide calls these dog friendly. Almost none of them asked the business. This page prints the policy only where the winery or brewery publishes one itself.",
    contents: [
      "The dog answer, from the operator or not at all",
      "Hours and tasting fees",
      "Which publish no policy at all",
    ],
    ...count(drink),
    unit: "listed",
    figure: false,
  },
  {
    href: "/disc-golf/",
    title: "Disc golf",
    lede: "Nine courses. The round is free; the gate isn't.",
    detail:
      "Seven in state parks and two in county parks. Playing costs nothing anywhere — seven of the nine sit behind a park entrance fee, and that is the number worth knowing.",
    contents: [
      "Every course in a public park",
      "What entry costs at each",
      "Which two are free to walk into",
    ],
    total: discGolf.length,
    live: discGolf.filter(isPublishable).length,
    unit: "courses",
    figure: false,
  },
  {
    href: "/events/",
    title: "Events",
    lede: "Annual fairs and festivals, with dates worked out rather than guessed.",
    detail:
      "The fixtures, with the year I have actually confirmed. Where next year's dates are not published, this says so instead of computing one that might be wrong.",
    contents: [
      "Confirmed dates, per year",
      "What is on right now",
      "Which publish no recurring rule",
    ],
    ...count(events),
    unit: "events",
    figure: false,
  },
  {
    href: "/attractions/",
    title: "Places to go",
    lede: "Days out that aren't parks. You pay in, they shut at a time.",
    detail:
      "Ticketed days out with the hours and the price up front. Mostly outdoors, so check the forecast before you drive.",
    contents: [
      "Hours and admission",
      "Free winter days where they apply",
    ],
    ...count(attractions),
    unit: "listed",
    figure: false,
  },
  {
    href: "/nearby/",
    title: "Just over the line",
    lede: "Worth the drive, and not in Delaware.",
    detail:
      "The state is forty miles wide. Half of New Castle County lives closer to somewhere in Maryland or Pennsylvania than to Sussex, and every record here says plainly that it is out of state.",
    contents: [
      "Clearly marked as out of state",
      "Same sourcing as everything else",
    ],
    ...count(nearby),
    unit: "listed",
    figure: false,
  },
];

const sections = [...sectionsRaw]
  .sort((a, b) => {
    const rank = (s: { href: string }) => {
      const named = ORDER_FIRST.indexOf(s.href);
      if (named !== -1) return named;
      return headerFor(s.href) ? 10 : 20;
    };
    return rank(a) - rank(b) || sectionsRaw.indexOf(a) - sectionsRaw.indexOf(b);
  })
  .map((s, i) => ({ ...s, n: String(i + 1).padStart(2, "0") }));

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Delaware Field Guide",
    url: "https://delawarefieldguide.com/",
    description:
      "A reference for outdoor Delaware. Every fact carries the date it was checked and the source it came from.",
    publisher: { "@type": "Organization", name: "Delaware Field Guide" },
  },
];
---

<Layout
  title="Delaware Field Guide — parks, beaches and dog rules, dated"
  description="A verified reference for outdoor Delaware: 17 state parks, dog rules by town, museums, breweries and surf fishing. Every fact carries the date I checked it."
  schema={schema}
  {/* The layout's generic row is off because this page supplies its own,
      with a pitch about the site rather than about one park. */}
  share={false}
>
  <CoastBand />

  {/*
    A FRONT DOOR, NOT AN ESSAY.
    This opened with four paragraphs — what the site covers, why it exists,
    what other guides get wrong — before offering anywhere to go. All of it is
    true and none of it is what someone arrives for. The argument now lives on
    /how-we-verify/, which is where a reader who wants it goes looking.
  */}
  {/*
    THE HERO SELLS THE JOB, NOT THE METHOD.

    It read "Delaware, checked and dated", which is a property of the site
    rather than anything it does for you — and the paragraph under it listed
    sections, which is the navigation saying itself out loud. Neither told a
    stranger why they'd want this.

    So it leads with the question people actually arrive with, and then it
    DEMONSTRATES rather than describes: every example below is a live question
    that runs the finder on the real data. Nothing sells a checked dataset like
    watching it answer.
  */}
  <div class="wrap pt-9 pb-8">
    <p class="label m-0 flex items-center gap-2">
      <FlagMark class="w-[0.5rem] h-[0.62rem] shrink-0 text-ochre-deep" />
      A reference for outdoor Delaware
    </p>

    <h1 class="text-[2.7rem] sm:text-[3.6rem] mt-3.5 mb-0 max-w-[15ch] text-marsh">
      Find the right place in Delaware
    </h1>

    {/*
      A SQUARE ON A PHONE, FOUR-BY-THREE ON A DESKTOP, and no wider than that.

      This is a portrait photograph, and the measure on this site is 47rem, so
      the letterbox banner the ratio wants to be at desktop width would be a
      strip of tree trunk with the path, the footbridge and the whole canopy
      cropped off either end. Four-by-three is about as wide as a 3:4 source
      can go before it stops being the picture that was taken.

      It's also the only image on the page that loads eagerly. It sits
      directly under the headline, so making somebody wait for it is never the
      right call.
    */}
    {
      heroPhoto && heroPark && (
        <a href={`/parks/${heroPark.slug}/`} class="block no-underline group breakout mt-7">
          <figure class="m-0 relative">
            <img
              src={`/photos/${heroPhoto.file}-1400.jpg`}
              alt={heroPhoto.alt}
              width={1400}
              height={1866}
              fetchpriority="high"
              decoding="async"
              {/* Weighted low, not centred. Centring this frame fills it with
                  canopy and pushes the path, the fence and the footbridge —
                  the part that says "you can walk here" — off the bottom. */}
              style="object-position:50% 85%"
              class="w-full aspect-square sm:aspect-[4/3] object-cover block border-2 border-marsh"
            />
            {/* Two lines, not one. Name and credit on a single line truncate
                at 375px, and the half that gets cut is the attribution — the
                one part of a caption that can't be abbreviated. */}
            <figcaption
              class="absolute left-0 right-0 bottom-0 px-3 py-2 stamp text-cream bg-marsh/85 backdrop-blur-[2px] block"
              style={`border-bottom:3px solid ${colorFor("trails")}`}
            >
              <span class="block truncate">{heroPark.name}, {heroPark.town}</span>
              {heroPhoto.credit && (
                <span class="block truncate opacity-80 text-[0.72rem] mt-0.5">
                  {heroPhoto.credit}
                </span>
              )}
            </figcaption>
          </figure>
        </a>
      )
    }

    {/* Half the words it was. The old version listed five things the site
        covers and then explained the method, which is the navigation and the
        method page both saying themselves out loud above the chips that
        already demonstrate them. */}
    {/* Questions, not a description. The old version was a list of things the
        site has; this is the list of things people arrive already wondering,
        which is the same content read from the other end. */}
    <p class="mt-6 mb-0 text-[1.2rem] leading-[1.5] max-w-[52ch]">
      Looking for somewhere to take the dog to play, or a dry place to go with
      the kids when it rains? Are the restrooms open? How much is admission?
    </p>

    <p class="mt-4 mb-0 text-[1.05rem] leading-[1.55] max-w-[52ch]">
      Every listing carries the date I checked it and who told me, so you can
      see how old an answer is before you drive an hour on it.
    </p>

    {/*
      WHAT USED TO BE HERE: six example questions, two buttons, a row of
      counts, and a card pointing at the map. All four were the same move —
      the front page demonstrating the site to you before letting you into it
      — and stacked together they put four screens between the headline and
      the ten cards that are the actual contents.

      The examples and the map now live together on /ask/, which is where you
      end up the moment you use either. The counts said 17 state parks and 36
      local parks one scroll above ten cards that each say how many of their
      own records are published, which is the same numbers twice.
    */}
  </div>

  <div class="wrap">
    <div class="border-t-[3px] border-t-marsh"></div>
    <div class="border-t border-t-tide mt-[3px]"></div>
  </div>

  <div class="wrap py-9 grid gap-6 sm:gap-5 sm:grid-cols-2">
    {
      sections.map((s) => {
        const header = headerFor(s.href);
        return (
        <a href={s.href} class="sign sign-action no-underline block group relative overflow-hidden">
          {header && (
            <figure class="m-0 relative">
              <img
                src={`/photos/${header.file}-700.jpg`}
                alt={header.alt}
                width={700}
                height={394}
                loading="lazy"
                decoding="async"
                style={header.focus ? `object-position:${header.focus}` : undefined}
                class="w-full aspect-[16/9] object-cover block border-b-[3px] border-b-marsh"
              />
              {/* The section number moves onto the picture rather than being
                  dropped, because the card is read by its number in the prose
                  above the grid. */}
              <span class="absolute bottom-0 right-0 px-2.5 py-1 stamp text-cream bg-marsh/85 backdrop-blur-[2px]">
                {s.n}
              </span>
            </figure>
          )}
          <div class="p-5">
          {!header && <span class="stamp text-ochre-deep absolute top-5 right-5">{s.n}</span>}

          {/* The section's own mark, in the section's own colour, replacing a
              flag that was repeated on all ten and therefore said only "this
              is a section" — which the reader could already see. The same
              glyph appears on this section's nav item, its map markers and its
              filter chips, so it's learnt once. */}
          <p class="label m-0 flex items-center gap-2" style={`color:${colorFor(iconFor(s.href))}`}>
            <FeatureIcon icon={iconFor(s.href) as any} class="w-[1.05em] h-[1.05em] shrink-0" />
            Section {s.n}
          </p>

          <div class="flex items-end justify-between gap-3">
            <p class="font-display text-[1.85rem] font-bold mt-2 mb-0 tracking-[-0.03em] text-marsh underline decoration-ochre decoration-[3px] underline-offset-[0.14em] group-hover:decoration-marsh">
              {s.title}
            </p>
            {/* The drawn dog only appears where there's no photograph of one.
                With the real animal in the band directly above it, the mark
                reads as a second, worse dog. */}
            {s.figure && !header && (
              <DogFigure pose="dog" collar class="w-[3.1rem] h-[3.1rem] text-marsh shrink-0" />
            )}
          </div>

          <p class="mt-2.5 mb-0 text-[0.98rem] leading-[1.45] font-medium">{s.lede}</p>
          <p class="mt-2 mb-0 text-[0.9rem] leading-[1.5] text-ink-soft">{s.detail}</p>

          <ul class="list-none p-0 mt-4 mb-0 border-t-2 border-marsh">
            {s.contents.map((item) => (
              <li class="text-[0.84rem] leading-snug py-1.5 border-b border-tide/35 text-ink-soft">
                {item}
              </li>
            ))}
          </ul>

          {/* "published", not "confirmed". This counts isPublishable, which
              is confirmed OR sourced — and on a site whose whole point is that
              those are different claims, calling a sourced record confirmed on
              the front page is the exact overclaim it exists to avoid. */}
          <p class="stamp text-ink-soft mt-4 mb-0">
            {s.live} of {s.total} {s.unit} published
          </p>
          </div>
        </a>
        );
      })
    }
  </div>

  {/*
    THE FRONT PAGE OPTED OUT OF SHARING and shouldn't have. Every record page
    has had a share row for months; the one page somebody would send when they
    mean "this whole site is useful" had nothing. The pitch is different from a
    record's — you aren't saving anyone a specific drive, you're handing over a
    reference — so it says so rather than reusing the parking-lot line.
  */}
  <div class="wrap pb-10">
    <ShareRow
      title="Delaware Field Guide"
      summary="Parks, dog rules and days out in Delaware, each with the date it was checked"
      heading="Send someone the whole thing"
      pitch="If you know somebody who keeps asking whether the dog can come, this is the link. Every answer on it carries the date I checked it."
    />
  </div>

  {/*
    TWO ESSAYS LIVED HERE and have gone. One argued why the site exists (a
    stale Rehoboth dog rule, a doubled park fee), the other listed what isn't
    written yet. Both are true and neither belongs at the bottom of a front
    door — the argument is what /how-we-verify/ is for, and the gaps are on
    every section card already, which each print how many of their own records
    are published. A front page that ends by explaining itself is a front page
    that didn't trust the ten cards above it.
  */}
</Layout>

<style>
  /* --fc rather than `color`, so hover can fill with the hue and still set a
     readable label. `background: currentColor` paints the chip the colour of
     its own text. */
  .example-chip {
    color: var(--fc);
    border-color: var(--fc);
    transition: background-color 110ms ease, color 110ms ease;
  }
  .example-chip:hover,
  .example-chip:focus-visible {
    background: var(--fc);
    color: var(--color-shell);
  }
</style>
