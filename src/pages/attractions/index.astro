---
/**
 * Indoors — museums, science centers and libraries.
 *
 * The section exists because of the weather, not because of the institutions.
 * Nobody wakes up wanting a decorative arts collection; they wake up to rain
 * on day three of a beach week with two kids in a rental. So the page is
 * organized around "what's open today and does it cost anything", and the H1
 * says the weather part out loud.
 *
 * Hours lead every card. A park is open; these are shut two or three days a
 * week, and two of them are shut for building work right now. The failure mode
 * is a locked door at the end of an hour's drive up Route 1.
 *
 * Grouped by county, like every other section here. Someone in Lewes is not
 * driving to Wilmington for an afternoon, and a flat alphabetical list would
 * pretend otherwise.
 */
import Layout from "../../layouts/Layout.astro";
import PhotoStrip, { type StripItem } from "../../components/PhotoStrip.astro";
import NearMe from "../../components/NearMe.astro";
import FlagIcon from "../../components/FlagIcon.astro";
import CardPhoto from "../../components/CardPhoto.astro";
import Tag from "../../components/Tag.astro";
import CardShare from "../../components/CardShare.astro";
import CardGallery from "../../components/CardGallery.astro";

import indoorData from "../../data/indoor.json";
import { COUNTY_ORDER, completeness, hoursAnswer, OUTDOOR_KINDS, present, type IndoorPlace } from "../../lib/indoor";
import { isPublishable, robotsFor } from "../../lib/verification";
import { byPhotoThen } from "../../lib/order";

const places = (indoorData as unknown as IndoorPlace[]).filter((p) => OUTDOOR_KINDS.includes(p.kind));
const live = places.filter(isPublishable);
const gate = {
  verifiedDate: null,
  verifiedSource: null,
  sources: live.length ? [{ label: "x", url: "x" }] : null,
  sourcedOn: live.length ? "2026-08-04" : null,
};

const free = places.filter((p) => p.admission.free === true).length;
const unknownAdmission = places.filter((p) => p.admission.amount === null && p.admission.free !== true).length;
const shut = places.filter((p) => p.hours.lines === null).length;

const ranked = byPhotoThen(places, (a, b) => completeness(b).known - completeness(a).known);
const byCounty = COUNTY_ORDER.map((county) => ({
  county,
  places: ranked.filter((p) => p.county === county),
})).filter((g) => g.places.length > 0);
/* ONE frame per record, not one per photograph — see the parks listing. */
const stripItems: StripItem[] = (places as any[])
  .filter((p) => p.photos?.length)
  .map((p) => ({ photo: p.photos[0], href: `/attractions/${p.slug}/`, name: p.name }));
---

<Layout
  title="Places to go in Delaware — hours, tickets and what's there"
  description="Days out in Delaware that aren't parks: opening hours, what it costs to get in and what's actually there. Free winter admission marked where it applies."
  robots={robotsFor(gate)}
>
  <div class="wrap pt-11 pb-6">
    <p class="label m-0">Places to go</p>
    <h1 class="text-[2.2rem] sm:text-[2.9rem] mt-3.5 mb-0 max-w-[15ch] text-marsh">
      Places to go
    </h1>
    <p class="mt-5 mb-0 text-[1.15rem] leading-[1.5] max-w-[54ch]">
      Somewhere to spend an afternoon that isn't a park. You pay to get in and
      they shut at a time, so check before you drive out. Most of it is
      outside — if it's raining, try <a href="/indoors/">the museums and
      libraries</a> instead.
    </p>
  </div>

  {
    byCounty.map(({ county, places: group }) => (
      <div class="wrap pb-8">
        <h2 class="label m-0 pb-3">{county} County</h2>
        <PhotoStrip items={stripItems} accent="giftShop" class="breakout mb-5" />

        <NearMe noun="places" class="breakout mb-4" />

        <div class="grid gap-4 sm:grid-cols-2 breakout">
      {
        group.map((place) => {
          const { known, total } = completeness(place);
          const hrs = hoursAnswer(place.hours);
          const has = present(place);
          return (
            <article data-reveal
                data-lat={place.coords?.lat}
                data-lon={place.coords?.lon} class="sign sign-action relative group overflow-hidden">
              <a href={`/attractions/${place.slug}/`} class="absolute inset-0 z-10 no-underline">
                <span class="sr-only">{place.name}</span>
              </a>
              <CardShare path={`/attractions/${place.slug}/`} title={place.name} />

              {place.photos?.length && <CardGallery photos={place.photos} />}

              <div class="p-4 sm:p-5">
                <header class="flex items-start justify-between pr-12 gap-3">
                  <div>
                    <h2 class="font-display text-[1.12rem] font-semibold tracking-[-0.03em] m-0 text-marsh underline decoration-ochre decoration-2 underline-offset-[0.16em] group-hover:decoration-marsh">
                      {place.name}
                    </h2>
                    <p class="stamp text-ink-soft mt-1 mb-0">{place.kind} · {place.town}</p>
                  </div>
                  <span class="stamp text-ink-soft shrink-0">{known}/{total}</span>
                </header>

                {/* Hours first, always, and visually separated. */}
                <div class="mt-3.5 border-y-2 border-marsh py-2.5">
                  <div class="flex items-baseline justify-between gap-3">
                    <span class="label">Open</span>
                    <span
                      class={`text-[0.9rem] text-right leading-snug ${
                        hrs.state === "unknown" ? "text-ink-soft italic" : "text-ink font-medium"
                      }`}
                    >
                      {hrs.text}
                    </span>
                  </div>
                  {place.hours.season && (
                    <p class="stamp text-flag-red-bearing mt-1.5 mb-0 text-right">{place.hours.season}</p>
                  )}
                </div>

                <p class="mt-3 mb-0 text-[0.9rem] leading-[1.55]">{place.blurb}</p>

                {has.length > 0 && (
                  <ul class="list-none p-0 m-0 mt-3.5 flex flex-wrap gap-1.5">
                    {has.map((f) => (
                      <Tag icon={f.key as any} label={f.label} emphasis={f.emphasis} />
                    ))}
                  </ul>
                )}

                {place.warnings.length > 0 && (
                  <p class="mt-3 mb-0 text-[0.85rem] leading-snug text-ink-soft flex gap-1.5">
                    <FlagIcon icon="alert" class="w-[1em] h-[1em] mt-1 shrink-0 text-flag-red" />
                    <span>{place.warnings[0]}</span>
                  </p>
                )}

                <p class="stamp text-ink-soft mt-3.5 mb-0 flex items-center justify-between gap-3">
                  <span>{place.operator}</span>
                  <span class="text-ochre-deep group-hover:translate-x-0.5 transition-transform duration-100">→</span>
                </p>
              </div>
            </article>
          );
        })
      }
        </div>
      </div>
    ))
  }

  <div class="wrap prose-field pb-2">
    <h2>Why these are separate from the parks</h2>
    <p class="max-w-[58ch]">
      A park is just open — you turn up. These have a gate and a ticket and a
      closing time, and getting that wrong wastes a drive. So they get their
      own page with the hours and the price up front.
    </p>
  </div>

  <div class="wrap prose-field pb-4">
    <h2>Related</h2>
    <ul>
      <li><a href="/indoors/">Museums, science centers and libraries</a></li>
      <li><a href="/parks/">The 17 state parks</a></li>
      <li><a href="/events/">Fairs and events</a></li>
    </ul>
  </div>
</Layout>
