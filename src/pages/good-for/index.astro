---
/**
 * The intent hub.
 *
 * Counts are live, so a list that has gone thin says so here rather than
 * promising something the page can't deliver when you arrive.
 */
import Layout from "../../layouts/Layout.astro";
import { INTENTS, MIN_TO_INDEX } from "../../lib/intents";

import stateParks from "../../data/state-parks.json";
import communityParks from "../../data/community-parks.json";
import indoor from "../../data/indoor.json";
import drink from "../../data/drink.json";

const data = {
  state: stateParks as any[],
  community: communityParks as any[],
  indoor: indoor as any[],
  drink: drink as any[],
};

const rows = INTENTS.map((i) => ({ ...i, count: i.match(data).length })).sort(
  (a, b) => b.count - a.count,
);
const live = rows.filter((r) => r.count >= MIN_TO_INDEX).length;
---

<Layout
  title="Good For — Find a Delaware Place by What You Need"
  description="Delaware places sorted by the thing that decides the trip: rain, a playground with restrooms, free admission, Sunday opening, shade, toddlers, dogs."
>
  <div class="wrap pt-11 pb-6">
    <p class="label m-0">Good for</p>
    <h1 class="text-[2.2rem] sm:text-[2.9rem] mt-3.5 mb-0 max-w-[17ch] text-marsh">
      Start from the problem
    </h1>
    <p class="mt-5 mb-0 text-[1.15rem] leading-[1.5] max-w-[54ch]">
      Nobody sets out wanting a county park. They want somewhere dry, or shaded,
      or open on a Sunday, or with a bathroom near the swings.
    </p>
    <p class="mt-4 mb-0 text-[1.05rem] leading-[1.55] max-w-[54ch]">
      Each list below is built from confirmed facts only, so a place appears
      because somebody checked — not because it probably qualifies. That keeps
      several of these shorter than they could be, which is the point.
    </p>
    <p class="stamp text-ink-soft mt-5 mb-0">
      {live} of {rows.length} lists long enough to be worth searching for
    </p>
  </div>

  <div class="wrap pb-8">
    <ul class="list-none p-0 m-0 grid gap-4 sm:grid-cols-2 breakout">
      {
        rows.map((r) => (
          <li>
            <a
              href={`/good-for/${r.slug}/`}
              class="sign sign-action block no-underline group px-4 py-4 sm:px-5 sm:py-5 h-full"
            >
              <p class="font-display text-[1.15rem] font-semibold tracking-[-0.03em] m-0 text-marsh underline decoration-ochre decoration-2 underline-offset-[0.16em] group-hover:decoration-marsh">
                {r.h1}
              </p>
              <p class="stamp text-ink-soft mt-1 mb-0">{r.title}</p>
              <p class="mt-3 mb-0 text-[0.92rem] leading-snug max-w-[44ch]">{r.answer}</p>
              <p class="stamp text-ink-soft mt-3 mb-0">
                {r.count} {r.count === 1 ? "place" : "places"}
                {r.count < MIN_TO_INDEX ? " · still filling in" : ""}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
