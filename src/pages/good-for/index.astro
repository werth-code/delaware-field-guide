---
import Layout from "../../layouts/Layout.astro";
import stateParksData from "../../data/state-parks.json";
import communityParksData from "../../data/community-parks.json";
import dogParksData from "../../data/parks.json";
import { allGoodFor } from "../../lib/good-for";
import { isPublishable } from "../../lib/verification";

const tags = allGoodFor(stateParksData as any[], communityParksData as any[]);
const dogParksHeld = (dogParksData as any[]).filter((p) => !isPublishable(p)).length;
---

<Layout
  title="Good for — pick the afternoon, not the park"
  description="Delaware parks sorted by what you actually want: restrooms that exist, lifeguards on duty, shade in August, somewhere to sit. Every tag confirmed."
>
  <div class="wrap pt-11 pb-6">
    <p class="label m-0">Good for</p>
    <h1 class="text-[2.5rem] sm:text-[3.3rem] mt-3.5 mb-0 max-w-[14ch] text-marsh">Pick the afternoon</h1>
    <p class="mt-5 mb-0 text-[1.15rem] leading-[1.5] max-w-[54ch]">
      Most days you don't want a park. You want shade, or a toilet, or somewhere
      the kids can run for an hour. So the lists are sorted that way.
    </p>
  </div>

  <div class="wrap pb-9">
    <ul class="list-none p-0 m-0 grid gap-3 sm:grid-cols-2 breakout">
      {
        tags.map((t, i) => (
          <li data-reveal style={`--stagger:${Math.min(i, 7)}`}>
            <a href={`/good-for/${t.slug}/`} class="sign sign-action block p-4 sm:p-5 no-underline h-full group">
              <p class="font-display text-[1.3rem] font-bold m-0 text-marsh underline decoration-ochre decoration-2 underline-offset-[0.16em] group-hover:decoration-marsh">
                {t.label}
              </p>
              <p class="stamp text-ink-soft mt-2 mb-0">
                {t.parks.length} {t.parks.length === 1 ? "park" : "parks"}, confirmed
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="wrap prose-field pb-4">
    <h2>The tags that aren't here yet</h2>
    <p class="max-w-[58ch]">
      The most useful lists this site could carry are the dog park ones. Which
      are actually fenced. Which have a separate small-dog side, which matters a
      lot if your dog is reactive. Which have water in August.
    </p>
    <p class="max-w-[58ch]">
      None of them can ship. All {dogParksHeld} dog parks are still unconfirmed,
      because their details came off review sites rather than from anyone who
      stood in them, and a tag built on that is a promise I can't keep. Confirm
      the parks and the lists appear on their own.
    </p>

    <h2>Related</h2>
    <ul>
      <li><a href="/parks/">All 17 state parks</a></li>
      <li><a href="/dogs/">Dog rules by town</a></li>
      <li><a href="/ask/">Ask for something specific</a></li>
    </ul>
  </div>
</Layout>
