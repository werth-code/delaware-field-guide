---
/**
 * Illustrated stand-in for a plate, in the poster idiom.
 *
 * A Delaware beach specifically: snow fence along the dune, a guard stand, a
 * warning flag. Those three things are what the coast actually looks like from
 * Fenwick to Lewes, and they're what the rules on this site are about.
 *
 * Flat bands, six colors, no gradient. The guard stand earns its place —
 * "when lifeguards are present" is the clause that decides whether a dog is
 * legal in the shoulder weeks, so it belongs in the picture.
 *
 * There is deliberately nobody in it. A figure walking a dog was drawn here
 * once and read as a crude pictogram at every size the page uses — and worse,
 * it asserted something: a dog on the sand, on a page whose whole job is to
 * tell you whether that is currently legal. An empty beach says nothing it
 * shouldn't.
 */
interface Props {
  class?: string;
  /** Flag on the staff. Pass a status to make the picture say something. */
  flag?: "none" | "closed";
}
const { class: className = "", flag = "closed" } = Astro.props;

/* Snow fence: paired slats, the way it actually stands. */
const slats = Array.from({ length: 34 }, (_, i) => 24 + i * 35);
---

<div class={`w-full ${className}`}>
  <svg viewBox="0 0 1200 470" class="w-full h-auto block" role="presentation" aria-hidden="true">
    <!-- Sky -->
    <rect x="0" y="0" width="1200" height="150" fill="var(--color-abyss)" />
    <rect x="0" y="150" width="1200" height="70" fill="var(--color-marsh)" />
    <rect x="0" y="220" width="1200" height="34" fill="var(--color-tide)" />

    <circle cx="960" cy="150" r="58" fill="var(--color-ochre)" />

    <!-- Survey rules through the sky -->
    <rect x="0" y="104" width="1200" height="2" fill="var(--color-tide)" opacity="0.5" />
    <rect x="0" y="113" width="1200" height="1" fill="var(--color-tide)" opacity="0.3" />

    <!-- Sea -->
    <rect x="0" y="254" width="1200" height="56" fill="var(--color-marsh)" />
    <g fill="var(--color-surf)" opacity="0.7">
      <rect x="40" y="270" width="130" height="3" />
      <rect x="250" y="270" width="70" height="3" />
      <rect x="520" y="270" width="160" height="3" />
      <rect x="820" y="270" width="90" height="3" />
      <rect x="1000" y="270" width="150" height="3" />
      <rect x="0" y="288" width="100" height="3" />
      <rect x="190" y="288" width="180" height="3" />
      <rect x="460" y="288" width="80" height="3" />
      <rect x="640" y="288" width="190" height="3" />
      <rect x="900" y="288" width="120" height="3" />
    </g>

    <!-- Wet sand, then dry -->
    <rect x="0" y="310" width="1200" height="26" fill="var(--color-tide)" />
    <rect x="0" y="336" width="1200" height="134" fill="var(--color-sand)" />

    <!-- Snow fence along the dune line. Delaware's most recognizable object. -->
    <g stroke="var(--color-marsh)" stroke-width="4" stroke-linecap="round">
      {slats.map((x) => <line x1={x} y1="300" x2={x + 5} y2="344" />)}
      <line x1="0" y1="312" x2="1200" y2="312" stroke-width="3" />
      <line x1="0" y1="334" x2="1200" y2="334" stroke-width="3" />
    </g>

    <!-- Guard stand. Drawn as the chair it is, in strokes — filled, it went to
         a dark lump at this scale. The lifeguard clause is what decides
         whether a dog is legal in the shoulder weeks, so it belongs here. -->
    <g stroke="var(--color-abyss)" stroke-width="6" stroke-linecap="round" fill="none">
      <path d="M296 360l26-52" />
      <path d="M370 360l-26-52" />
      <path d="M304 340h58" />
      <path d="M318 306h34" />
      <path d="M322 306v-30" />
      <path d="M316 278h30" />
    </g>
    <rect x="316" y="298" width="40" height="9" rx="2" fill="var(--color-abyss)" />

    <!-- Staff and flag -->
    <g fill="var(--color-abyss)">
      <rect x="150" y="240" width="6" height="120" />
      {flag === "closed" && <path d="M156 246h78l-20 22 20 22h-78z" fill="var(--color-flag-red)" />}
      {flag === "none" && <path d="M156 246h78l-20 22 20 22h-78z" />}
    </g>

  </svg>
</div>
