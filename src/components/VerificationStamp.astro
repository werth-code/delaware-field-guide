---
/**
 * Two mutually exclusive renderings, chosen by the data — never by hand:
 *
 *   verified   → the mono stamp. "Verified 6 Aug 2026 · City of Rehoboth Beach, by phone"
 *   unverified → a loud, unmissable notice listing exactly what's outstanding
 *                and who to call. The page is already noindex by this point
 *                (see verification.ts), so this block is for the author, not
 *                for search.
 *
 * There is no third state and no override. If it isn't confirmed, it cannot
 * wear the stamp.
 */
import type { Verifiable } from "../lib/verification";
import { isVerified, stampText } from "../lib/verification";

interface Props {
  item: Verifiable & {
    sources?: { label: string; url: string; note: string | null }[];
    callTo?: { name: string; phone: string } | null;
    outstanding?: string[];
  };
}

const { item } = Astro.props;
const verified = isVerified(item);
const sources = item.sources ?? [];
---

{
  verified ? (
    <aside class="sign my-8 border-l-[5px] border-l-flag-green px-4 py-4">
      <p class="stamp text-ink m-0">{stampText(item)}</p>
      {sources.length > 0 && (
        <ul class="list-none p-0 mt-2.5 mb-0 space-y-1">
          {sources.map((s) => (
            <li class="text-[0.85rem] leading-snug">
              <a href={s.url} rel="nofollow">{s.label}</a>
              {s.note && <span class="text-structure-text"> — {s.note}</span>}
            </li>
          ))}
        </ul>
      )}
      <p class="mt-3 mb-0 text-[0.85rem] text-structure-text max-w-[56ch]">
        Rules change. If you find this wrong,{" "}
        <a href="/how-we-verify/#corrections">tell us and we'll fix it and say we did</a>.
      </p>
    </aside>
  ) : (
    <aside class="my-8 border border-flag-red border-l-[5px] border-l-flag-red bg-flag-red-wash px-4 py-4 rounded-[2px]">
      <p class="label text-ink m-0">Not verified — this page is noindex</p>

      <p class="mt-2 mb-0 text-[0.95rem] max-w-[60ch]">
        Nothing here has been confirmed first-party yet, so it does not carry a
        verification stamp and search engines are told not to index it. Confirm
        the outstanding items, then set <code class="stamp">verifiedDate</code> and{" "}
        <code class="stamp">verifiedSource</code> in{" "}
        <code class="stamp">src/data/towns.json</code> to publish it.
      </p>

      {item.callTo && (
        <p class="mt-3 mb-0 text-[0.95rem]">
          <span class="label">Call</span>{" "}
          <a href={`tel:${item.callTo.phone.replace(/[^0-9+]/g, "")}`} class="tap stamp text-[0.95rem]">
            {item.callTo.phone}
          </a>{" "}
          <span class="text-structure-text">— {item.callTo.name}</span>
        </p>
      )}

      {item.outstanding && item.outstanding.length > 0 && (
        <>
          <p class="label mt-4 mb-1">Outstanding</p>
          <ol class="list-decimal m-0 ps-5 text-[0.9rem] leading-snug space-y-1.5">
            {item.outstanding.map((o) => (
              <li>{o}</li>
            ))}
          </ol>
        </>
      )}

      {sources.length > 0 && (
        <>
          <p class="label mt-4 mb-1">Drafted from</p>
          <ul class="list-none p-0 m-0 space-y-1">
            {sources.map((s) => (
              <li class="text-[0.85rem] leading-snug">
                <a href={s.url} rel="nofollow">{s.label}</a>
                {s.note && <span class="text-structure-text"> — {s.note}</span>}
              </li>
            ))}
          </ul>
        </>
      )}
    </aside>
  )
}
