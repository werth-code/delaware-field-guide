---
/**
 * Sourcing block. One quiet panel, in both states.
 *
 * The unverified case used to render a loud red author-facing block listing
 * every outstanding to-do. That was a work tracker on a reader's page. The
 * checklist now prints to the build console instead (see lib/verification.ts,
 * called from the town template), which is where the person who has to act on
 * it actually is.
 *
 * What survives is what a reader can use: who says so, when it was last
 * checked, and the number to call if they want to hear it first-hand. The
 * phone number is genuinely useful published content — "here is the city's
 * number" beats "trust us" — so it shows whether or not the page is verified.
 *
 * One line of honesty stays when the page is unconfirmed. It is small and
 * unalarming, but it is not optional: this site's whole claim is that facts
 * carry their provenance, and a page presenting unconfirmed dates with no
 * caveat would break that even while noindexed. The noindex, the sitemap
 * exclusion and the hiding from /dogs/ are all unchanged — they live in
 * verification.ts, not here.
 */
import type { Verifiable } from "../lib/verification";
import { isVerified, sourcedText, stampText, tierOf } from "../lib/verification";

interface Props {
  item: Verifiable & {
    sources?: { label: string; url: string; note: string | null }[];
    callTo?: { name: string; phone: string } | null;
  };
}

const { item } = Astro.props;
const verified = isVerified(item);
const tier = tierOf(item);
const sources = item.sources ?? [];
const tel = item.callTo?.phone.replace(/[^0-9+]/g, "");

/* Ochre for sourced, green for confirmed. The color is doing semantic work —
   a reader shouldn't have to read the stamp to tell the two apart. */
const edge = verified ? "border-l-flag-green" : "border-l-ochre";
---

<aside
  class={`sign breakout my-10 px-4 sm:px-5 py-5 border-l-[9px] ${edge}`}
>
  {
    verified ? (
      <p class="m-0">
        <span class="stamp stamp-struck">{stampText(item)}</span>
      </p>
    ) : tier === "sourced" ? (
      <>
        <p class="label text-ochre-deep m-0">Read from the source — not yet confirmed by phone</p>
        <p class="stamp text-ink-soft mt-1.5 mb-0">{sourcedText(item)}</p>
      </>
    ) : (
      <p class="stamp text-ink-soft m-0">
        Not yet checked against a primary source.
      </p>
    )
  }

  {
    sources.length > 0 && (
      <ul class="list-none p-0 mt-4 mb-0 space-y-1.5">
        {sources.map((s) => (
          <li class="text-[0.88rem] leading-snug">
            <a href={s.url} rel="nofollow">{s.label}</a>
            {s.note && <span class="text-ink-soft"> — {s.note}</span>}
          </li>
        ))}
      </ul>
    )
  }

  {
    item.callTo && (
      <p class="mt-4 mb-0 text-[0.92rem]">
        <span class="label">Check it yourself</span>
        <br />
        <a href={`tel:${tel}`} class="tap stamp text-[1rem]">
          {item.callTo.phone}
        </a>
        <span class="block text-ink-soft text-[0.88rem]">{item.callTo.name}</span>
      </p>
    )
  }

  <p class="mt-4 mb-0 text-[0.85rem] text-ink-soft max-w-[56ch]">
    Rules change. If you find this wrong,{" "}
    <a href="/about/#corrections">tell us and I'll fix it and say I did</a>.
  </p>
</aside>
