---
/**
 * Masthead. A deep field with a registration rule under it — a park entrance
 * sign, not a web nav. It anchors the top of every page.
 *
 * Section links come from the registry, so adding a section adds its link
 * here with no edit. The section's own nav rides underneath.
 */
import Logo from "./Logo.astro";
import SectionNav from "./SectionNav.astro";
import NavLinks from "./NavLinks.astro";

---

<header class="field-deep">
  {/* MOBILE IS A DISCLOSURE, DESKTOP IS A ROW.
      Nine links wrapped to two rows at 375px, and with the section bar under
      them the masthead took half the viewport before any content. A reader on
      a phone met the navigation instead of the page.

      No JavaScript in either. A nav that needs a script to open is a nav that
      can fail shut, and this site does not put content behind a script. */}

  {/* Phone. */}
  <details class="nav-disclosure wrap sm:hidden py-2.5">
    <summary class="list-none flex items-center justify-between gap-3 cursor-pointer text-cream min-h-[44px]">
      <span class="flex items-center gap-2.5">
        <Logo id="masthead-m" class="w-[2.1rem] h-[2.1rem] shrink-0" />
        <span class="font-display text-[1.2rem] font-bold tracking-[-0.026em] leading-none whitespace-nowrap">
          Delaware Field Guide
        </span>
      </span>
      {/* .label carries its own ink-soft colour, which is 1.4:1 on the deep
          field. Forced to cream, which clears 14:1. */}
      <span class="label text-cream flex items-center gap-1.5 shrink-0">
        Menu
        <svg viewBox="0 0 24 24" class="nav-chevron w-[0.9em] h-[0.9em]" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" aria-hidden="true">
          <path d="M4 8l8 8 8-8" />
        </svg>
      </span>
    </summary>

    <nav aria-label="Sections" class="flex flex-col items-start pt-1.5 pb-1">
      <NavLinks preopen />
    </nav>
  </details>

  {/* Everything else. */}
  <div class="wrap hidden sm:flex sm:items-center sm:justify-between gap-4 py-3">
    <a href="/" class="tap no-underline gap-2.5 text-cream self-start">
      <Logo id="masthead" class="w-[2.1rem] h-[2.1rem] shrink-0" />
      <span class="font-display text-[1.2rem] font-bold tracking-[-0.026em] leading-none whitespace-nowrap">
        Delaware Field Guide
      </span>
    </a>

    <nav aria-label="Sections" class="flex flex-wrap gap-x-5 gap-y-0 items-center justify-end">
      <NavLinks />
    </nav>
  </div>

  {/* Registration rule: ochre over the deep field, like a two-color print edge. */}
  <div class="h-[3px] w-full bg-ochre"></div>
</header>

<SectionNav />

<script>
  /*
   * Menu manners. All of it enhancement on top of <details>, which keeps
   * working with this script gone — the no-fail-shut rule is intact because
   * everything here CLOSES things.
   *
   * Three behaviours every menu is expected to have and a bare <details>
   * doesn't:
   *   - choosing a link shuts the menu it lives in, immediately, so the tap
   *     is acknowledged before the next page loads
   *   - clicking anywhere else shuts an open dropdown
   *   - so does Escape
   */
  document.addEventListener("click", (e) => {
    const link = e.target instanceof Element && e.target.closest("a[href]");
    for (const d of document.querySelectorAll(".nav-group[open], .nav-disclosure[open]")) {
      if (link && d.contains(link)) d.removeAttribute("open");
      else if (d.classList.contains("nav-group") && !d.contains(e.target)) d.removeAttribute("open");
    }
  });
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    for (const d of document.querySelectorAll(".nav-group[open]")) d.removeAttribute("open");
  });
</script>
