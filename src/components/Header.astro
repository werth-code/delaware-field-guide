---
/**
 * Header. Deliberately plain: a wordmark and the section.
 *
 * No mega-nav, no search, no hamburger. There is one section today and the
 * pages are reached from the section hub. When section two (surf fishing)
 * lands, this grows one link.
 */
const { pathname } = Astro.url;
const inDogs = pathname.startsWith("/dogs");
---

<header class="border-b border-rule bg-panel">
  <div class="wrap wrap-wide flex items-baseline justify-between gap-4 py-3">
    <a href="/" class="tap no-underline group">
      <span class="font-display text-[1.15rem] font-bold tracking-tight text-ink"
        >Delaware Field Guide</span
      >
    </a>

    <nav aria-label="Sections">
      <a
        href="/dogs/"
        class="tap label no-underline hover:text-ink"
        aria-current={inDogs ? "true" : undefined}
        style={inDogs ? "color: var(--color-ink); box-shadow: inset 0 -2px 0 var(--color-ink);" : ""}
      >
        Dogs
      </a>
    </nav>
  </div>
</header>
