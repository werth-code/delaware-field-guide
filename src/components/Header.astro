---
/**
 * Masthead. A deep field with a registration rule under it — a park entrance
 * sign, not a web nav. It anchors the top of every page.
 *
 * Section links come from the registry, so adding a section adds its link
 * here with no edit. The section's own nav rides underneath.
 */
import Logo from "./Logo.astro";
import SectionNav from "./SectionNav.astro";
import { SECTIONS, sectionFor } from "../lib/sections";

const { pathname } = Astro.url;
const current = sectionFor(pathname);
---

<header class="field-deep">
  <div class="wrap flex items-center justify-between gap-4 py-3">
    <a href="/" class="tap no-underline gap-2.5 text-cream">
      <Logo id="masthead" class="w-[2.1rem] h-[2.1rem] shrink-0" />
      <span class="font-display text-[1.2rem] font-bold tracking-[-0.026em] leading-none">
        Delaware Field Guide
      </span>
    </a>

    <nav aria-label="Sections" class="flex gap-4 sm:gap-5 items-center">
      {/* The planner spans every section, so it sits outside the list. */}
      <a
        href="/plan/"
        class={`tap label no-underline ${pathname === "/plan/" ? "text-cream" : "text-cream-soft hover:text-cream"}`}
        aria-current={pathname === "/plan/" ? "page" : undefined}
        style={pathname === "/plan/" ? "box-shadow: inset 0 -3px 0 var(--color-ochre);" : ""}
      >
        Plan
      </a>
      {
        SECTIONS.map((s) => {
          const here = current?.slug === s.slug;
          return (
            <a
              href={`/${s.slug}/`}
              {/* cream-soft, not surf: surf is 6.3:1 on the deep field and
                  these are 11px. cream-soft clears 7.8:1. */}
              class={`tap label no-underline ${here ? "text-cream" : "text-cream-soft hover:text-cream"}`}
              aria-current={here ? "page" : undefined}
              style={here ? "box-shadow: inset 0 -3px 0 var(--color-ochre);" : ""}
            >
              {s.label}
            </a>
          );
        })
      }
    </nav>
  </div>

  {/* Registration rule: ochre over the deep field, like a two-colour print edge. */}
  <div class="h-[3px] w-full bg-ochre"></div>
</header>

<SectionNav />
