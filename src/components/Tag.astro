---
/**
 * A feature chip: glyph, then label.
 *
 * One component so a tag looks identical on a park card, a town park card, a
 * museum card and in a chatbot answer. That was the point of doing this —
 * recognition only works if the thing is the same everywhere, and until now
 * these were four separate inline `<li class="…">{label}</li>` in four files
 * that had already drifted apart in size.
 *
 * `emphasis` is set by the data layer, not passed by hand, so it can't be
 * applied inconsistently. See FeatureIcon for why it's the only color here.
 */
import FeatureIcon, { type FeatureKey } from "./FeatureIcon.astro";
import { colorFor } from "../lib/feature-colors";

interface Props {
  icon: FeatureKey;
  label: string;
  /** The three that decide whether the trip works. */
  emphasis?: boolean;
  /**
   * "confirmed" dresses the chip in flag green — the site's one meaning for
   * that color. A card's amenity chips only render for facts recorded true,
   * so on cards this is the honest dress: the glyph says WHICH, the green
   * says the data actually holds it. Left unset, the chip keeps its section
   * color, which is right for filters and navigation where nothing is being
   * asserted.
   */
  state?: "confirmed";
  class?: string;
}
const { icon, label, emphasis = false, state, class: className = "" } = Astro.props;

/* Inline style rather than a Tailwind class, because 31 arbitrary hex values
   would each need a class Tailwind can only generate if it sees the literal
   string in a file. A color built at runtime never gets generated, and the
   chip renders with no fill at all. */
const c = colorFor(icon);
const style =
  state === "confirmed"
    ? emphasis
      ? `background:var(--color-flag-green-bearing);border-color:var(--color-flag-green-bearing);color:var(--color-cream)`
      : `background:var(--color-flag-green-wash);border-color:var(--color-flag-green-bearing);color:var(--color-flag-green-bearing)`
    : emphasis
      ? `background:${c};border-color:${c};color:var(--color-cream)`
      : `color:${c};border-color:${c}`;
---

<li
  class={`inline-flex items-center gap-1.5 px-2 py-1 stamp text-[0.68rem] leading-none border rounded-[var(--radius-sign)] ${
    emphasis ? "" : "bg-shell"
  } ${className}`}
  style={style}
>
  <FeatureIcon icon={icon} class="w-[1.15em] h-[1.15em] shrink-0" />
  {label}
</li>
