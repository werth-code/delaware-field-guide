---
/**
 * Footer. A deep field to close the sheet, and the three things that have to
 * exist from page one because retrofitting them across forty pages later is
 * miserable:
 *
 *   1. Email capture
 *   2. The link to /how-we-verify/ — the differentiator, stated plainly
 *   3. "Built by Werth Design" — this site is a lead-gen asset, not a hobby
 */
import EmailCapture from "./EmailCapture.astro";
import FlagMark from "./FlagMark.astro";

const year = new Date().getFullYear();
---

<footer class="field-deep mt-20 no-print">
  <div class="h-[2px] w-full bg-tide"></div>
  <div class="h-[3px] w-full bg-ochre"></div>

  <div class="wrap py-11">
    <EmailCapture />

    {/* THREE GROUPS, BECAUSE THE BUSINESS MODEL HAS THREE PARTS AND A READER
        should not have to work out which is which. The publication, the things
        it sells itself, and the studio that built it. A flat row of nine links
        made all three look like the same kind of thing. */}
    <nav aria-label="Site" class="mt-11 grid gap-x-8 gap-y-7 sm:grid-cols-3">
      <div>
        <p class="label text-cream/60 m-0 pb-2">The Field Guide</p>
        <ul class="list-none p-0 m-0 space-y-0.5">
          <li><a href="/about/" class="tap text-[0.92rem] text-cream">Who writes this</a></li>
          <li><a href="/about/" class="tap text-[0.92rem] text-cream">How I check it</a></li>
          <li><a href="/verified/" class="tap text-[0.92rem] text-cream">Verification index</a></li>
          <li><a href="/changed/" class="tap text-[0.92rem] text-cream">What changed</a></li>
          <li><a href="/report/" class="tap text-[0.92rem] text-cream">Send a report</a></li>
          <li><a href="/contacts/" class="tap text-[0.92rem] text-cream">Phone numbers</a></li>
          <li><a href="/advertising/" class="tap text-[0.92rem] text-cream">Advertising &amp; independence</a></li>
        </ul>
      </div>

      <div>
        <p class="label text-cream/60 m-0 pb-2">From the Field Guide</p>
        <ul class="list-none p-0 m-0 space-y-0.5">
          <li><a href="/field-marks/" class="tap text-[0.92rem] text-cream">Field Marks</a></li>
        </ul>
      </div>

      <div>
        <p class="label text-cream/60 m-0 pb-2">Made here</p>
        <ul class="list-none p-0 m-0 space-y-0.5">
          <li>
            <a href="https://werth.design" rel="noopener" class="tap text-[0.92rem] text-cream">
              Built by Werth Design
            </a>
          </li>
          <li><a href="/llms.txt" class="tap text-[0.92rem] text-cream">llms.txt</a></li>
        </ul>
      </div>
    </nav>

    {/* The whole model in one sentence, under the links that demonstrate it. */}
    <p class="mt-8 mb-0 text-[0.86rem] leading-snug text-cream/70 max-w-[62ch]">
      Independent editorial coverage. Sponsorship never changes a listing, a
      ranking, a verification status or a caveat —
      <a href="/advertising/" class="text-cream">the policy is here</a>, written
      before there was anyone to sell to.
    </p>

    <div
      class="mt-7 pt-7 border-t border-tide flex flex-wrap items-start justify-between gap-x-8 gap-y-4"
    >
      <p class="m-0 text-[0.86rem] text-cream-soft max-w-[44ch] leading-[1.55]">
        Matt Werth writes this. Every answer carries the date I got it and the
        name of whoever gave it to me.{" "}
        <a href="/about/" class="text-cream">How that works</a>.
      </p>

      <p class="m-0 stamp text-cream-soft flex items-center gap-2 flex-wrap">
        <FlagMark class="w-[0.5rem] h-[0.62rem] shrink-0 text-ochre" />
        {/* ODbL attribution for the map. It was under the map itself until the
            caption came off; it is a licence condition rather than a courtesy,
            so it needed somewhere permanent rather than deleting. */}
        <span>
          Map data ©{" "}
          <a href="https://www.openstreetmap.org/copyright" rel="noopener nofollow" class="text-cream">
            OpenStreetMap
          </a>{" "}
          contributors
        </span>
        <span aria-hidden="true">·</span>
        © {year} · Built by{" "}
        <a href="https://werth.design" rel="noopener" class="text-cream">Werth Design</a>
      </p>
    </div>
  </div>
</footer>
