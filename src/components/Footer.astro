---
/**
 * Footer. A deep field to close the sheet, and the three things that have to
 * exist from page one because retrofitting them across forty pages later is
 * miserable:
 *
 *   1. Email capture
 *   2. The link to /how-we-verify/ — the differentiator, stated plainly
 *   3. "Built by Werth Design" — this site is a lead-gen asset, not a hobby
 */
import EmailCapture from "./EmailCapture.astro";
import FlagMark from "./FlagMark.astro";

const year = new Date().getFullYear();
---

<footer class="field-deep mt-20 no-print">
  <div class="h-[2px] w-full bg-tide"></div>
  <div class="h-[3px] w-full bg-ochre"></div>

  <div class="wrap py-11">
    <EmailCapture />

    <nav aria-label="Site" class="mt-11 flex flex-wrap gap-x-7 gap-y-0">
      <a href="/dogs/" class="tap text-[0.92rem] text-cream">Dogs</a>
      <a href="/about/" class="tap text-[0.92rem] text-cream">Who writes this</a>
      <a href="/contacts/" class="tap text-[0.92rem] text-cream">Phone numbers</a>
      <a href="/report/" class="tap text-[0.92rem] text-cream">Send a report</a>
      <a href="/about/" class="tap text-[0.92rem] text-cream">How I check it</a>
      <a href="/verified/" class="tap text-[0.92rem] text-cream">Verification index</a>
      <a href="/changed/" class="tap text-[0.92rem] text-cream">What changed</a>
      {/* Merchandise stays subordinate to the publication — a footer link, not
          a nav item, and not called "Shop". If it ever earns primary navigation
          it will be because people are buying, not because it exists. */}
      <a href="/field-marks/" class="tap text-[0.92rem] text-cream">Field Marks</a>
      <a href="/llms.txt" class="tap text-[0.92rem] text-cream">llms.txt</a>
    </nav>

    <div
      class="mt-7 pt-7 border-t border-tide flex flex-wrap items-start justify-between gap-x-8 gap-y-4"
    >
      <p class="m-0 text-[0.86rem] text-cream-soft max-w-[44ch] leading-[1.55]">
        Matt Werth writes this. Every answer carries the date I got it and the
        name of whoever gave it to me.{" "}
        <a href="/about/" class="text-cream">How that works</a>.
      </p>

      <p class="m-0 stamp text-cream-soft flex items-center gap-2 flex-wrap">
        <FlagMark class="w-[0.5rem] h-[0.62rem] shrink-0 text-ochre" />
        {/* ODbL attribution for the map. It was under the map itself until the
            caption came off; it is a licence condition rather than a courtesy,
            so it needed somewhere permanent rather than deleting. */}
        <span>
          Map data ©{" "}
          <a href="https://www.openstreetmap.org/copyright" rel="noopener nofollow" class="text-cream">
            OpenStreetMap
          </a>{" "}
          contributors
        </span>
        <span aria-hidden="true">·</span>
        © {year} · Built by{" "}
        <a href="https://werth.design" rel="noopener" class="text-cream">Werth Design</a>
      </p>
    </div>
  </div>
</footer>
