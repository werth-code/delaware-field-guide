---
/**
 * Dog mark.
 *
 * Previously a hand-drawn geometric dog in the Charley Harper lineage. That was
 * the right intent and the wrong result: built from circles and rounded bars,
 * it read as a crude pictogram at the sizes the pages actually use. Replaced
 * with a properly drawn icon.
 *
 * ICON SOURCE — Lucide (https://lucide.dev), ISC licence.
 *   Copyright (c) for portions of Lucide are held by Cole Bemis 2013-2022 as
 *   part of Feather (MIT). All other copyright (c) for Lucide are held by
 *   Lucide Contributors 2022.
 * ISC permits commercial use and modification; retaining the notice above is
 * the whole obligation. Paths are inlined rather than fetched, so the page
 * still loads nothing from a third party.
 *
 * Stroke weight is absolute against a 24-unit viewBox, so the mark holds at
 * 20px in a list and at 3.4rem on the home page without becoming either a blob
 * or a hairline.
 *
 * Old call sites pass pose="stand" | "run" | "sit"; those all resolve to the
 * paw, which is the one that survives being small.
 */
interface Props {
  pose?: "paw" | "dog" | "stand" | "run" | "sit";
  class?: string;
  /** Soft ochre disc behind the mark, for use on a plain field. */
  collar?: boolean;
}
const { pose = "paw", class: className = "", collar = false } = Astro.props;
const shape = pose === "dog" ? "dog" : "paw";
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {collar && <circle cx="12" cy="12" r="11.1" fill="var(--color-ochre)" opacity="0.16" stroke="none" />}

  {
    shape === "dog" ? (
      <>
        {/* lucide: dog */}
        <path d="M11.25 16.25h1.5L12 17z" />
        <path d="M16 14v.5" />
        <path d="M4.42 11.247A13.152 13.152 0 0 0 4 14.556C4 18.728 7.582 21 12 21s8-2.272 8-6.444a11.702 11.702 0 0 0-.493-3.309" />
        <path d="M8 14v.5" />
        <path d="M8.5 8.5c-.384 1.05-1.083 2.028-2.344 2.5-1.931.722-3.576-.297-3.656-1-.113-.994 1.177-6.53 4-7 1.923-.321 3.651.845 3.651 2.235A7.497 7.497 0 0 1 14 5.277c0-1.39 1.844-2.598 3.767-2.277 2.823.47 4.113 6.006 4 7-.08.703-1.725 1.722-3.656 1-1.261-.472-1.96-1.45-2.344-2.5" />
      </>
    ) : (
      <>
        {/* lucide: paw-print */}
        <circle cx="11" cy="4" r="2" />
        <circle cx="18" cy="8" r="2" />
        <circle cx="20" cy="16" r="2" />
        <path d="M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z" />
      </>
    )
  }
</svg>
