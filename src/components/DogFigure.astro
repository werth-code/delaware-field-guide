---
/**
 * Geometric dogs, in the poster idiom.
 *
 * Circles and rounded bars, in the Charley Harper lineage — the reason these
 * can be dogs without being cute. No big eyes, no tongues, no paw prints. The
 * competing category is built entirely out of those, so not using them is the
 * positioning, same as the copy rule about puns.
 *
 * `currentColor` throughout, with the collar in ochre, so a figure can sit on
 * any field in the palette.
 */
interface Props {
  pose?: "stand" | "run" | "sit";
  class?: string;
  /** Collar on by default — it's what reads "someone's dog" rather than "a dog". */
  collar?: boolean;
}
const { pose = "stand", class: className = "", collar = true } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 112 82"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  {
    pose === "stand" && (
      <>
        <path
          d="M20 30c-6-3-9-10-7-17"
          stroke="currentColor"
          stroke-width="7"
          stroke-linecap="round"
          fill="none"
        />
        <rect x="16" y="28" width="52" height="24" rx="12" />
        <rect x="22" y="46" width="8" height="26" rx="4" />
        <rect x="34" y="46" width="8" height="26" rx="4" />
        <rect x="50" y="46" width="8" height="26" rx="4" />
        <rect x="60" y="46" width="8" height="26" rx="4" />
        <circle cx="76" cy="24" r="13" />
        <rect x="80" y="22" width="21" height="10" rx="5" />
        <path d="M65 12l14-5-4 15z" />
        {collar && <rect x="64" y="27" width="6" height="17" rx="2" fill="var(--color-ochre)" />}
      </>
    )
  }

  {
    pose === "run" && (
      <>
        <path
          d="M18 26c-7-1-12-6-13-13"
          stroke="currentColor"
          stroke-width="7"
          stroke-linecap="round"
          fill="none"
        />
        <rect x="14" y="26" width="54" height="22" rx="11" />
        <rect
          x="18"
          y="42"
          width="8"
          height="27"
          rx="4"
          transform="rotate(24 22 42)"
        />
        <rect
          x="34"
          y="42"
          width="8"
          height="25"
          rx="4"
          transform="rotate(-20 38 42)"
        />
        <rect
          x="52"
          y="42"
          width="8"
          height="27"
          rx="4"
          transform="rotate(22 56 42)"
        />
        <rect
          x="62"
          y="42"
          width="8"
          height="25"
          rx="4"
          transform="rotate(-18 66 42)"
        />
        <circle cx="76" cy="22" r="12.5" />
        <rect x="80" y="20" width="22" height="10" rx="5" />
        <path d="M64 11l15-4-5 15z" />
        {collar && <rect x="64" y="25" width="6" height="16" rx="2" fill="var(--color-ochre)" />}
      </>
    )
  }

  {
    pose === "sit" && (
      <>
        <path
          d="M24 62c-8 1-14-3-16-10"
          stroke="currentColor"
          stroke-width="7"
          stroke-linecap="round"
          fill="none"
        />
        <path d="M26 40h26a14 14 0 0 1 14 14v18H26z" />
        <rect x="26" y="52" width="26" height="20" rx="10" />
        <rect x="56" y="50" width="8" height="22" rx="4" />
        <rect x="66" y="50" width="8" height="22" rx="4" />
        <rect x="58" y="26" width="14" height="28" rx="7" />
        <circle cx="72" cy="20" r="13" />
        <rect x="76" y="18" width="21" height="10" rx="5" />
        <path d="M61 8l14-5-4 15z" />
        {collar && <rect x="60" y="24" width="6" height="16" rx="2" fill="var(--color-ochre)" />}
      </>
    )
  }
</svg>
