---
/**
 * A swipeable strip of a record's photos, on the listing card.
 *
 * WHY
 * A card showed one photo and you had to open the page to learn there were
 * four. Swiping through them in place is the difference between browsing and
 * committing to a page load on a phone with one bar.
 *
 * HOW IT SCROLLS
 * CSS scroll-snap on an overflow-x strip. That is the whole mechanism —
 * momentum, rubber-banding and the swipe itself are the browser's, not mine.
 * A JavaScript carousel would reimplement all of that worse and break when the
 * script fails.
 *
 * WITHOUT JAVASCRIPT it is still a scrollable strip you can swipe. The script
 * only adds the dots and the arrows, and both are hidden until it runs, so
 * nothing dead ships.
 *
 * THE STRETCHED-LINK PROBLEM, AGAIN
 * The card is an <a> covering the whole box at z-10. A horizontal drag inside
 * it would otherwise be read as a tap and navigate mid-swipe. The strip sits
 * above at z-20, and the script suppresses the click that follows a drag —
 * the CardShare button hit the same wall and the fix is the same shape.
 *
 * ONE IMAGE, NO STRIP. A single photo renders as a plain CardPhoto, because
 * dots under one slide is furniture pretending to be a feature.
 */
import type { Photo } from "../lib/state-parks";
import CardPhoto from "./CardPhoto.astro";
import { colorFor } from "../lib/feature-colors";

interface Props {
  photos: Photo[];
  variant?: "top" | "side";
  class?: string;
}
const { photos, variant = "top", class: klass = "" } = Astro.props;
const many = photos.length > 1;
---

{!many && photos[0] && <CardPhoto {...photos[0]} variant={variant} class={klass} />}

{
  many && (
    <div
      class={`card-gallery relative z-20 overflow-hidden bg-tide/15 border-b-2 border-marsh ${klass}`}
      data-gallery
      data-arrows
    >
      <div
        class="flex overflow-x-auto snap-x snap-mandatory scroll-smooth [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
        data-gallery-strip
      >
        {photos.map((p, i) => (
          <img
            src={`/photos/${p.file}-700.jpg`}
            alt={p.alt}
            width={700}
            height={394}
            loading={i === 0 ? "eager" : "lazy"}
            decoding="async"
            style={p.focus ? `object-position:${p.focus}` : undefined}
            class="w-full shrink-0 snap-center block object-cover aspect-[16/9]"
          />
        ))}
      </div>

      {/* Dots. Hidden until the script runs — see the header. */}
      <div
        class="absolute bottom-2 left-1/2 -translate-x-1/2 flex gap-1.5 px-2 py-1 rounded-full bg-abyss/55 backdrop-blur-[2px]"
        data-gallery-dots
        hidden
      >
        {photos.map((_, i) => (
          <span
            class="block w-1.5 h-1.5 rounded-full bg-cream/45 transition-colors duration-150"
            data-gallery-dot={i}
          />
        ))}
      </div>

      <span
        class="absolute top-2 left-2 stamp text-[0.6rem] px-1.5 py-0.5 rounded-[var(--radius-sign)] bg-abyss/55 text-cream"
        style={`border-left:3px solid ${colorFor("beach")}`}
        data-gallery-count
        hidden
      />

      {/* Arrows, for a pointer. The header above promised "dots and the
          arrows" and shipped only dots — a mouse has no swipe, so on a
          desktop the extra photos were unreachable without a page load.
          Revealed on hover of the strip (and on keyboard focus); not shown
          at all where hover doesn't exist, because there the swipe IS the
          affordance and two buttons over a photo are clutter. */}
      <button
        type="button"
        data-gallery-prev
        aria-label="Previous photo"
        hidden
        class="gallery-arrow absolute left-2 top-1/2 -translate-y-1/2 w-9 h-9 grid place-items-center rounded-[var(--radius-sign)] bg-abyss/55 text-cream cursor-pointer border-0"
      >
        <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" aria-hidden="true">
          <path d="M15 4l-8 8 8 8" />
        </svg>
      </button>
      <button
        type="button"
        data-gallery-next
        aria-label="Next photo"
        hidden
        class="gallery-arrow absolute right-2 top-1/2 -translate-y-1/2 w-9 h-9 grid place-items-center rounded-[var(--radius-sign)] bg-abyss/55 text-cream cursor-pointer border-0"
      >
        <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" aria-hidden="true">
          <path d="M9 4l8 8-8 8" />
        </svg>
      </button>
    </div>
  )
}

{/* The arrow chrome (.gallery-arrow) lives in global.css — PhotoStrip grew
    the same arrows and two scoped copies would drift. */}

<script>
  (() => {
    for (const root of document.querySelectorAll("[data-gallery]")) {
      if (root.dataset.bound) continue;
      root.dataset.bound = "1";

      const strip = root.querySelector("[data-gallery-strip]");
      const dots = [...root.querySelectorAll("[data-gallery-dot]")];
      const dotWrap = root.querySelector("[data-gallery-dots]");
      const count = root.querySelector("[data-gallery-count]");
      const prev = root.querySelector("[data-gallery-prev]");
      const next = root.querySelector("[data-gallery-next]");
      const slides = strip.children.length;
      if (!slides) continue;

      dotWrap.hidden = false;
      count.hidden = false;
      prev.hidden = false;
      next.hidden = false;

      let index = 0;
      const paint = () => {
        dots.forEach((d, i) => {
          d.classList.toggle("bg-cream", i === index);
          d.classList.toggle("bg-cream/45", i !== index);
        });
        count.textContent = `${index + 1}/${slides}`;
        /* An arrow pointing at nothing vanishes rather than dims — a disabled
           control over a photograph is one more thing to read. */
        prev.setAttribute("aria-disabled", index === 0 ? "true" : "false");
        next.setAttribute("aria-disabled", index === slides - 1 ? "true" : "false");
      };
      paint();

      /* The arrows drive the same scroll the finger does, so the snap, the
         dots and the count all update through the one scroll listener. */
      const go = (dir) => (e) => {
        e.preventDefault();
        e.stopPropagation();
        const i = Math.min(Math.max(index + dir, 0), slides - 1);
        /* Index and paint update HERE, not in the scroll listener — a second
           click mid-glide should count from where the strip is going, not
           where it happens to be. The listener still owns finger swipes.
           No behavior option on scrollTo: the strip's own scroll-smooth CSS
           drives the easing, exactly as it does for a finger. */
        index = i;
        paint();
        strip.scrollTo({ left: i * strip.clientWidth });
      };
      prev.addEventListener("click", go(-1));
      next.addEventListener("click", go(1));

      strip.addEventListener(
        "scroll",
        () => {
          const i = Math.round(strip.scrollLeft / strip.clientWidth);
          if (i !== index && i >= 0 && i < slides) {
            index = i;
            paint();
          }
        },
        { passive: true },
      );

      /*
       * THE STRIP SITS ABOVE THE CARD'S STRETCHED LINK, so it has to do both
       * jobs itself.
       *
       * A swipe must not navigate: the drag ends in a click and the browser
       * would follow the link the moment you let go. A plain tap MUST
       * navigate, because before this component the photo was part of the
       * link and tapping it opened the record — a photo you can swipe but not
       * tap is worse than the thing it replaced. The first version only did
       * the first half, and tapping a photo did nothing at all.
       */
      const card = root.closest("article") || root.parentElement;
      const link = card && card.querySelector("a[href]");

      let startX = 0;
      let dragged = false;
      strip.addEventListener("pointerdown", (e) => {
        startX = e.clientX;
        dragged = false;
      });
      strip.addEventListener("pointermove", (e) => {
        if (Math.abs(e.clientX - startX) > 6) dragged = true;
      });
      strip.addEventListener("click", (e) => {
        if (dragged) {
          e.preventDefault();
          e.stopPropagation();
          return;
        }
        if (link) {
          e.preventDefault();
          link.click();
        }
      });
    }
  })();
</script>
