---
/**
 * Share.
 *
 * This site has no domain authority and no budget, so word of mouth is the
 * distribution plan. The sharing that actually matters here is not a viral
 * button — it's one person texting a link to the other person planning the
 * trip, and it's someone answering a question in r/DelawareBeaches with a
 * link. Both are built for directly.
 *
 * Plain anchors, no SDKs, no tracking pixels, no third-party JavaScript. A
 * Facebook or X widget would load a tracker onto a page that promises not to,
 * and would be slower than the link it replaces. Every target below is a URL
 * the network publishes for exactly this, so the whole row costs nothing until
 * someone taps it.
 *
 * ICONS, NOT WORDS. This carried nine text labels for a long time on the
 * argument that a row of corporate glyphs is where a page like this starts to
 * look like everybody else's. That argument lost to the row itself: eleven
 * word-buttons wrapped to four lines on a phone and read as a wall of
 * shouting mono, and nobody scans a share row — they look for the one mark
 * they already recognise, which is exactly what a logo is for. Every button
 * keeps its name on aria-label and title, because an icon-only row is opaque
 * to a screen reader unless the name is put back by hand.
 *
 * Progressive enhancement, in this order:
 *   1. On a phone, a native Share button is added AHEAD of the row — it
 *      reaches Messages, WhatsApp and everything else the visitor actually
 *      uses.
 *   2. Copy-link is upgraded to the clipboard API.
 *   3. With no JS at all, every target below is a working link.
 *
 * THE NATIVE BUTTON USED TO REPLACE THE ROW, and that was wrong. Every phone
 * has navigator.share, so on every phone this section was a single unlabelled
 * SHARE button and nothing else — all nine networks hidden behind a sheet the
 * reader has to open to discover. The share sheet is the best path for "send
 * this to whoever is driving" and a poor one for "post this in
 * r/DelawareBeaches", and the second is the half that grows the site. Both are
 * on screen now.
 *
 * NO INSTAGRAM, though it gets asked for. Instagram publishes no web share
 * intent: there is no URL that opens a composer with a link in it, because the
 * platform doesn't carry outbound links in posts at all. A button would either
 * dead-end or just open instagram.com, and a control that doesn't do what it
 * says is worse than an absent one.
 */
import ShareIcon from "./ShareIcon.astro";

interface Props {
  /** Page title — becomes the shared text. */
  title: string;
  /** One line of why it's worth opening. */
  summary?: string;
  /** Heading over the row. */
  heading?: string;
  /** One line telling the reader why to bother. Section-specific. */
  pitch?: string;
  class?: string;
}

const {
  title,
  summary = "",
  heading = "Send this to someone",
  pitch = "Most people find this out the hard way, standing in the wrong parking lot. Save someone the drive.",
  class: className = "",
} = Astro.props;

/* Unique per instance. The id was hardcoded, which is fine for one row on a
   page and produces duplicate ids the moment there are two. */
const hid = `share-${Math.random().toString(36).slice(2, 8)}`;

const url = new URL(Astro.url.pathname, Astro.site).href;
const text = summary ? `${title} — ${summary}` : title;

const enc = encodeURIComponent;

const targets = [
  {
    key: "sms",
    label: "Text",
    // `?&body=` is the form that works on both iOS and Android.
    href: `sms:?&body=${enc(`${text} ${url}`)}`,
    hint: "Send it to whoever is driving",
  },
  {
    key: "email",
    label: "Email",
    href: `mailto:?subject=${enc(title)}&body=${enc(`${text}\n\n${url}`)}`,
    hint: null,
  },
  {
    key: "facebook",
    label: "Facebook",
    href: `https://www.facebook.com/sharer/sharer.php?u=${enc(url)}`,
    hint: null,
  },
  {
    key: "whatsapp",
    label: "WhatsApp",
    href: `https://wa.me/?text=${enc(`${text} ${url}`)}`,
    hint: "The family group chat planning the trip",
  },
  {
    key: "reddit",
    label: "Reddit",
    href: `https://www.reddit.com/submit?url=${enc(url)}&title=${enc(title)}`,
    hint: "r/DelawareBeaches",
  },
  {
    key: "x",
    label: "X",
    href: `https://x.com/intent/post?text=${enc(text)}&url=${enc(url)}`,
    hint: null,
  },
  {
    key: "bluesky",
    // Bluesky takes one text field, so the URL rides inside it.
    label: "Bluesky",
    href: `https://bsky.app/intent/compose?text=${enc(`${text} ${url}`)}`,
    hint: null,
  },
  {
    key: "threads",
    label: "Threads",
    href: `https://www.threads.net/intent/post?text=${enc(`${text} ${url}`)}`,
    hint: null,
  },
  {
    key: "pinterest",
    /* No `media`: Pinterest scrapes the page and lets the pinner choose. Every
       record page carries og:image, so it has something to find. Hardcoding one
       photo here would pin the wrong one on the records with a gallery. */
    label: "Pinterest",
    href: `https://pinterest.com/pin/create/button/?url=${enc(url)}&description=${enc(text)}`,
    hint: "Trip boards — how a lot of this gets planned",
  },
];
---

<section class={`no-print ${className}`} aria-labelledby={hid}>
  <div class="sign px-4 sm:px-5 py-4">
    <p id={hid} class="label m-0">{heading}</p>
    <p class="mt-1.5 mb-3.5 text-[0.9rem] leading-snug text-ink-soft max-w-[52ch]">
      {pitch}
    </p>

    <div
      class="flex flex-wrap gap-2"
      data-share
      data-url={url}
      data-title={title}
      data-text={text}
    >
      {/* Added ahead of the row where a share sheet exists — not instead of it. */}
      <button
        type="button"
        data-share-native
        hidden
        class="tap sign-quiet bg-marsh text-cream border-marsh px-4 gap-2 font-mono text-[0.72rem] font-medium uppercase tracking-[0.09em] cursor-pointer"
      >
        <ShareIcon name="share" />
        Share
      </button>

      <div class="contents" data-share-fallback>
        {
          targets.map((t) => (
            <a
              href={t.href}
              class="tap sign-quiet w-11 justify-center px-0 no-underline text-marsh hover:bg-marsh hover:text-cream"
              rel={t.key === "sms" || t.key === "email" ? undefined : "noopener nofollow"}
              target={t.key === "sms" || t.key === "email" ? undefined : "_blank"}
              aria-label={t.hint ? `${t.label} — ${t.hint}` : t.label}
              title={t.hint ? `${t.label} — ${t.hint}` : t.label}
            >
              <ShareIcon name={t.key} />
            </a>
          ))
        }

        <button
          type="button"
          data-share-copy
          aria-label="Copy link"
          title="Copy link"
          class="tap sign-quiet w-11 justify-center px-0 text-marsh hover:bg-marsh hover:text-cream cursor-pointer relative"
        >
          <span data-copy-idle><ShareIcon name="copy" /></span>
          <span data-copy-done hidden><ShareIcon name="copied" /></span>
          {/* The label used to swap to the word "Copied". With an icon-only
              button there is no label to swap, so the confirmation is a tick
              plus a live region — otherwise a screen reader gets no feedback
              at all that the tap did anything. */}
          <span class="sr-only" data-copy-say aria-live="polite"></span>
        </button>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    for (const root of document.querySelectorAll("[data-share]")) {
      /* is:inline emits this script once per COMPONENT INSTANCE, and each copy
         walks every row on the page. A page with two rows bound every handler
         twice — two share sheets from one tap. Same trap CardShare documents. */
      if (root.dataset.bound) continue;
      root.dataset.bound = "1";
      const url = root.dataset.url;
      const title = root.dataset.title;
      const text = root.dataset.text;

      // 1. Native share sheet. On a phone this reaches Messages, WhatsApp and
      //    everything else, which is where these links actually travel.
      const native = root.querySelector("[data-share-native]");
      const fallback = root.querySelector("[data-share-fallback]");
      if (navigator.share && native) {
        native.hidden = false;
        native.addEventListener("click", async () => {
          /* Swallowed on purpose: the only failures here are the reader
             cancelling the sheet and a browser refusing it, and in both cases
             every explicit target is still sitting right there. */
          try {
            await navigator.share({ title, text, url });
          } catch {}
        });
      }

      // 2. Copy link.
      const copy = root.querySelector("[data-share-copy]");
      const idle = copy?.querySelector("[data-copy-idle]");
      const done = copy?.querySelector("[data-copy-done]");
      const say = copy?.querySelector("[data-copy-say]");
      const show = (ok) => { if (idle) idle.hidden = ok; if (done) done.hidden = !ok; };
      copy?.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(url);
          show(true);
          if (say) say.textContent = "Link copied";
          setTimeout(() => { show(false); if (say) say.textContent = ""; }, 2000);
        } catch {
          /* Clipboard refused — insecure context, or permission denied.
             Putting the raw URL in the button label was the old fallback and
             it stretched the row to the width of the link. Select it in an
             off-screen field instead, so the keyboard shortcut works. */
          const field = document.createElement("input");
          field.value = url;
          field.setAttribute("readonly", "");
          field.style.cssText = "position:fixed;top:0;left:-9999px";
          document.body.appendChild(field);
          field.select();
          field.setSelectionRange(0, url.length);
          if (say) say.textContent = "Press Command C to copy the link";
          setTimeout(() => {
            field.remove();
            if (say) say.textContent = "";
          }, 4000);
        }
      });
    }
  })();
</script>
