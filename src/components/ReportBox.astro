---
import ReportPhotos from "./ReportPhotos.astro";
/**
 * Field report — "you were just there, tell us what you saw".
 *
 * This is the site's actual growth mechanism. Most of the dataset is marked
 * unconfirmed and the call sheet is 69 items long; someone standing in the
 * parking lot with a phone can close a gap faster than a round of phone calls
 * can. So the ask goes on EVERY entry, next to the gaps, rather than on a
 * contact page nobody visits.
 *
 * IT IS NOT COMMENTS. Nothing submitted here appears on the site. A report
 * arrives, a person reads it, and if it's usable it becomes a dated fact with
 * `acceptedOn` set — the same bar as anything else. That's why the form says
 * what happens next: a reader who thinks they're posting publicly will write
 * something different from one who knows they're filing a correction.
 *
 * Works with no endpoint configured: falls back to a prefilled mailto, which
 * needs no service, no JavaScript and no third party. Set
 * PUBLIC_REPORT_ENDPOINT to a form service (Formspree, Basin) to collect them
 * properly.
 */
interface Props {
  /** What is being reported on, e.g. "Swallow Falls". */
  subject: string;
  /** Path of the page, so a report can be traced back to what it was about. */
  path: string;
  /**
   * Short reader-facing questions, DERIVED FROM THE DATA — never the internal
   * `outstanding` list, which is written for whoever makes the phone calls.
   * Tapping one drops it into the box.
   */
  asks?: string[];
}

const { subject, path, asks = [] } = Astro.props;

const endpoint = import.meta.env.PUBLIC_REPORT_ENDPOINT ?? "";
const mailto = `mailto:reports@delawarefieldguide.com?subject=${encodeURIComponent(
  `Field report: ${subject}`,
)}&body=${encodeURIComponent(
  `What I saw:\n\n\nWhen I was there (date):\n\n\nAbout: ${subject} (${path})\n`,
)}`;

const id = `report-${path.replace(/[^a-z0-9]+/gi, "-")}`;
---

<section class="sign breakout my-8 px-4 sm:px-5 py-5 border-l-[9px] border-l-ochre-deep" aria-labelledby={`${id}-h`}>
  <p class="label m-0 text-ochre-deep">Were you just there?</p>
  <h2 id={`${id}-h`} class="font-display text-[1.3rem] font-semibold tracking-[-0.03em] mt-2 mb-0 text-marsh max-w-[26ch]">
    Tell us what you saw
  </h2>
  <p class="mt-2 mb-0 text-[0.95rem] leading-[1.5] max-w-[52ch]">
    Anything you noticed. If it's wrong or it's changed, this is the fastest fix.
  </p>

  {
    asks.length > 0 && (
      <div class="mt-4">
        <p class="label m-0">Still open — tap one</p>
        {/* Full width and left-aligned on a phone: these wrap to two lines,
            and a centred 44px-tall pill of wrapped text reads as stray copy
            rather than a control. Inline pills once there's room for them. */}
        <ul class="list-none p-0 m-0 mt-2 flex flex-col sm:flex-row sm:flex-wrap gap-1.5">
          {asks.map((q) => (
            <li class="contents sm:block">
              <button
                type="button"
                data-ask={q}
                class="tap w-full sm:w-auto justify-start text-left bg-shell border-2 border-marsh/25 hover:border-marsh hover:bg-marsh hover:text-cream px-3 py-2 text-[0.88rem] text-marsh leading-snug"
              >
                {q}
              </button>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <form
    class="mt-4"
    method="POST"
    action={endpoint || undefined}
    data-report-photo-form={endpoint ? "" : undefined}
  >
    <input type="hidden" name="page" value={path} />
    <input type="hidden" name="subject" value={subject} />
    {/* Bot trap. A real person never fills a hidden field. */}
    <p class="hidden" aria-hidden="true">
      <label>Leave this empty <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
    </p>

    <label class="label block" for={`${id}-what`}>What did you see?</label>
    <textarea
      id={`${id}-what`}
      name="report"
      rows="3"
      required
      maxlength="1200"
      placeholder="The restrooms by the boat launch were open and clean."
      class="block w-full max-w-full min-w-0 mt-1.5 bg-shell border-2 border-marsh px-3 py-2.5 text-[16px] sm:text-[0.98rem] text-ink placeholder:text-ink-soft focus:outline-none focus:ring-2 focus:ring-ochre"
    ></textarea>

    {/* A photograph is the one thing a reader can give this site that no
        amount of ringing the operator produces, and this box — the one on
        nine different kinds of page — couldn't take one. */}
    <ReportPhotos id={`${id}-photos`} class="mt-3" />

    <div class="mt-3 grid gap-3 sm:grid-cols-2">
      <div class="min-w-0">
        <label class="label block" for={`${id}-when`}>When were you there?</label>
        <input
          id={`${id}-when`}
          name="visited"
          type="date"
          required
          class="block w-full max-w-full min-w-0 mt-1.5 bg-shell border-2 border-marsh px-3 py-2.5 text-[16px] sm:text-[0.98rem] text-ink focus:outline-none focus:ring-2 focus:ring-ochre"
        />
      </div>
      <div class="min-w-0">
        <label class="label block" for={`${id}-email`}>Email <span class="normal-case tracking-normal text-ink-soft">(optional)</span></label>
        <input
          id={`${id}-email`}
          name="email"
          type="email"
          maxlength="120"
          placeholder="If we may follow up"
          class="block w-full max-w-full min-w-0 mt-1.5 bg-shell border-2 border-marsh px-3 py-2.5 text-[16px] sm:text-[0.98rem] text-ink placeholder:text-ink-soft focus:outline-none focus:ring-2 focus:ring-ochre"
        />
      </div>
    </div>

    <div class="mt-4 flex flex-wrap items-center gap-3">
      <button
        type="submit"
        class="tap bg-marsh text-cream border-2 border-marsh px-5 py-2.5 font-mono text-[0.78rem] uppercase tracking-[0.1em] font-medium hover:bg-ink"
      >
        Send report
      </button>
      {
        !endpoint && (
          <a href={mailto} class="stamp text-ink-soft">or email it instead</a>
        )
      }
    </div>

    <p class="mt-3.5 mb-0 text-[0.83rem] leading-snug text-ink-soft max-w-[54ch]">
      Not published. A person reads it, and if I can use it, it becomes a
      dated fact here. <a href="/about/">How that works</a>.
    </p>

    <p class="mt-3 mb-0 text-[0.86rem] hidden" data-report-status role="status"></p>
  </form>
  <p class="stamp text-ink-soft mt-3 mb-0">
    Got a photograph? <a href="/report/">The full form takes up to four</a>.
  </p>
</section>

<script>
  /*
   * Two jobs, and the first must work whether or not a form endpoint is
   * configured — hence one unconditional script rather than one gated on it.
   *
   * 1. Tapping an open question drops it into the box and puts the cursor
   *    after it. The question stays in the text so the report arrives with its
   *    own context: "Are dogs allowed? — yes, on lead, saw signs at the gate"
   *    needs no interpreting at the other end.
   * 2. If an endpoint IS set, submit in place so the reader isn't thrown to a
   *    third-party thank-you page.
   */
  document.querySelectorAll("[data-ask]").forEach((button) => {
    button.addEventListener("click", () => {
      const form = button.closest("section").querySelector("form");
      const box = form.querySelector("textarea");
      const q = button.dataset.ask;
      const existing = box.value.trim();
      box.value = existing ? `${existing}\n${q} — ` : `${q} — `;
      box.focus();
      box.setSelectionRange(box.value.length, box.value.length);
      button.setAttribute("aria-pressed", "true");
    });
  });

  /* The submit handler that lived here has moved into ReportPhotos, which
     needs to intercept the same event to resize the photographs before they
     go. Two handlers on one form sent the report twice. */
</script>
