---
/**
 * One glyph per feature.
 *
 * WHY ICONS CARRY IDENTITY AND COLOR DOESN'T
 *
 * The obvious move is a color per feature — blue for water, green for camping,
 * and so on. It doesn't work here, for two reasons.
 *
 * The first is that this site has already spent its color budget on something
 * more important. Green, amber and red mean confirmed, unknown and warning,
 * everywhere, on every page. That convention is the reason a reader can trust
 * a glance. Handing those same hues a second job — "green now also means
 * camping" — would spend the one thing the design has that's worth having.
 *
 * The second is that nobody memorises twelve colors. Four or five, maybe. Past
 * that a legend becomes a lookup table, and a lookup table at 11px on a phone
 * in the sun is decoration. A tent, though, is a tent. Shapes are recognized
 * pre-attentively and they survive grayscale, low contrast, and a cracked
 * screen — which is where these pages actually get read.
 *
 * So: the glyph says WHICH, and color stays reserved for HOW SURE.
 *
 * The one concession is `emphasis`. Restrooms, drinking water and showers get
 * a heavier chip, because the whole site is organized around the fact that
 * those three decide whether a trip works with a four-year-old or an older
 * dog. That's still color meaning "this is the load-bearing one" rather than
 * color meaning "this is plumbing".
 *
 * Blunt geometry and a heavy stroke, matching FlagIcon. Thin lines disappear
 * at the size these render.
 */
export type FeatureKey =
  | "waterfall" | "beach" | "swimming" | "restrooms" | "picnic" | "showers"
  | "camping" | "cabins" | "trails" | "boatLaunch" | "boatRentals" | "fishing"
  | "winterUse" | "petsAllowed" | "playground" | "water" | "shade" | "pavilion"
  | "grills" | "sports" | "pavedPath" | "discGolf" | "skate" | "dogPark"
  | "pier" | "guardedSwimming" | "surfFishing"
  | "free" | "giftShop" | "accessible" | "branches" | "stables" | "parking"
  /* Situations rather than facilities — see feature-colors.ts. */
  | "rainyDay" | "outOfState" | "kidFriendly" | "feeCharged"
  /* Navigation, not features. */
  | "ask" | "phone" | "home"
  | "fenced" | "paved" | "indoors"
  | "paddling" | "crabbing" | "waterPark" | "ropesCourse"
  | "climbingWall" | "tennis" | "golf" | "horseTrails";

interface Props {
  icon: FeatureKey;
  class?: string;
  style?: string;
}
const { icon, class: className = "", style } = Astro.props;
---

<svg
  class={className}
  style={style}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2.2"
  stroke-linecap="square"
  stroke-linejoin="miter"
  aria-hidden="true"
  focusable="false"
>
  {/* Water — a fall over a lip, then the pool. */}
  {icon === "waterfall" && (<><path d="M5 4h6" /><path d="M8 4v10" /><path d="M14 4h5" /><path d="M16.5 4v10" /><path d="M3 18h18" /><path d="M3 21h18" /></>)}
  {icon === "beach" && (<><path d="M3 11a9 7 0 0 1 18 0Z" /><path d="M12 11v7" /><path d="M3 21c3-2 5 2 8 0s5-2 8 0" /></>)}
  {icon === "swimming" && (<><path d="M3 15c3-2 5 2 8 0s5-2 8 0" /><path d="M3 20c3-2 5 2 8 0s5-2 8 0" /><circle cx="16" cy="6" r="2.2" /><path d="M5 11l6-2 4 2" /></>)}
  {icon === "guardedSwimming" && (<><path d="M3 17c3-2 5 2 8 0s5-2 8 0" /><path d="M3 21h18" /><path d="M12 3v8" /><path d="M8 6h8" /></>)}
  {icon === "fishing" && (<><path d="M4 6l10 10" /><path d="M4 6v4" /><path d="M14 16c3 0 5-2 6-4-1-2-3-4-6-4-3 2-3 6 0 8Z" /><path d="M17 11h.01" stroke-width="2.6" /></>)}
  {icon === "surfFishing" && (<><path d="M4 5l9 11" /><path d="M3 20c3-2 5 2 8 0s5-2 8 0" /><path d="M13 16h7" /></>)}
  {icon === "boatLaunch" && (<><path d="M3 17h18l-3 4H6l-3-4Z" /><path d="M12 4v13" /><path d="M12 6l6 4-6 3" /></>)}
  {icon === "boatRentals" && (<><path d="M3 16h18l-3 5H6l-3-5Z" /><path d="M6 16V9h12v7" /><path d="M9 9V5h6v4" /></>)}
  {/* A deck running OUT over water, drawn in perspective. Three evenly spaced
      verticals under a rail read as the playground ladder at small sizes, and
      both are state-park facilities. */}
  {icon === "pier" && (<><path d="M3 7h12" /><path d="M3 13h12" /><path d="M15 4v12" /><path d="M6 13v4" /><path d="M12 13v4" /><path d="M2 21c3-2 5 2 8 0s5-2 8 0" /></>)}

  {/* Comfort — the ones that decide whether the trip works. */}
  {icon === "restrooms" && (<><path d="M7 4v16" /><path d="M4 8h6" /><path d="M17 4v16" /><path d="M14 20h6" /><path d="M12 3v18" /></>)}
  {icon === "water" && (<><path d="M12 3c4 5 6 8 6 11a6 6 0 0 1-12 0c0-3 2-6 6-11Z" /></>)}
  {icon === "showers" && (<><path d="M4 6h10a6 6 0 0 1 6 6H4Z" /><path d="M7 16v3" /><path d="M12 16v3" /><path d="M17 16v3" /></>)}
  {icon === "picnic" && (<><path d="M3 6h18" /><path d="M6 6l-2 15" /><path d="M18 6l2 15" /><path d="M5 14h14" /></>)}
  {icon === "shade" && (<><circle cx="12" cy="9" r="6.5" /><path d="M12 15.5V21" /><path d="M8 21h8" /></>)}
  {icon === "pavilion" && (<><path d="M2 10 12 3l10 7" /><path d="M5 10v11" /><path d="M19 10v11" /><path d="M5 21h14" /></>)}
  {icon === "grills" && (<><path d="M4 10a8 6 0 0 1 16 0Z" /><path d="M5 12h14l-3 5H8l-3-5Z" /><path d="M9 17l-2 4" /><path d="M15 17l2 4" /></>)}

  {/* Stay. */}
  {icon === "camping" && (<><path d="M12 4 3 20h18L12 4Z" /><path d="M12 12l-4 8" /><path d="M12 12l4 8" /></>)}
  {icon === "cabins" && (<><path d="M3 11 12 4l9 7" /><path d="M5 11v10h14V11" /><path d="M10 21v-6h4v6" /></>)}

  {/* Do. */}
  {/* A signpost, not a winding line. A curve reads as a ">" at 13px, which is
      the size these actually render — the whole point of the set is that the
      shape survives being small. */}
  {icon === "trails" && (<><path d="M12 3v18" /><path d="M12 6h8v3.5h-8" /><path d="M12 12H4v3.5h8" /></>)}
  {(icon === "pavedPath" || icon === "paved") && (<><path d="M7 21 10 3" /><path d="M17 21 14 3" /><path d="M11 6h2" /><path d="M10 12h4" /><path d="M9 18h6" /></>)}
  {/* A horseshoe, open end down. The obvious alternative was a horse, and a
      horse at 16px is a blob — the shoe reads at any size and means one
      thing. */}
  {/* A cloud with rain under it. The first draft of this was an umbrella and
      it had to go: `beach` is a parasol, so on the map filter row "Dog
      beaches" and "Museums & libraries" wore the same mark in two colours.
      Colour alone carrying the difference is exactly what this icon set exists
      to avoid. Nothing else on the site is a cloud. */}
  {/* Nav marks. A magnifier for Ask rather than a question mark, because the
      page is a search and a question mark is what a browser puts next to
      "help". */}
  {icon === "ask" && (<><circle cx="11" cy="11" r="6.5" /><path d="M16 16l4.5 4.5" /></>)}
  {icon === "phone" && (<path d="M6 3h4l2 5-3 2a12 12 0 0 0 5 5l2-3 5 2v4a2 2 0 0 1-2 2A17 17 0 0 1 4 5a2 2 0 0 1 2-2Z" />)}
  {icon === "home" && (<><path d="M4 11 12 4l8 7" /><path d="M6 10v10h12V10" /></>)}
  {/* A paddle over water — not the boat launch's ramp, because putting a
      kayak in and backing a trailer down are different afternoons. */}
  {/* A hull and a paddle. The first draft was a paddle over two wave lines,
      and two wave lines is `guardedSwimming` — which sits on the same
      state-park facility grid. The waves are gone; the boat carries it. */}
  {icon === "paddling" && (<><path d="M3 15c4 4 14 4 18 0" /><path d="M3 15c4-3 14-3 18 0" /><path d="M4 4l16 8" /><path d="M3 3l2.5 1.2" /><path d="M21 13l-2.5-1.2" /></>)}
  {icon === "crabbing" && (<><ellipse cx="12" cy="13" rx="5" ry="4" /><path d="M7 11L3 8" /><path d="M17 11l4-3" /><path d="M8 16l-3 3" /><path d="M16 16l3 3" /><path d="M10 9V6" /><path d="M14 9V6" /></>)}
  {icon === "waterPark" && (<><path d="M6 20V8a3 3 0 0 1 6 0" /><path d="M6 12h6" /><path d="M14 20c2-2 4-6 4-9" /><path d="M3 20h18" /></>)}
  {icon === "ropesCourse" && (<><path d="M5 3v18" /><path d="M19 3v18" /><path d="M5 8h14" /><path d="M5 14c4 3 10 3 14 0" /></>)}
  {/* An overhanging face, not a framed rectangle — a rectangle with things
      inside it is `parking`. The lean is what says climbing wall. */}
  {icon === "climbingWall" && (<><path d="M6 21V6l12-3v6l-6 2v10" /><circle cx="9" cy="9" r="1.1" /><circle cx="14" cy="6.5" r="1.1" /><circle cx="9" cy="15" r="1.1" /><path d="M3 21h18" /></>)}
  {icon === "tennis" && (<><ellipse cx="9" cy="9" rx="5" ry="5" /><path d="M5.5 5.5l7 7" /><path d="M12.5 5.5l-7 7" /><path d="M13 13l7 8" /></>)}
  {icon === "golf" && (<><path d="M9 21V3l9 4-9 4" /><path d="M5 21h9" /></>)}
  {icon === "horseTrails" && (<><path d="M5 21v-7a4 4 0 0 1 4-4h3l4-5v6a10 10 0 0 1-3 7v3" /><path d="M12 10V6" /></>)}
  {(icon === "rainyDay" || icon === "indoors") && (<><path d="M7 15a4 4 0 0 1 .5-8 5.5 5.5 0 0 1 10.4 1.6A3.4 3.4 0 0 1 17.5 15Z" /><path d="M8.5 18.5 7.5 21" /><path d="M12.5 18.5 11.5 21" /><path d="M16.5 18.5 15.5 21" /></>)}
  {/* A line being crossed. The first version ran the border the full height,
      which gave it the same silhouette as `trails` — a signpost on a tall
      vertical post — and at 14px on the contacts page the two were the same
      mark in two colours. The border is a short dash in the middle now and the
      arrow runs the full width, so the shape reads horizontal where the
      signpost reads vertical. Same failure the umbrella had against the beach
      parasol; colour must never be the only thing telling two marks apart. */}
  {icon === "outOfState" && (<><path d="M12 6v12" stroke-dasharray="2.5 3" /><path d="M3 12h18" /><path d="M16 8l4 4-4 4" /></>)}
  {/* Two figures, one small. A balloon or a teddy would have been cuter and
      would also have meant "toys" rather than "the children will be fine". */}
  {icon === "kidFriendly" && (<><circle cx="8" cy="6" r="2.4" /><path d="M8 9v7" /><path d="M5 12h6" /><path d="M6 21l2-5 2 5" /><circle cx="17" cy="11" r="1.8" /><path d="M17 13v4" /><path d="M15 15h4" /><path d="M15.5 21l1.5-4 1.5 4" /></>)}
  {/* A ticket. Currency signs are national and this is the mark that has to
      read the same to somebody from Maryland. */}
  {icon === "feeCharged" && (<><path d="M3 8h18v3a2 2 0 0 0 0 4v3H3v-3a2 2 0 0 0 0-4Z" /><path d="M10 8v10" stroke-dasharray="2.5 2.5" /></>)}
  {/* A fence. `dogPark` is the paw-and-ground mark; this is the one fact
      about a dog park that decides whether the trip works. */}
  {icon === "fenced" && (<><path d="M4 21V8l3-3 3 3v13" /><path d="M14 21V8l3-3 3 3v13" /><path d="M2 11h20" /><path d="M2 16h20" /></>)}
  {icon === "stables" && (<><path d="M7 20v-6a5 5 0 0 1 10 0v6" /><path d="M5 20h4" /><path d="M15 20h4" /></>)}
  {icon === "playground" && (<><path d="M6 21V7" /><path d="M10 21V7" /><path d="M6 11h4" /><path d="M6 15h4" /><path d="M10 7c6 1 8 7 8 14" /><path d="M4 21h16" /></>)}
  {/* Goalposts, not a ball. A ball is a circle with marks inside it and so is
      `free` — at 14px they were the closest pair in the whole set by a wide
      margin, and the two appear together on a community park card. */}
  {icon === "sports" && (<><path d="M4 4v10" /><path d="M20 4v10" /><path d="M4 6h16" /><path d="M3 21h18" /><path d="M8 14h8" /></>)}
  {/* The chains and the cage, not the rim. The rim alone was a dome on a post
      — the same silhouette as `beach`, which is a parasol on a post, and the
      two sit on the same state-park facility grid. */}
  {icon === "discGolf" && (<><path d="M5 6h14" /><path d="M7 6v6" /><path d="M12 6v6" /><path d="M17 6v6" /><path d="M6 12h12" /><path d="M12 12v9" /><path d="M8 21h8" /></>)}
  {icon === "skate" && (<><path d="M3 13h18" /><path d="M5 13v3" /><path d="M19 13v3" /><circle cx="7.5" cy="18" r="2" /><circle cx="16.5" cy="18" r="2" /></>)}
  {icon === "winterUse" && (<><path d="M12 3v18" /><path d="M4 7.5l16 9" /><path d="M20 7.5l-16 9" /></>)}

  {/* Indoors. */}
  {icon === "free" && (<><circle cx="12" cy="12" r="8.5" /><path d="M9 8.5h6" /><path d="M9 12h5" /><path d="M11 8.5v8" /></>)}
  {icon === "giftShop" && (<><path d="M3 9h18v12H3z" /><path d="M3 9l2-5h14l2 5" /><path d="M12 9v12" /></>)}
  {icon === "parking" && (<><rect x="3.5" y="3.5" width="17" height="17" rx="2.5" /><path d="M9.5 17V8h3.2a2.6 2.6 0 0 1 0 5.2H9.5" /></>)}
  {icon === "accessible" && (<><circle cx="12" cy="5" r="2.2" /><path d="M12 9v5h5" /><path d="M8 12a5 5 0 1 0 7 6" /></>)}
  {icon === "branches" && (<><path d="M12 3v8" /><path d="M5 21v-6a7 7 0 0 1 14 0v6" /><path d="M12 15v6" /></>)}

  {/* Dogs. */}
  {icon === "petsAllowed" && (<><ellipse cx="12" cy="16" rx="5" ry="4" /><circle cx="6" cy="9" r="2.2" /><circle cx="11" cy="6" r="2.2" /><circle cx="17" cy="9" r="2.2" /></>)}
  {icon === "dogPark" && (<><ellipse cx="12" cy="15" rx="4.5" ry="3.5" /><circle cx="6.5" cy="9" r="2" /><circle cx="17.5" cy="9" r="2" /><path d="M3 21h18" /></>)}
</svg>
