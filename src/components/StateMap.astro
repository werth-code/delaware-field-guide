---
/**
 * Delaware, with everything on it.
 *
 * WHY IT IS AN SVG AND NOT A MAP LIBRARY
 * Leaflet or Mapbox would mean third-party JavaScript and tile requests to
 * somebody else's server on every page view, on a site whose method page
 * promises no trackers. The state is a simple enough shape to draw, and the
 * only thing that has to be accurate is where the dots sit relative to it.
 *
 * THE OUTLINE is traced from real coordinates: the Twelve-Mile Circle around
 * the New Castle courthouse, the Mason-Dixon tangent line down the west side,
 * the transpeninsular line along the bottom, and the bay and Atlantic shores
 * back up. Its bounds land within a few hundredths of a degree of Delaware's
 * actual extents.
 *
 * THE PROJECTION is equirectangular with longitude scaled by cos(latitude).
 * Over one small state that is accurate to well under a pixel, and it needs no
 * library at all.
 *
 * HOW PRECISE THE DOTS ARE, honestly: `site` means the place itself, `town`
 * means the town center because I could not pin the building. At this scale a
 * mile is about six pixels, so a town-centre dot is right to within the size
 * of the dot. Each record carries which it is, and the key says so.
 */
import { colorFor } from "../lib/feature-colors";
import { ROADS, COUNTY_LINES } from "../lib/map-geometry";
import FeatureIcon from "./FeatureIcon.astro";

export interface MapPoint {
  slug: string;
  name: string;
  href: string;
  kind: string;
  lat: number;
  lon: number;
  precision: "site" | "town";
  /** One line, so the card can say what the place is before you commit. */
  blurb?: string;
  /** Photo basename, if the record has one. */
  photo?: string | null;
  /**
   * The photo's focal point. The card thumb crops to 16:9, and a lot of these
   * are portrait shots of waterfalls — without this the crop takes the middle
   * and loses the thing the photo is of.
   */
  focus?: string | null;
  /** Where it is, in words. */
  where?: string;
  /** Which county, for the county filter. */
  county?: string;
}

interface Props {
  points: MapPoint[];
  /** Filter groups: the kind values, in the order they should appear. */
  kinds: { key: string; label: string; color: string }[];
  /** County filter. Omit on a one-county map. */
  counties?: { key: string; label: string; color: string }[];
  /** Which counties start switched on. Defaults to all of them. */
  startWith?: string[];
  class?: string;
}
const { points, kinds, counties = [], startWith, class: klass = "" } = Astro.props;

/* Traced from real coordinates — see the header. */
const OUTLINE: [number, number][] = [[-75.6931, 38.4515], [-75.7887, 39.58], [-75.7856, 39.6116], [-75.7891, 39.6222], [-75.7917, 39.6329], [-75.7934, 39.6437], [-75.7943, 39.6546], [-75.7942, 39.6656], [-75.7933, 39.6765], [-75.7914, 39.6873], [-75.7887, 39.698], [-75.7852, 39.7086], [-75.7807, 39.7189], [-75.7755, 39.7291], [-75.7694, 39.7389], [-75.7625, 39.7485], [-75.7549, 39.7577], [-75.7465, 39.7665], [-75.7374, 39.7749], [-75.7277, 39.7828], [-75.7173, 39.7903], [-75.7063, 39.7972], [-75.6948, 39.8036], [-75.6828, 39.8094], [-75.6704, 39.8146], [-75.6575, 39.8192], [-75.6443, 39.8232], [-75.6308, 39.8266], [-75.6171, 39.8292], [-75.6031, 39.8312], [-75.5891, 39.8326], [-75.5749, 39.8332], [-75.5607, 39.8332], [-75.5466, 39.8325], [-75.5325, 39.8311], [-75.5186, 39.829], [-75.5049, 39.8262], [-75.4914, 39.8228], [-75.4782, 39.8188], [-75.4654, 39.8141], [-75.453, 39.8088], [-75.4411, 39.8029], [-75.4296, 39.7964], [-75.416, 39.79], [-75.462, 39.73], [-75.51, 39.69], [-75.57, 39.66], [-75.59, 39.57], [-75.58, 39.47], [-75.5, 39.33], [-75.39, 39.22], [-75.42, 39.16], [-75.4, 39.06], [-75.3, 38.93], [-75.3, 38.86], [-75.17, 38.8], [-75.09, 38.79], [-75.076, 38.721], [-75.055, 38.61], [-75.049, 38.4515]];

const LATS = OUTLINE.map((p) => p[1]);
const LONS = OUTLINE.map((p) => p[0]);
const PAD = 0.04;
const minLat = Math.min(...LATS) - PAD, maxLat = Math.max(...LATS) + PAD;
const minLon = Math.min(...LONS) - PAD, maxLon = Math.max(...LONS) + PAD;

/* Longitude compresses as you go north; without this Delaware comes out fat. */
const K = Math.cos((((minLat + maxLat) / 2) * Math.PI) / 180);
const W = (maxLon - minLon) * K;
const H = maxLat - minLat;
const SCALE = 1000 / H;

const x = (lon: number) => (lon - minLon) * K * SCALE;
const y = (lat: number) => (maxLat - lat) * SCALE;

const clipId = `outline-${Math.abs([...OUTLINE.flat()].reduce((a, n) => (a * 31 + n * 1000) | 0, 7)).toString(36)}`;

const path = OUTLINE.map((p, i) => `${i ? "L" : "M"}${x(p[0]).toFixed(1)} ${y(p[1]).toFixed(1)}`).join(" ") + " Z";
const vw = Math.ceil(W * SCALE);
---

<figure class={`sign breakout m-0 ${klass}`} data-statemap>
  <div class="px-4 sm:px-5 pt-4 pb-2 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <p class="label m-0">Everything, on the state</p>
    <p class="stamp text-ink-soft m-0" data-map-count />
  </div>

  {/* County first, because it's the coarser cut and it's how people think
      about where they are. Hidden until the script runs — the map itself
      works without either row. */}
  {counties.length > 1 && (
    <ul
      class="list-none px-4 sm:px-5 pb-2 m-0 flex flex-wrap gap-1.5"
      data-map-counties
      data-start={JSON.stringify(startWith ?? counties.map((c) => c.key))}
      hidden
    >
      {counties.map((c) => (
        <li>
          <button
            type="button"
            data-map-county={c.key}
            data-fc={c.color}
            aria-pressed="false"
            class="map-chip tap inline-flex items-center px-3 py-2 stamp text-[0.7rem] leading-none border-2 rounded-[var(--radius-sign)] cursor-pointer"
          >
            {c.label}
          </button>
        </li>
      ))}
    </ul>
  )}

  {/* Filters. Hidden until the script runs — the map itself works without. */}
  <ul class="list-none px-4 sm:px-5 pb-3 m-0 flex flex-wrap gap-1.5" data-map-filters hidden>
    {kinds.map((k) => (
      <li>
        <button
          type="button"
          data-map-kind={k.key}
          data-fc={k.color}
          aria-pressed="true"
          class="map-chip tap inline-flex items-center gap-1.5 px-2.5 py-1.5 stamp text-[0.68rem] leading-none border rounded-[var(--radius-sign)] cursor-pointer"
        >
          <FeatureIcon icon={k.key as any} class="w-[1.15em] h-[1.15em] shrink-0" />
          {k.label}
        </button>
      </li>
    ))}
  </ul>

  <div class="relative px-3 sm:px-4 pb-4">
    <svg
      viewBox={`0 0 ${vw} 1000`}
      class="w-full h-auto max-w-[27rem] mx-auto block"
      role="img"
      aria-label={`Map of Delaware showing ${points.length} places`}
    >
      <defs>
        <clipPath id={clipId}>
          <path d={path} />
        </clipPath>
      </defs>

      <path d={path} fill="var(--color-shell)" stroke="var(--color-marsh)" stroke-width="4" stroke-linejoin="round" />

      {/*
        The two county lines, under the roads so a road never appears to stop
        at a county boundary. Dashed and thin: this is an administrative fact
        about the filter buttons above, not a thing you can see from the car,
        and it should not compete with the roads that are.

        Each line takes the colour of the county on its SOUTHERN side, so a
        line's colour names the county it opens onto as you read down the
        state, in the same colours as the filter buttons above it: cross the
        green line and you are in Kent, cross the blue one and you are in
        Sussex. New Castle's red never appears, because nothing lies north of
        New Castle to cross into it from — one colour cannot stand for both
        sides of a boundary, and pretending otherwise would be the kind of
        thing that needs a legend.
      */}
      <g clip-path={`url(#${clipId})`} fill="none" stroke-linecap="round" stroke-linejoin="round">
        {COUNTY_LINES.map((line) => {
          const d = line.pts.map((c, i) => `${i ? "L" : "M"}${x(c[0]).toFixed(1)} ${y(c[1]).toFixed(1)}`).join(" ");
          return (
            <path
              d={d}
              stroke={counties.find((c) => c.key === line.between[1])?.color ?? "var(--color-marsh)"}
              stroke-width="2.5"
              stroke-dasharray="9 7"
              opacity="0.55"
            />
          );
        })}
      </g>

      {/*
        Major roads, clipped to the outline by the SVG rather than by
        trimming the geometry — the traced outline is coarse in places and
        a point-in-polygon test threw away most of a real motorway.
        Two passes: a wide casing in the paper colour, then the line, so
        roads read as roads where they cross each other.
      */}
      <g clip-path={`url(#${clipId})`} fill="none" stroke-linecap="round" stroke-linejoin="round">
        {ROADS.map((r) => {
          const d = r.pts.map((c, i) => `${i ? "L" : "M"}${x(c[0]).toFixed(1)} ${y(c[1]).toFixed(1)}`).join(" ");
          const major = r.ref.startsWith("I ");
          return (
            <>
              <path d={d} stroke="var(--color-shell)" stroke-width={major ? 7 : 5} opacity="0.9" />
              <path d={d} stroke="var(--color-marsh)" stroke-width={major ? 3 : 1.6} opacity={major ? 0.55 : 0.32} />
            </>
          );
        })}
      </g>

      {/* Pea Patch Island. Drawn because Fort Delaware is on it, and a dot
          floating in the river beside the state reads as a bug rather than as
          the fact that the park is genuinely offshore and reached by ferry. */}
      <path
        d={[[-75.5790,39.6060],[-75.5640,39.6010],[-75.5620,39.5760],[-75.5760,39.5720]]
             .map((c, i) => `${i ? "L" : "M"}${x(c[0]).toFixed(1)} ${y(c[1]).toFixed(1)}`).join(" ") + " Z"}
        fill="var(--color-shell)"
        stroke="var(--color-marsh)"
        stroke-width="3"
        stroke-linejoin="round"
      />

      {/* Each marker is the section's own glyph knocked out of a disc in the
          section's own colour — the same pairing the listing chips use, so a
          reader who learnt "blue slide = playground" on a card meets it again
          here. Colour alone needs a legend; a glyph doesn't. */}
      {points.map((p) => {
        const cx = x(p.lon);
        const cy = y(p.lat);
        const R = 13;
        return (
          <a
            href={p.href}
            data-map-point
            data-kind={p.kind}
            data-name={p.name}
            data-where={p.where ?? ""}
            data-blurb={p.blurb ?? ""}
            data-photo={p.photo ?? ""}
            data-focus={p.focus ?? ""}
            data-county={p.county ?? ""}
            data-cy={cy.toFixed(0)}
            data-label={kinds.find((k) => k.key === p.kind)?.label ?? ""}
            data-color={colorFor(p.kind)}
          >
            <title>{p.name}{p.precision === "town" ? " (town center)" : ""}</title>
            <circle
              cx={cx.toFixed(1)}
              cy={cy.toFixed(1)}
              r={R}
              fill={colorFor(p.kind)}
              stroke="var(--color-shell)"
              stroke-width="3"
              opacity={p.precision === "town" ? 0.82 : 1}
            />
            <svg
              x={(cx - R * 0.62).toFixed(1)}
              y={(cy - R * 0.62).toFixed(1)}
              width={(R * 1.24).toFixed(1)}
              height={(R * 1.24).toFixed(1)}
              viewBox="0 0 24 24"
            >
              <FeatureIcon icon={p.kind as any} style="color:var(--color-shell)" />
            </svg>
          </a>
        );
      })}
    </svg>

    {/*
      THE CARD, over the map rather than under it.
      Tapping a marker used to leave the page immediately, which is a poor
      trade on a map: you go to find out what somewhere IS, and you can only
      find out by leaving the thing that showed you where it was.

      It sat below the map first, and that was worse than useless on a phone —
      the state is tall and narrow, so the map runs most of a screen high and
      the card opened somewhere you couldn't see. A marker that visibly does
      nothing is the most confusing outcome available. So it floats on top
      instead, and flips to whichever half of the map the marker isn't in.

      Without JavaScript every marker is still a plain link straight to the
      record — nothing here is the only route to anything.
    */}
    <div
      class="absolute left-3 right-3 sm:left-4 sm:right-4 max-w-[27rem] mx-auto z-20"
      data-map-card
      aria-live="polite"
      hidden
    >
      <div
        class="sign-quiet p-3 flex gap-3 items-start border-2 border-marsh shadow-[5px_5px_0_0_var(--color-marsh)]"
        style="border-left-width:6px"
      >
        <img
          data-card-photo
          alt=""
          width="120"
          height="68"
          hidden
          class="w-[5.5rem] sm:w-[6.5rem] shrink-0 aspect-[16/9] object-cover block border border-marsh/30"
        />
        <div class="min-w-0 flex-1">
          <p class="label m-0" data-card-label />
          <p class="font-display text-[1.1rem] font-bold tracking-[-0.02em] mt-1 mb-0 text-marsh" data-card-name />
          <p class="stamp text-ink-soft mt-1 mb-0" data-card-where />
          <p class="mt-1.5 mb-0 text-[0.85rem] leading-snug" data-card-blurb />
          <a href="#" class="tap stamp mt-2.5 inline-block" data-card-link>Open the page →</a>
        </div>
        <button
          type="button"
          data-card-close
          aria-label="Close"
          class="tap shrink-0 stamp text-ink-soft leading-none px-2 py-1 cursor-pointer"
        >✕</button>
      </div>
    </div>
  </div>

  <figcaption class="px-4 sm:px-5 pb-4 stamp text-ink-soft">
    Roads, water and county lines from OpenStreetMap. Tap a marker to see what it is, and again to open it. Solid markers are the
    place itself; paler ones are the town center, where I couldn't pin the
    building — about the width of the marker, at this scale.
  </figcaption>
</figure>

<script>
  (() => {
    const root = document.querySelector("[data-statemap]");
    if (!root) return;
    const chips = [...root.querySelectorAll("[data-map-kind]")];
    const countyChips = [...root.querySelectorAll("[data-map-county]")];
    const pts = [...root.querySelectorAll("[data-map-point]")];
    const bar = root.querySelector("[data-map-filters]");
    const countyBar = root.querySelector("[data-map-counties]");
    const count = root.querySelector("[data-map-count]");
    if (!chips.length || !pts.length) return;

    bar.hidden = false;
    const off = new Set();

    /* Counties are opt-IN, kinds are opt-OUT. The asymmetry is deliberate:
       there are three counties and eleven kinds, so "which county" is a
       choice you make and "which kinds" is a list you prune. */
    const onCounties = new Set(JSON.parse(countyBar?.dataset.start || "[]"));
    if (countyBar) countyBar.hidden = false;

    /* Inline, for the same reason the listing filters are: the colour is only
       known at runtime and an inline style outranks any sheet. */
    const paint = () => {
      for (const c of chips) {
        const on = !off.has(c.dataset.mapKind);
        const fc = c.dataset.fc;
        c.setAttribute("aria-pressed", on ? "true" : "false");
        c.style.background = on ? fc : "";
        c.style.color = on ? "var(--color-cream)" : fc;
        c.style.borderColor = fc;
      }
      for (const c of countyChips) {
        const on = onCounties.has(c.dataset.mapCounty);
        const fc = c.dataset.fc;
        c.setAttribute("aria-pressed", on ? "true" : "false");
        c.style.background = on ? fc : "";
        c.style.color = on ? "var(--color-cream)" : fc;
        c.style.borderColor = fc;
      }
      let shown = 0;
      for (const p of pts) {
        const hide =
          off.has(p.dataset.kind) ||
          (countyChips.length > 0 && !onCounties.has(p.dataset.county));
        p.style.display = hide ? "none" : "";
        if (!hide) shown++;
      }
      count.textContent = `${shown} of ${pts.length} places`;
      /* A filtered-away marker can't stay selected — the card would be
         describing something that is no longer on the map. */
      if (selected && selected.style.display === "none") deselect();
    };

    for (const c of chips) {
      c.addEventListener("click", () => {
        const k = c.dataset.mapKind;
        off.has(k) ? off.delete(k) : off.add(k);
        paint();
      });
    }
    for (const c of countyChips) {
      c.addEventListener("click", () => {
        const k = c.dataset.mapCounty;
        onCounties.has(k) ? onCounties.delete(k) : onCounties.add(k);
        /* Turning the last one off leaves an empty map and no way to read it
           as anything but broken. Put it straight back on. */
        if (!onCounties.size) onCounties.add(k);
        paint();
      });
    }

    /* ---- the card ------------------------------------------------------ */

    const card = root.querySelector("[data-map-card]");
    const fields = {
      label: card.querySelector("[data-card-label]"),
      name: card.querySelector("[data-card-name]"),
      where: card.querySelector("[data-card-where]"),
      blurb: card.querySelector("[data-card-blurb]"),
      link: card.querySelector("[data-card-link]"),
      photo: card.querySelector("[data-card-photo]"),
    };
    let selected = null;

    const deselect = () => {
      if (selected) selected.querySelector("circle").setAttribute("stroke-width", "3");
      selected = null;
      card.hidden = true;
    };

    for (const a of pts) {
      a.addEventListener("click", (e) => {
        /* Second tap on the same marker follows the link, so the map never
           becomes a thing you can't get out of. */
        if (selected === a) return;
        e.preventDefault();
        deselect();
        selected = a;
        a.querySelector("circle").setAttribute("stroke-width", "7");

        const d = a.dataset;
        fields.label.textContent = d.label || "";
        fields.name.textContent = d.name || "";
        fields.where.textContent = d.where || "";
        fields.blurb.textContent = d.blurb || "";
        fields.link.setAttribute("href", a.getAttribute("href"));
        card.querySelector("div").style.borderLeftColor = d.color || "";

        if (d.photo) {
          fields.photo.src = `/photos/${d.photo}-700.jpg`;
          fields.photo.style.objectPosition = d.focus || "50% 50%";
          fields.photo.hidden = false;
        } else {
          fields.photo.hidden = true;
          fields.photo.removeAttribute("src");
        }

        /* Open on the opposite half from the marker, so the card never covers
           the thing you just tapped. The viewBox is 1000 tall and the marker
           carries its own y, so this needs no layout measurement and behaves
           the same at every screen width. */
        const lower = Number(d.cy) > 500;
        card.style.top = lower ? "0.5rem" : "";
        card.style.bottom = lower ? "" : "1.5rem";

        card.hidden = false;
      });
    }

    card.querySelector("[data-card-close]").addEventListener("click", deselect);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") deselect();
    });

    /* Tapping the state itself dismisses. Markers stop the event first, so
       this only ever fires on empty water or land. */
    root.querySelector("svg").addEventListener("click", (e) => {
      if (!e.target.closest("[data-map-point]")) deselect();
    });

    paint();
  })();
</script>
