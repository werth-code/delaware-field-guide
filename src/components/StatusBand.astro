---
/**
 * The signature element.
 *
 * A full-width posted notice showing today's status. Every town and park page
 * opens with one. On the week-4 date checker, changing the date re-flags the
 * whole list at once.
 *
 * Status survives being stripped of colour. The bar texture is the fourth
 * redundant channel after colour, icon and word: solid means allowed, dashed
 * means limits apply, diagonal hazard means closed. Grayscale the page and the
 * band still answers the question from across the room.
 *
 * Composition: a textured flag bar (which carries NO text, so it uses the
 * canonical hex), a chip with icon and word on a text-bearing variant that
 * clears 7:1, and the verdict in ink on a pale wash. Double rule at the foot,
 * the way an official notice closes.
 */
import type { Status } from "../lib/rules";
import { STATUS_META } from "../lib/rules";
import FlagIcon from "./FlagIcon.astro";

interface Props {
  status: Status;
  /** "Dogs are not allowed today" — the sentence, not the label. */
  headline: string;
  /** One line of why. */
  detail?: string | null;
  /** The date this reflects. Always shown — a status with no date is a rumour. */
  asOf: string;
}

const { status, headline, detail = null, asOf } = Astro.props;
const meta = STATUS_META[status];

const bar = { green: "bar-solid", yellow: "bar-dashed", red: "bar-hazard" }[meta.flag]!;

const wash = {
  green: "bg-flag-green-wash",
  yellow: "bg-flag-yellow-wash",
  red: "bg-flag-red-wash",
}[meta.flag]!;

const chip = {
  green: "bg-flag-green-bearing text-white",
  yellow: "bg-flag-yellow text-ink",
  red: "bg-flag-red-bearing text-white",
}[meta.flag]!;

const edge = {
  green: "border-b-flag-green",
  yellow: "border-b-flag-yellow",
  red: "border-b-flag-red",
}[meta.flag]!;
---

<section class={`${wash} border-t border-t-rule`} aria-label="Current status">
  <div class={`${bar} h-3 w-full`}></div>

  <div class="wrap py-7">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
      <span
        class={`${chip} inline-flex items-center gap-2 px-3 py-1.5 rounded-[2px] font-mono text-[0.78rem] font-medium uppercase tracking-[0.1em]`}
      >
        <FlagIcon icon={meta.icon} class="w-[1.05em] h-[1.05em]" />
        {meta.word}
      </span>
      <span class="stamp text-structure-text">as of {asOf}</span>
    </div>

    <p
      class="font-display text-[1.75rem] sm:text-[2.1rem] leading-[1.08] tracking-[-0.02em] font-semibold mt-3.5 mb-0 text-ink max-w-[20ch]"
    >
      {headline}
    </p>

    {detail && <p class="mt-2.5 mb-0 max-w-[56ch] text-[0.95rem] leading-[1.55] text-ink">{detail}</p>}
  </div>

  {/* Double rule — how a posted notice closes. */}
  <div class={`h-[3px] w-full border-b-[3px] ${edge}`}></div>
  <div class="h-px w-full bg-rule"></div>
</section>
