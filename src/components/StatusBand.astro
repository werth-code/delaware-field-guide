---
/**
 * Today's status, as a compact stamped notice.
 *
 * This used to be a full-bleed band in the flag's wash with a 2.4rem
 * headline. Two problems: a pink or green field fights the sand-and-marsh
 * palette everywhere it appears, and the size implied the status was the
 * page, when the page is really the dates. So the panel now sits in the
 * content column on the site's own warm shell with an ochre keyline, and the
 * flag colour is concentrated into the two places it means something.
 *
 * Status is still encoded four ways — colour + icon + word + bar texture.
 * The texture bar is now vertical down the left edge: solid means allowed,
 * dashed means limits apply, diagonal hazard means closed. It reads at a
 * glance with no colour information at all.
 */
import type { Status } from "../lib/rules";
import { STATUS_META } from "../lib/rules";
import FlagIcon from "./FlagIcon.astro";

interface Props {
  status: Status;
  headline: string;
  detail?: string | null;
  asOf: string;
}

const { status, headline, detail = null, asOf } = Astro.props;
const meta = STATUS_META[status];

const bar = { green: "bar-solid", yellow: "bar-dashed", red: "bar-hazard" }[meta.flag]!;

const chip = {
  green: "bg-flag-green-bearing text-white",
  yellow: "bg-flag-yellow text-ink",
  red: "bg-flag-red-bearing text-white",
}[meta.flag]!;
---

<section
  class="sign-quiet bg-shell border-ochre flex overflow-hidden my-6"
  style="border-width: 2px;"
  aria-label="Current status"
>
  {/* Texture bar, vertical. The channel that survives grayscale. */}
  <div class={`${bar} w-2.5 shrink-0`}></div>

  <div class="px-4 py-3.5 sm:px-5">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
      <span
        class={`${chip} inline-flex items-center gap-1.5 px-2 py-1 rounded-[2px] border-2 border-ink font-mono text-[0.68rem] font-medium uppercase tracking-[0.09em]`}
      >
        <FlagIcon icon={meta.icon} class="w-[1em] h-[1em]" />
        {meta.word}
      </span>
      <span class="stamp text-ink-soft">as of {asOf}</span>
    </div>

    <p class="font-display text-[1.15rem] leading-[1.2] font-bold mt-2.5 mb-0 text-marsh">
      {headline}
    </p>

    {detail && <p class="mt-1.5 mb-0 max-w-[58ch] text-[0.9rem] leading-[1.5]">{detail}</p>}
  </div>
</section>
