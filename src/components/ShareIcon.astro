---

{
  FILLED[name] ? (
    <svg viewBox="0 0 24 24" class={klass} fill="currentColor" aria-hidden="true">
      <path d={FILLED[name]} />
    </svg>
  ) : (
    <svg
      viewBox="0 0 24 24"
      class={klass}
      fill="none"
      stroke="currentColor"
      stroke-width="2.1"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      {name === "share" && (<><path d="M12 16V4" /><path d="M7 9l5-5 5 5" /><path d="M4 15v5h16v-5" /></>)}
      {name === "sms" && (<><path d="M21 12a8 8 0 0 1-8 8H8l-4 3v-4a8 8 0 0 1 5-14h4a8 8 0 0 1 8 7z" /></>)}
      {name === "email" && (<><rect x="3" y="5" width="18" height="14" rx="1.5" /><path d="M3.5 6.5 12 13l8.5-6.5" /></>)}
      {name === "copy" && (<><path d="M10 13a4 4 0 0 0 5.7 0l2.6-2.6a4 4 0 0 0-5.7-5.7L11.5 6" /><path d="M14 11a4 4 0 0 0-5.7 0l-2.6 2.6a4 4 0 0 0 5.7 5.7L12.5 18" /></>)}
      {name === "copied" && (<path d="M4 12.5 9.5 18 20 6.5" />)}
    </svg>
  )
}
