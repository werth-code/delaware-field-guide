---
/**
 * The share-row glyphs.
 *
 * Kept in one file so the row can be scanned for what it does rather than
 * waded through for what it draws — nine brand marks inline would be most of
 * ShareRow by volume and none of it by meaning.
 *
 * DRAWN, NOT FETCHED. No icon font, no CDN, no sprite sheet from anybody
 * else's server. The site loads no third-party anything and a share row is a
 * silly place to break that.
 *
 * BRAND MARKS ARE FILLED; THE GENERIC ONES ARE STROKED. That split is
 * deliberate. A logo is recognised by its silhouette, and stroking it into the
 * site's own 2px hand makes it a drawing OF a logo rather than the logo — you
 * squint at it. Text, email and copy-link belong to nobody, so they are drawn
 * in the same stroked style as every other icon on this site.
 *
 * These are simplified. They are nominative use — "this button posts to
 * Reddit" — not an implication that anybody endorses this site.
 *
 * EVERY BUTTON STILL CARRIES ITS NAME, on aria-label and title. An icon-only
 * row is faster to scan and completely opaque to a screen reader unless the
 * name is put back by hand.
 */
interface Props {
  name: string;
  class?: string;
}
const { name, class: klass = "w-[1.15rem] h-[1.15rem]" } = Astro.props;

/* Brand marks: one filled path each, viewBox 0 0 24 24. */
const FILLED: Record<string, string> = {
