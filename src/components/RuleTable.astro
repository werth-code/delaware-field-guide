---
/**
 * A town's rule array, set as a posted schedule.
 *
 * Breaks wider than the prose measure on large screens — prose wants 64ch, a
 * schedule wants room, and the asymmetry stops the page reading as one
 * undifferentiated column.
 *
 * Below 40rem it stops being a table and becomes stacked records, because a
 * three-column table on a 375px screen is a horizontal scroll nobody
 * performs. Each stacked record keeps a fat flag-coloured left edge, so the
 * season is scannable with a thumb without reading a word.
 */
import type { Rule, Status } from "../lib/rules";
import { STATUS_META, formatRange } from "../lib/rules";
import FlagIcon from "./FlagIcon.astro";

interface Props {
  rules: Rule[];
  caption?: string;
}

const { rules, caption } = Astro.props;

const chipFor = (status: Status) =>
  ({
    green: "bg-flag-green-bearing text-white",
    yellow: "bg-flag-yellow text-ink",
    red: "bg-flag-red-bearing text-white",
  })[STATUS_META[status].flag]!;

const edgeFor = (status: Status) =>
  ({
    green: "border-l-flag-green",
    yellow: "border-l-flag-yellow",
    red: "border-l-flag-red",
  })[STATUS_META[status].flag]!;

const areaLabel = (a: string) => (a === "boardwalk" ? "Boardwalk" : "Beach");
---

<div class="sign breakout my-8 overflow-hidden">
  {
    caption && (
      <p class="label field-deep text-foam px-4 sm:px-5 py-3 m-0">{caption}</p>
    )
  }

  <table class="w-full text-left">
    <thead class="hidden sm:table-header-group">
      <tr class="bg-shell-sunk border-b-2 border-marsh">
        <th scope="col" class="label px-5 py-3 font-medium">Where</th>
        <th scope="col" class="label px-5 py-3 font-medium">Dates</th>
        <th scope="col" class="label px-5 py-3 font-medium">Status</th>
      </tr>
    </thead>

    <tbody>
      {
        rules.map((rule) => {
          const meta = STATUS_META[rule.status];
          return (
            <tr
              class={`block sm:table-row border-b border-tide/40 last:border-b-0 align-top border-l-[7px] sm:border-l-0 ${edgeFor(rule.status)}`}
            >
              <th
                scope="row"
                class="block sm:table-cell px-4 sm:px-5 pt-4 sm:py-5 font-display text-[1.15rem] font-bold text-left tracking-[-0.018em] text-marsh"
              >
                {areaLabel(rule.area)}
              </th>

              <td class="block sm:table-cell px-4 sm:px-5 sm:py-5 whitespace-nowrap">
                <span class="stamp text-[0.94rem]">{formatRange(rule)}</span>
              </td>

              <td class="block sm:table-cell px-4 sm:px-5 pt-2.5 pb-4 sm:py-5">
                <span
                  class={`${chipFor(rule.status)} inline-flex items-center gap-1.5 px-2 py-1 rounded-[2px] border-2 border-ink font-mono text-[0.7rem] font-medium uppercase tracking-[0.09em]`}
                >
                  <FlagIcon icon={meta.icon} class="w-[1em] h-[1em]" />
                  {meta.word}
                </span>

                {rule.note && (
                  <p class="mt-2.5 mb-0 text-[0.9rem] leading-[1.5] max-w-[52ch]">{rule.note}</p>
                )}

                {rule.leashRequired && (
                  <p class="mt-2 mb-0 stamp text-ink-soft">
                    Leash required{rule.maxLeashFeet ? ` · max ${rule.maxLeashFeet} ft` : ""}
                  </p>
                )}
              </td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
</div>
