---
/**
 * The one commerce module allowed on an editorial page.
 *
 * Renders NOTHING unless mayPlace() agrees, which means: the mark is actually
 * for sale, this path is on its whitelist, and this path is not a safety page.
 * All three, every time.
 *
 * WHERE IT GOES ON THE PAGE IS NOT THIS COMPONENT'S DECISION, and it is the
 * one that matters most. It belongs after the answer and before Related links.
 * Never between "are dogs allowed?" and the answer. Never inside fees, permits,
 * closures or emergency information. Somebody reading those is trying not to
 * get hurt or overcharged, and putting a $5 sticker in the middle of it is how
 * a reference stops being one.
 *
 * scripts/check-build.mjs enforces the safety half of that at build time. The
 * ordering half is enforced by where the tag is written, which is why every
 * placement below is in a `Related`-adjacent slot and reviewed as copy.
 */
import marksData from "../data/field-marks.json";
import { markFor, type FieldMark } from "../lib/field-marks";

interface Props {
  /** Headline. Defaults to the plain one. */
  heading?: string;
  class?: string;
}

const { heading = "Been here?", class: className = "" } = Astro.props;

/* Driven by the page's own path, not by a slug passed in at the call site.
   A template renders <FieldMarkModule /> once and the data decides whether
   anything appears — so a park detail page can carry the tag for all 17 parks
   while only the ones with a real sticker ever show one. */
const mark = markFor(marksData as FieldMark[], Astro.url.pathname);
const show = mark !== null;
---

{
  show && mark && (
    <aside class={`sign px-4 sm:px-5 py-4 my-7 not-prose ${className}`} data-field-mark={mark.sku}>
      {/* FOUR LABELS ON THIS SITE, AND THEY MUST NOT LOOK ALIKE.
          "Checked directly" is a claim about a fact. "Sponsor" is a paid third
          party. "Built by Werth Design" is a maker's credit. And this one is
          something the Field Guide made and sells itself.
          A reader should never have to work out which of the four they're
          looking at, so each gets its own word in its own position. */}
      <p class="label m-0 text-ochre-deep">From the Field Guide</p>
      <p class="label m-0 mt-1.5">{heading}</p>
      <p class="font-display text-[1.15rem] font-semibold tracking-[-0.03em] mt-2 mb-0 text-marsh">
        Field Mark {mark.number} · {mark.name}
      </p>
      <p class="mt-2 mb-0 text-[0.95rem] leading-snug max-w-[52ch]">{mark.pitch}</p>
      <p class="mt-3 mb-0">
        <a href={`/field-marks/${mark.slug}/`} class="stamp">
          ${mark.price} · weatherproof vinyl →
        </a>
      </p>
    </aside>
  )
}
