# Copy to .env for local development. .env is gitignored.
#
# NOT PUBLIC_EBIRD_API_KEY. Astro inlines any PUBLIC_ variable into the browser
# bundle, which would publish this key on every page of the site. The name below
# is read only by scripts/fetch-ebird.mjs, at build time, on the server.
#
# Get one at https://ebird.org/api/keygen
EBIRD_API_KEY=
