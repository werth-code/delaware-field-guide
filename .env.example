# Copy to .env for local dev. In CI this is a repository *variable* (not a secret) —
# the deploy workflow already passes it through to the build.
#
# The Beehiiv embed URL for the footer capture. Until this is set, the footer
# renders a labelled placeholder rather than a form that silently drops addresses.
PUBLIC_BEEHIIV_EMBED_URL=

# Field-report submissions on park pages. Any form endpoint that accepts a
# form-encoded POST works — Formspree is the assumed shape (it honours the
# `_subject` and `_gotcha` fields the form sends).
#
# Nothing submitted here is ever published automatically: reports land in your
# inbox, you read them, and accepted ones are added to src/data/reports.json
# with an `acceptedOn` date. No acceptedOn, no render.
PUBLIC_REPORT_ENDPOINT=
